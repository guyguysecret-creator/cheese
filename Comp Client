-- Intro splash: "Comp Client" pops up with a pulsing red glow, then fades away.
-- (Text only - no picture, no downloads, no files.)
------------------------------------------------------------------------
task.spawn(function()
    local okIntro, errIntro = pcall(function()
        local TweenService = game:GetService("TweenService")
        local host = gui and gui.Parent
        if not host then return end
        local oldIntro = host:FindFirstChild("ForceHBE_Intro")
        if oldIntro then oldIntro:Destroy() end

        local sg = Instance.new("ScreenGui")
        sg.Name = "ForceHBE_Intro"
        sg.IgnoreGuiInset = true
        sg.ResetOnSpawn = false
        sg.DisplayOrder = 1000
        sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        if not pcall(function() sg.Parent = host end) then sg:Destroy() return end

        local RED = Color3.fromRGB(255, 35, 35)
        local function makeText(color, z)
            local l = Instance.new("TextLabel")
            l.AnchorPoint = Vector2.new(0.5, 0.5)
            l.Position = UDim2.fromScale(0.5, 0.5)
            l.Size = UDim2.fromOffset(900, 140)
            l.BackgroundTransparency = 1
            l.Font = Enum.Font.GothamBlack
            l.Text = "Comp Client"
            l.TextSize = 28
            l.TextColor3 = color
            l.TextTransparency = 1
            l.ZIndex = z
            l.Parent = sg
            return l
        end
        -- glow: a red copy of the text behind it with a thick, soft red outline
        local glow = makeText(RED, 1)
        local glowStroke = Instance.new("UIStroke")
        glowStroke.Color = RED
        glowStroke.Thickness = 8
        glowStroke.Transparency = 1
        glowStroke.Parent = glow
        -- the text itself: white with a sharp red outline
        local main = makeText(Color3.fromRGB(255, 255, 255), 3)
        local stroke = Instance.new("UIStroke")
        stroke.Color = RED
        stroke.Thickness = 2
        stroke.Transparency = 1
        stroke.Parent = main

        -- pop in (grows with a little overshoot)
        local pop = TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        TweenService:Create(main, pop, { TextSize = 78, TextTransparency = 0 }):Play()
        TweenService:Create(glow, pop, { TextSize = 78, TextTransparency = 0.55 }):Play()
        TweenService:Create(stroke, TweenInfo.new(0.5), { Transparency = 0 }):Play()
        TweenService:Create(glowStroke, TweenInfo.new(0.5), { Transparency = 0.6 }):Play()
        task.wait(0.5)

        -- red glow pulse for ~2s
        local t0 = os.clock()
        while os.clock() - t0 < 2 and sg.Parent do
            local t = os.clock() - t0
            local pulse = (math.sin(t * 6) + 1) / 2                  -- 0..1
            glowStroke.Thickness = 6 + pulse * 12
            glowStroke.Transparency = 0.45 + (1 - pulse) * 0.3
            glow.TextTransparency = 0.45 + (1 - pulse) * 0.3
            stroke.Thickness = 2 + pulse * 3
            RunService.RenderStepped:Wait()
        end

        -- fade away
        local fade = TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        TweenService:Create(main, fade, { TextTransparency = 1, TextSize = 90 }):Play()
        TweenService:Create(glow, fade, { TextTransparency = 1, TextSize = 90 }):Play()
        TweenService:Create(stroke, fade, { Transparency = 1 }):Play()
        TweenService:Create(glowStroke, fade, { Transparency = 1 }):Play()
        task.wait(0.8)
        sg:Destroy()
    end)
    if not okIntro then warn("[ForceHBE] intro splash failed: " .. tostring(errIntro)) end
end)
