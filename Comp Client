-- Auto Evade  (Stun Evade)
--   The game gives you a short window right after you're stunned (STUN_DASH_WINDOW,
--   0.4s) in which a force dash is still allowed. A dash needs a movement key held, and
--   W makes it a FORWARD dash (the way you face). So the moment your saber enters the
--   "stunned" state we: snap your character (and the camera) around to face the escape
--   direction, hold W, wait one frame so the game sees it, then send the dash through the
--   game's own input function; if that didn't start a dash we tap a real E as a back-up.
--
--   WHY IT USED TO GET INTERRUPTED: the game adds a listener when a dash starts that
--   CANCELS the dash on any W/A/S/D/left-click press - so one stray key ended the evade.
--   The input sink swallows those keys now, and this also removes that listener for the
--   duration of the evade, so nothing you press can cut it short. Right click is still
--   free, and the block you hold is pressed for you the instant the game allows it.
--
--   AIRBORNE (build 23): a force dash needs both feet on the ground, so a stun that
--   lands while you are jumping (jump spamming gets you hit in the air constantly) has
--   no dash to give and the old code just skipped it. Now the stun is REMEMBERED while
--   you are airborne and the evade fires on the first frame you are actually standing
--   on something (Humanoid FloorMaterial ~= Air, not freefall/jumping, no upward speed).
--   The request stays alive for as long as you are stunned, plus a short grace after the
--   stun state ends (the game still refuses a dash for a moment), so a stun that ends
--   exactly as you touch down is still evaded.
------------------------------------------------------------------------
local evadeBusy, wasStunned, lastCSM = false, false, nil
local KEY_W, KEY_E = 0x57, 0x45
local KEY_A, KEY_D = 0x41, 0x44
-- pending evade request: set the moment a stun is seen (air or ground), cleared when the
-- evade really runs or when the stun is long gone
local evadeReq = { at = 0, active = false }
local EVADE_GRACE = 0.35      -- s after the stun state ends that a landing still evades
local EVADE_REQ_MAX = 4.0     -- s: never keep a request longer than this
local LAND_VELOCITY = 3       -- studs/s: falling slower than this (and on a floor) = landed

-- are we standing on something the game will let a force dash start from?
local function onGround()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 then return false end
    local st = hum:GetState()
    if st == Enum.HumanoidStateType.Dead or st == Enum.HumanoidStateType.Freefall
        or st == Enum.HumanoidStateType.Jumping then
        return false
    end
    local okF, floorMat = pcall(function() return hum.FloorMaterial end)
    if okF and floorMat == Enum.Material.Air then return false end
    local v = hrp.AssemblyLinearVelocity
    if v.Y > LAND_VELOCITY then return false end        -- still going up (jump apex)
    if v.Y < -LAND_VELOCITY then return false end       -- still falling
    return true
end

-- ask for an evade (this is what the stun hooks and the state check call)
local function requestEvade()
    if not settings.autoEvade then return end
    evadeReq.active = true
    evadeReq.at = os.clock()
end

-- WHERE TO GO (flat vectors):
--   * attacker NOT looking straight at you: evade OPPOSITE to where they're looking
--   * attacker looking DIRECTLY at you: turn away and slip out DIAGONALLY (W+A / W+D)
local function evadePlan(hrp)
    local best, bestPri, bestD
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local ch = plr.Character
            local h = ch and ch:FindFirstChild("HumanoidRootPart")
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            if h and hum and hum.Health > 0 then
                local d = (h.Position - hrp.Position).Magnitude
                local pri = swingState[plr] and 0 or 1
                if d <= 60 and (not best or pri < bestPri or (pri == bestPri and d < bestD)) then
                    best, bestPri, bestD = h, pri, d
                end
            end
        end
    end
    local function flat(v) return Vector3.new(v.X, 0, v.Z) end
    local function unit(v, fallback)
        if v.Magnitude < 0.05 then return fallback end
        return v.Unit
    end
    local myLook = unit(flat(hrp.CFrame.LookVector), Vector3.new(0, 0, -1))
    if not best then
        local back = -myLook -- nobody near: just turn around
        return back, back, nil
    end
    local away = unit(flat(hrp.Position - best.Position), -myLook)        -- from attacker to you
    local f = unit(flat(best.CFrame.LookVector), away)                    -- where the attacker looks
    local facingYou = f:Dot(away)                                         -- 1 = looking straight at you
    if facingYou >= AP.EVADE_FACING then
        local side = (math.random(2) == 1) and 1 or -1                    -- +1 = left (A), -1 = right (D)
        local move = CFrame.Angles(0, math.rad(45 * side), 0):VectorToWorldSpace(away)
        return away, move, (side == 1) and KEY_A or KEY_D
    end
    return -f, -f, nil
end

local function movementState()
    local sc = saberComp
    if not saberStillValid(sc) then return nil end
    local ok, st = pcall(function() return rawget(sc, "MovementStateMachine"):GetCurrentState() end)
    return ok and st or nil
end

-- BLOCK BUFFER: the game refuses block while dashing / stunned, and a right-click press
-- during that time is lost. This presses block the first moment it's allowed, so the
-- block is up right as the evade ends.
local function blockBuffer()
    local t0 = os.clock()
    while os.clock() - t0 < 3 and settings.autoEvade do
        local sc = saberComp
        if saberStillValid(sc) then
            local okS, cs = pcall(function() return rawget(sc, "CombatStateMachine"):GetCurrentState() end)
            if okS and cs == "blocking" then return end
            if okS and cs == "ignited"
                and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                local ms = movementState()
                if ms ~= "dashing" and ms ~= "flipping" and ms ~= "low_flipping" and ms ~= "skidding" then
                    pcall(function()
                        sc:ProcessInput(true, { name = "BLOCK", inputState = Enum.UserInputState.Begin })
                    end)
                end
            end
        end
        RunService.Heartbeat:Wait()
    end
end

-- doEvade(allowWait): allowWait = true means "we are in the air, wait for the landing"
local function doEvade(allowWait)
    if evadeBusy or not settings.autoEvade then return end
    evadeBusy = true
    task.spawn(function()
        local haveKeys = type(keypress) == "function" and type(keyrelease) == "function"
        local cam = workspace.CurrentCamera
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp then evadeBusy = false return end

        -- 0) IN THE AIR: a force dash can't start, so stand by (no keys, no camera yet)
        --    and fire the instant we touch the ground. The stun state is re-checked here,
        --    and the request is dropped if the stun is over and we are still up there.
        if allowWait and not onGround() then
            local t0 = os.clock()
            while os.clock() - t0 < 1.2 do
                if not settings.autoEvade then evadeBusy = false return end
                if not evadeReq.active and not wasStunned then break end
                if onGround() then break end
                RunService.Heartbeat:Wait()
            end
            if not onGround() then
                evadeBusy = false
                return -- still airborne: the pending request will fire on landing
            end
        end
        evadeReq.active = false

        -- 1) DECIDE the direction, TURN instantly (character + camera), press the keys
        local faceDir, moveDir, sideKey = evadePlan(hrp)
        local prevCamType
        pcall(function() hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + faceDir) end)
        if cam then
            pcall(function()
                prevCamType = cam.CameraType
                cam.CameraType = Enum.CameraType.Scriptable
                local eye = hrp.Position - faceDir * 10 + Vector3.new(0, 4, 0)
                cam.CFrame = CFrame.lookAt(eye, hrp.Position + faceDir * 20)
            end)
        end

        -- 2) NO KEY CAN MESS IT UP: a sink bound above the game's own bindings swallows
        --    keys / left click while the evade runs, and we steer the character ourselves.
        pcall(function()
            ContextActionService:BindActionAtPriority("StunEvade_EvadeSink", function() return Enum.ContextActionResult.Sink end,
                false, 9100, Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
                Enum.KeyCode.Space, Enum.UserInputType.MouseButton1, Enum.KeyCode.E,
                Enum.KeyCode.LeftControl, Enum.KeyCode.C)
        end)
        pcall(function()
            RunService:BindToRenderStep("StunEvade_EvadeMove", Enum.RenderPriority.Last.Value, function()
                if hum then hum:Move(moveDir, false) end
            end)
        end)

        if haveKeys then
            pcall(keypress, KEY_W)
            if sideKey then pcall(keypress, sideKey) end
        end
        RunService.RenderStepped:Wait()
        local function sendDashInput()
            if saberStillValid(saberComp) then
                pcall(function()
                    saberComp:ProcessInput(true, { name = "FORCE_DASH", inputState = Enum.UserInputState.Begin })
                end)
            end
        end
        sendDashInput()
        RunService.RenderStepped:Wait()
        if movementState() ~= "dashing" then
            sendDashInput()
            if haveKeys and movementState() ~= "dashing" then
                pcall(keypress, KEY_E)
                task.wait(0.02)
                pcall(keyrelease, KEY_E)
            end
        end
        -- the game cancels a dash when W/A/S/D/left-click is pressed; drop that listener
        pcall(function() rawget(saberComp, "_janitor"):Remove("DashCancelInputBegan") end)
        task.spawn(blockBuffer)

        -- 3) steer until the dash really ends (at least 0.15s, at most 0.9s)
        local t0 = os.clock()
        while os.clock() - t0 < 0.9 and (os.clock() - t0 < 0.15 or movementState() == "dashing") do
            RunService.RenderStepped:Wait()
        end

        pcall(function() RunService:UnbindFromRenderStep("StunEvade_EvadeMove") end)
        pcall(function() ContextActionService:UnbindAction("StunEvade_EvadeSink") end)
        if haveKeys then
            pcall(keyrelease, KEY_W)
            if sideKey then pcall(keyrelease, sideKey) end
        end
        if cam and prevCamType then pcall(function() cam.CameraType = prevCamType end) end
        evadeBusy = false
    end)
end

track(RunService.Heartbeat:Connect(function()
    if not settings.autoEvade then
        wasStunned = false
        evadeReq.active = false
        return
    end
    local sc = getSaber()
    if not saberStillValid(sc) then return end
    local okS, csm = pcall(function() return rawget(sc, "CombatStateMachine") end)
    if not okS or not csm then return end
    -- instant path: react the moment the state machine switches to "stunned"
    if csm ~= lastCSM then
        lastCSM = csm
        pcall(function()
            track(csm.StateChanged:Connect(function(state)
                if state == "stunned" and settings.autoEvade then
                    requestEvade()      -- remember it even if we are in the air
                    doEvade(true)       -- waits for the landing when airborne
                end
            end))
        end)
    end
    -- back-up path: per-frame check
    local okG, state = pcall(function() return csm:GetCurrentState() end)
    local stunned = okG and state == "stunned"
    if stunned and not wasStunned then
        requestEvade()
        doEvade(true)
    end
    wasStunned = stunned

    -- LANDING TRIGGER: a stun we could not evade in the air fires on the first grounded
    -- frame - while the stun is still on, or within the short grace after it ends
    if evadeReq.active and not evadeBusy then
        local now = os.clock()
        local fresh = (now - evadeReq.at) <= EVADE_REQ_MAX
        local withinGrace = stunned or (now - evadeReq.at) <= (EVADE_REQ_MAX + EVADE_GRACE)
        if not fresh then
            evadeReq.active = false
        elseif onGround() and (stunned or withinGrace) then
            -- doEvade itself re-checks the movement state before it sends the dash, so a
            -- landing during a swing just skips this frame instead of dropping the request
            doEvade(false)
        end
    end
end))

------------------------------------------------------------------------
-- Chase Multi  (NEW)
--
--   What you asked for, in game terms:
--     * trigger: YOUR parry stuns somebody
--     * dash to where they went / move to
--     * then multi them, repeating continuously:
--           W  ->  E (force dash) one frame later  ->  LEFT CLICK (swing)
--     * stop IMMEDIATELY when their stun animation ends
--
--   How the stun is seen: a parried player is put in the STUNNED combat state, which
--   replicates to you as one of the game's stun animations (6297531803 / 6322313635 /
--   6322315386). So the target is whoever, among the players near the one you just
--   parried, is playing a stun animation. The stun is over the moment that track stops
--   or loops, or their Humanoid reports dead / GettingUp / freefall - checked every frame,
--   and the very same frame the stop is seen no further key is pressed.
--
--   Speed: the cycle is not on a timer. It re-arms from the saber's OWN animation events
--   (its swing finished / it went back to ignited), which is the earliest moment the game
--   accepts the next input. The gap between the three presses is ONE FRAME (that is the
--   fastest ordering the game can act on), and the swing itself is sent through the
--   saber's input function so no mouse pipeline delay is added.
--
--   Safety:
--     - never presses anything while you hold RIGHT CLICK (your block/parry wins)
--     - never presses anything while you are stunned, dashing, or dead
--     - all presses are released on the first frame the stun ends, so nothing is stuck
------------------------------------------------------------------------
local STUN_IDS = { ["6297531803"] = true, ["6322313635"] = true, ["6322315386"] = true }
local CHASE_RANGE = 90        -- studs: give up if they get further than this
local CHASE_PARRY_WINDOW = 1.2 -- s after one of your parries a new stun counts as "yours"
local CHASE_ORPHAN = 0.35     -- s a stun with no parry of ours nearby is still claimed (chase toggle)

local chase = {
    active = false,
    target = nil,      -- Player
    stunTrack = nil,   -- the AnimationTrack that IS their stun
    lastStunSeen = 0,
    swingTrack = nil,
    armed = 0,         -- os.clock() of the last re-arm
    started = 0,
    step = 0,          -- 0 idle, 1 W sent, 2 E sent, 3 click sent
    phaseAt = 0,
}

local function stunTrackOf(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then return nil end
    local ok, tracks = pcall(animator.GetPlayingAnimationTracks, animator)
    if not ok or type(tracks) ~= "table" then return nil end
    for _, trk in ipairs(tracks) do
        local okId, id = pcall(function() return string.match(trk.Animation.AnimationId, "%d+") end)
        if okId and id and STUN_IDS[id] then
            local okP, playing = pcall(function() return trk.IsPlaying end)
            if okP and playing then return trk end
        end
    end
    return nil
end

local function stunStillOn(plr, trk)
    local char = plr and plr.Character
    if not char or not trk then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local st = hum:GetState()
    if st == Enum.HumanoidStateType.Dead or st == Enum.HumanoidStateType.GettingUp then return false end
    local okP, playing = pcall(function() return trk.IsPlaying end)
    if not okP or not playing then return false end
    -- a stun track never loops in this game; if it did loop, the loop means "over"
    local okL, looped, pos, len = pcall(function() return trk.Looped, trk.TimePosition, trk.Length end)
    if okL and looped and len and len > 0 and pos >= len - 0.02 then return false end
    return true
end

local function keysDown()
    return type(keypress) == "function" and type(keyrelease) == "function"
end

local function chaseReleaseAll()
    if not keysDown() then return end
    pcall(keyrelease, KEY_W)
    pcall(keyrelease, KEY_E)
end

local function chaseStop(reason)
    if not chase.active then return end
    chase.active = false
    chase.target, chase.stunTrack, chase.swingTrack = nil, nil, nil
    chase.step = 0
    chaseReleaseAll()
    pcall(function() RunService:UnbindFromRenderStep("StunEvade_ChaseMove") end)
    if reason then log("Chase Multi stopped: " .. reason) end
end

-- who did we just stun?  the player near the last parried attacker who is playing a stun
local function findChaseTarget(myHrp)
    local now = os.clock()
    local parryAt = env().StunEvade_Chase and env().StunEvade_Chase.t or 0
    local sinceParry = now - parryAt
    local parried = env().StunEvade_LastParryTarget
    local best, bestD
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local trk = stunTrackOf(char)
                if trk then
                    local d = (hrp.Position - myHrp.Position).Magnitude
                    local ours = (parried == plr and sinceParry <= CHASE_PARRY_WINDOW)
                        or (sinceParry <= CHASE_PARRY_WINDOW and d <= 60)
                        or (sinceParry > CHASE_PARRY_WINDOW and sinceParry <= CHASE_ORPHAN and d <= 60)
                    if ours and d <= CHASE_RANGE and (not best or d < bestD) then
                        best, bestD = plr, d
                    end
                end
            end
        end
    end
    return best
end

local function chaseStart(plr)
    local char = plr.Character
    local trk = stunTrackOf(char)
    if not trk then return end
    chase.active = true
    chase.target = plr
    chase.stunTrack = trk
    chase.lastStunSeen = os.clock()
    chase.started = os.clock()
    chase.step = 0
    chase.armed = 0
    chase.swingTrack = nil
    log("Chase Multi: " .. plr.Name .. " is stunned - chasing and multi-ing")
end

-- what state is your saber in right now?
local function myCombatState()
    local sc = saberComp
    if not saberStillValid(sc) then return nil end
    local ok, s = pcall(function() return rawget(sc, "CombatStateMachine"):GetCurrentState() end)
    return ok and s or nil
end

-- the swing the game is playing for us (used to know when the next one may start)
local function mySwingTrack()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then return nil end
    local ok, tracks = pcall(animator.GetPlayingAnimationTracks, animator)
    if not ok or type(tracks) ~= "table" then return nil end
    local best, bestPos = nil, math.huge
    for _, trk in ipairs(tracks) do
        local okId, id = pcall(function() return string.match(trk.Animation.AnimationId, "%d+") end)
        if okId and id and ATTACK_IDS[id] then
            local okP, pos, playing = pcall(function() return trk.TimePosition, trk.IsPlaying end)
            if okP and playing and pos < bestPos then best, bestPos = trk, pos end
        end
    end
    return best
end

-- a left click is only "a swing" when the saber is ignited and not blocking
local function canSwingNow()
    local s = myCombatState()
    return s == "ignited"
end

local function sendAttack()
    local sc = saberComp
    pcall(function()
        sc:ProcessInput(true, { name = "ATTACK", inputState = Enum.UserInputState.Begin })
    end)
end

local function sendForceDash()
    local sc = saberComp
    pcall(function()
        sc:ProcessInput(true, { name = "FORCE_DASH", inputState = Enum.UserInputState.Begin })
    end)
end

-- face the target (character + camera: the game moves you where the camera looks)
local function chaseFace(hrp, targetPos)
    local dir = targetPos - hrp.Position
    dir = Vector3.new(dir.X, 0, dir.Z)
    if dir.Magnitude < 0.1 then return end
    local cam = workspace.CurrentCamera
    pcall(function() hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + dir.Unit) end)
    if cam then
        pcall(function()
            local eye = hrp.Position - dir.Unit * 10 + Vector3.new(0, 4, 0)
            cam.CFrame = CFrame.lookAt(eye, hrp.Position + dir.Unit * 20)
        end)
    end
end

track(RunService.RenderStepped:Connect(function()
    if not settings.chaseMulti then
        if chase.active then chaseStop(nil) end
        return
    end

    local char = LocalPlayer.Character
    local myHrp = char and char:FindFirstChild("HumanoidRootPart")
    local myHum = char and char:FindFirstChildOfClass("Humanoid")
    if not myHrp or not myHum or myHum.Health <= 0 then chaseStop(nil) return end
    if not getSaber() then chaseStop(nil) return end

    -- 1) STILL STUNNED?  this is the frame-accurate stop you asked for
    if chase.active then
        if not stunStillOn(chase.target, chase.stunTrack) then
            local t = chase.target
            chaseStop(nil)
            log("Chase Multi stopped: " .. (t and t.Name or "target") .. "'s stun animation ended")
            return
        end
        chase.lastStunSeen = os.clock()
        local thrp = chase.target.Character and chase.target.Character:FindFirstChild("HumanoidRootPart")
        if thrp and (thrp.Position - myHrp.Position).Magnitude > CHASE_RANGE then
            chaseStop("they got too far away")
            return
        end
    else
        local target = findChaseTarget(myHrp)
        if not target then return end
        chaseStart(target)
    end

    -- 2) never fight the player's own inputs
    local cs = myCombatState()
    if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        -- you are holding block: keep the chase alive but do not press anything
        if chase.step ~= 0 then chaseReleaseAll() chase.step = 0 end
        return
    end
    if cs == "stunned" or cs == "kicking" or cs == "parrying" or cs == "blocking" then
        if chase.step ~= 0 then chaseReleaseAll() chase.step = 0 end
        return
    end

    local thrp = chase.target.Character and chase.target.Character:FindFirstChild("HumanoidRootPart")
    if not thrp then return end
    chaseFace(myHrp, thrp.Position)

    local now = os.clock()
    -- hold W so the force dash is a forward dash, and re-press it if something ate it
    if keysDown() and chase.step < 2 and not UserInputService:IsKeyDown(Enum.KeyCode.W) then
        pcall(keypress, KEY_W)
    end

    -- 3) THE CYCLE: W -> (1 frame) -> E -> (1 frame) -> LEFT CLICK, then re-arm on the swing
    if chase.step == 0 then
        -- only start a new cycle when the saber is ready to swing
        if not canSwingNow() then return end
        -- never start a swing while the previous one is still animating
        local trk = mySwingTrack()
        if trk then chase.swingTrack = trk return end
        if now - chase.armed < 0.03 then return end
        chase.armed = now
        chase.step = 1
        chase.phaseAt = now
        if keysDown() then pcall(keypress, KEY_W) end
        return
    end

    -- the three presses happen in three consecutive frames: that is the fastest order
    -- the game can act on (same-frame input for the same button is not allowed)
    if chase.step == 1 then
        chase.step = 2
        chase.phaseAt = now
        sendForceDash()
        if keysDown() then pcall(keypress, KEY_E) end
        return
    end

    if chase.step == 2 then
        chase.step = 3
        chase.phaseAt = now
        if keysDown() then pcall(keyrelease, KEY_E) end
        -- the swing itself: the game's own attack input, no mouse pipeline in the way
        if canSwingNow() then sendAttack() end
        return
    end

    if chase.step == 3 then
        -- the swing we just started is playing: hold this step until it finishes
        local trk = mySwingTrack()
        if trk then chase.swingTrack = trk return end
        if now - chase.phaseAt < 0.1 then return end -- the click was eaten (blocked etc.)
        chase.step = 0
        chase.armed = now
    end
end))

-- nothing to poll: Auto Parry writes env().StunEvade_Chase (time + attacker) on every
-- parry it sends, and findChaseTarget reads it
------------------------------------------------------------------------
-- Anti-kick
--   When a kick lands, the SERVER sends your game a stun message (type BLOCK_KICKED or
--   PARRY_KICKED) and your game puts you in the Stunned state. This hooks the saber
--   component's HandleSignal (where the message arrives) and the state machine's
--   "stun_request" (what actually enters Stunned) and drops kick stuns on your screen.
--   Needs hookfunction + getgc.
------------------------------------------------------------------------
local antiKickStatus = "off"

local function isKickStun(e, stunData)
    if type(stunData) ~= "table" then return false end
    local t = stunData.StunType
    if t == 3 or t == 4 then
        e.StunEvade_LastKick = os.clock()
        return true
    end
    local lk = e.StunEvade_LastKick
    return lk ~= nil and os.clock() - lk < 2.2
end

local function installAntiKick()
    local e = env()
    -- the hooks live for the whole session and keep the code they were created with, so
    -- they call THESE env entries, which every (re)run of the script refreshes
    e.StunEvade_IsKickStun = function(stunData) return isKickStun(e, stunData) end
    if e.StunEvade_KickHook3 then
        antiKickStatus = "active"
        pcall(function() if e.StunEvade_HookAudio then e.StunEvade_HookAudio() end end)
        return true
    end
    local function fail(why) antiKickStatus = "NOT active: " .. why return false, why end
    if type(hookfunction) ~= "function" then return fail("no hookfunction in this executor") end
    if not saberStillValid(saberComp) then return fail("saber not found (equip + ignite it)") end
    local okC, classes = pcall(function()
        local mt = getmetatable(saberComp)
        local sabClass
        if type(mt) == "table" then
            if type(rawget(mt, "HandleSignal")) == "function" then sabClass = mt
            elseif type(mt.__index) == "table" and type(rawget(mt.__index, "HandleSignal")) == "function" then sabClass = mt.__index end
        end
        local fsmClass
        local csm = rawget(saberComp, "CombatStateMachine")
        local fm = csm and getmetatable(csm)
        if type(fm) == "table" then
            if type(rawget(fm, "Input")) == "function" then fsmClass = fm
            elseif type(fm.__index) == "table" and type(rawget(fm.__index, "Input")) == "function" then fsmClass = fm.__index end
        end
        return { sab = sabClass, fsm = fsmClass }
    end)
    if not okC or not classes.sab or type(rawget(classes.sab, "HandleSignal")) ~= "function" then
        return fail("couldn't find HandleSignal")
    end
    if classes.fsm and type(rawget(classes.fsm, "Input")) ~= "function" then classes.fsm = nil end

    -- hookfunction gives back the original; hold it in a local and call it from inside
    -- the new function (see hook 1)
    local hookHandle = rawget(classes.sab, "HandleSignal")
    local hookInput = (classes.fsm and rawget(classes.fsm, "Input")) or nil
    local okH, err = pcall(function()
        local hookedHandle = hookfunction(hookHandle, function(self, req, payload, ...)
            local s = e.StunEvade_Settings
            local pred = e.StunEvade_IsKickStun
            if s and s.antiKick and req == 15 and pred and pred(payload) then return end -- 15 = STUN
            return hookedHandle(self, req, payload, ...)
        end)
        if hookInput then
            local hookedInput = hookfunction(hookInput, function(self, name, data, ...)
                local s = e.StunEvade_Settings
                local pred = e.StunEvade_IsKickStun
                if s and s.antiKick and name == "stun_request" and type(data) == "table"
                    and pred and pred(data.StunData) then
                    return false
                end
                return hookedInput(self, name, data, ...)
            end)
        end
    end)
    if not okH then return fail("hook failed: " .. tostring(err)) end
    e.StunEvade_KickHook3 = true
    antiKickStatus = classes.fsm and "active" or "active (partial)"
    pcall(function() if e.StunEvade_HookAudio then e.StunEvade_HookAudio() end end)
    return true
end

-- Auto Evade, EARLY trigger: hook the exact spot where the server's stun message arrives
local function installEvadeHook()
    local e = env()
    e.StunEvade_OnStun = function(payload)
        if settings.antiKick and isKickStun(e, payload) then return end
        requestEvade()
        doEvade(true)
    end
    if e.StunEvade_EvadeHook then return true end
    if type(hookfunction) ~= "function" or not saberStillValid(saberComp) then return false end
    local okC, class = pcall(function()
        local mt = getmetatable(saberComp)
        if type(mt) ~= "table" then return nil end
        if type(rawget(mt, "HandleSignal")) == "function" then return mt end
        if type(mt.__index) == "table" and type(rawget(mt.__index, "HandleSignal")) == "function" then return mt.__index end
        return nil
    end)
    if not okC or not class or type(rawget(class, "HandleSignal")) ~= "function" then return false end
    local hookSignal = rawget(class, "HandleSignal")
    local okH = pcall(function()
        local hookedSignal = hookfunction(hookSignal, function(self, req, payload, ...)
            local s = e.StunEvade_Settings
            if s and s.autoEvade and req == 15 and e.StunEvade_OnStun then
                pcall(e.StunEvade_OnStun, payload)
            end
            return hookedSignal(self, req, payload, ...)
        end)
    end)
    if okH then e.StunEvade_EvadeHook = true end
    return okH
end

local antiKickSwitch
local antiKickStatusSink
local function setAntiKick(on)
    settings.antiKick = on
    if antiKickSwitch then antiKickSwitch(on, true) end
    if on then
        local ok, why = installAntiKick()
        if ok then log("Anti-kick ON - kick stuns are ignored on your screen")
