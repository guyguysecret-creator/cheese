------------------------------------------------------------------------
-- Input Sink  (this is the "keys can't stop the Stun Evade" fix)
--
--   NO TOGGLE: the sink is tied to Stun Evade (autoEvade). Turning Stun Evade ON arms it,
--   turning it OFF releases every key again. While it is armed only RIGHT CLICK reaches
--   the game - every key and left/middle mouse are swallowed.
--
--   WHY THE OLD BLOCKER NEVER WORKED: it tried to "eat" keys by rewriting
--   `input.UserInputType = Enum.UserInputType.None` inside UserInputService.InputBegan.
--   Roblox fires InputBegan to every listener and the game had already been given the
--   same event object, so the game still saw the key. Same for mouse buttons.
--
--   WHAT ACTUALLY WORKS: ContextActionService. A binding at a higher priority than the
--   game's own bindings, returning Enum.ContextActionResult.Sink, stops the input before
--   the game's action handlers run. We bind it for every keyboard key and for left /
--   middle mouse, and never for MouseButton2 (right click = block / parry).
--
--   The game binds its own actions while it sets up (and again on respawn), so the sink
--   is (re)applied one frame after every character spawn - that moves the game's
--   bindings below ours.
--
--   Feature presses (parry click, E dash, W) are NOT blocked: they either call the
--   game's own functions (saber:ProcessInput) or feed the state machine, so they skip
--   the input layer entirely. That is also why a blocked key can never cancel a dash.
------------------------------------------------------------------------
local SINK_NAME = "StunEvade_InputSink"
local SINK_PRIORITY = 9000
-- keys the sink lets through on purpose: H (Ctrl+H hides the panel), the anti-kick key,
-- and Escape. Nothing else gets past, so no key can cancel a dash / stun evade.
local SINK_PASS = { [Enum.KeyCode.H] = true, [Enum.KeyCode.Escape] = true }
local sinkApplied = false
local sinkFrame = 0

local function sinkActionList()
    local list = {}
    for _, kc in ipairs(Enum.KeyCode:GetEnumItems()) do
        if kc ~= Enum.KeyCode.Unknown then list[#list + 1] = kc end
    end
    list[#list + 1] = Enum.UserInputType.MouseButton1
    list[#list + 1] = Enum.UserInputType.MouseButton3
    list[#list + 1] = Enum.UserInputType.MouseMovement
    return list
end

-- arm (on = true) or release (on = false) the sink. Called by the Stun Evade toggle and
-- re-called after every spawn.
local function sinkSet(on)
    if not on then
        if sinkApplied then
            pcall(function() ContextActionService:UnbindAction(SINK_NAME) end)
            sinkApplied = false
        end
        return
    end
    local pass = SINK_PASS
    if settings.antiKickKey and Enum.KeyCode[settings.antiKickKey] then
        pass = table.clone(SINK_PASS)
        pass[Enum.KeyCode[settings.antiKickKey]] = true
    end
    pcall(function()
        ContextActionService:UnbindAction(SINK_NAME)
        ContextActionService:BindActionAtPriority(SINK_NAME, function(_, state, input)
            local key = input and input.KeyCode
            if key and pass[key] then return Enum.ContextActionResult.Pass end
            if state == Enum.UserInputState.Begin or state == Enum.UserInputState.Change then
                return Enum.ContextActionResult.Sink
            end
            return Enum.ContextActionResult.Pass
        end, false, SINK_PRIORITY, table.unpack(sinkActionList()))
        sinkApplied = true
    end)
end

-- keep the sink in step with Stun Evade; called by the toggle and by the self-heal loop
local function syncSink()
    sinkSet(settings.autoEvade)
end

-- re-apply a moment after every spawn (the game rebuilds its bindings then)
local function armSink()
    task.delay(0.1, syncSink)
    task.delay(0.6, syncSink)
end
track(LocalPlayer.CharacterAdded:Connect(armSink))
task.delay(0.1, syncSink) -- a re-execute while Stun Evade is already ON re-arms it

-- safety net: while Stun Evade is ON the sink must be up (a respawn or a game rebind can
-- push it under the game's bindings), and while it is OFF it must be gone
track(RunService.Heartbeat:Connect(function()
    sinkFrame = sinkFrame + 1
    if sinkFrame % 300 ~= 0 then return end          -- every ~5s, cheap safety net
    if settings.autoEvade ~= sinkApplied then syncSink() end
end))

------------------------------------------------------------------------
-- Infinite Force
------------------------------------------------------------------------
local DRAIN_ATTR, REGEN_ATTR = "AfflictionForceDrainPerTick", "ForceRegenMultiplier"
local REFILL_PER_TICK, REGEN_MULTIPLIER = 450, 100000
local forceConns = {}

local function forceDisconnect()
    for _, c in ipairs(forceConns) do c:Disconnect() end
    table.clear(forceConns)
end

local function forceApply(char)
    forceDisconnect()
    if not char then return end
    local function enforce(attr, value)
        if char:GetAttribute(attr) ~= value then char:SetAttribute(attr, value) end
    end
    enforce(REGEN_ATTR, REGEN_MULTIPLIER)
    enforce(DRAIN_ATTR, -REFILL_PER_TICK)
    table.insert(forceConns, char:GetAttributeChangedSignal(REGEN_ATTR):Connect(function()
        if settings.force then enforce(REGEN_ATTR, REGEN_MULTIPLIER) end
    end))
    table.insert(forceConns, char:GetAttributeChangedSignal(DRAIN_ATTR):Connect(function()
        if settings.force then enforce(DRAIN_ATTR, -REFILL_PER_TICK) end
    end))
end

local function forceRemove(char)
    forceDisconnect()
    if not char then return end
    if char:GetAttribute(REGEN_ATTR) == REGEN_MULTIPLIER then char:SetAttribute(REGEN_ATTR, nil) end
    if char:GetAttribute(DRAIN_ATTR) == -REFILL_PER_TICK then char:SetAttribute(DRAIN_ATTR, nil) end
end

local function setForce(on)
    settings.force = on
    if on then forceApply(LocalPlayer.Character) else forceRemove(LocalPlayer.Character) end
end

track(LocalPlayer.CharacterAdded:Connect(function(char)
    if settings.force then
        task.wait(1) -- let the game's Character component set up first
        if settings.force then forceApply(char) end
    end
end))

------------------------------------------------------------------------
-- Infinite Block
--   The server puts a NumberValue "Block" on your character and lowers it per hit;
--   your client plays the hit-block animation and, at 0, reports a block break.
--   hook mode: leave the value alone (animation plays), drop only the block-break stun,
--              and pin BlocksLeft at full so the meter never empties.
--   delete mode: delete the server's Block value on your side (no animation).
------------------------------------------------------------------------
local MAX_BLOCK = 140
local STUN_BLOCK_BROKEN = 2
local blockMode = nil
local blockConn, blockHookedChar
local stunHooked = false

local function hookBlockBreakStun()
    if stunHooked then return true end
    if env().StunEvade_StunHooked then stunHooked = true return true end
    if type(getgc) ~= "function" or type(hookfunction) ~= "function" then return false end
    local fireFn
    local ok, list = pcall(getgc, true)
    if not ok or type(list) ~= "table" then return false end
    for _, t in ipairs(list) do
        if type(t) == "table" then
            local entry = rawget(t, "LightsaberStunFromClient")
            if type(entry) == "table" and rawget(t, "LightsaberBlock") ~= nil
                and type(rawget(entry, "Fire")) == "function" then
                fireFn = rawget(entry, "Fire")
                break
            end
        end
    end
    if not fireFn and debug.getconstants then
        for _, f in ipairs(list) do
            if type(f) == "function" and (not iscclosure or not iscclosure(f)) then
                local okC, consts = pcall(debug.getconstants, f)
                if okC and type(consts) == "table" then
                    for _, c in ipairs(consts) do
                        if c == "LightsaberStunFromClient Fire" then fireFn = f break end
                    end
                end
                if fireFn then break end
            end
        end
    end
    if type(fireFn) ~= "function" then return false end
    -- hookfunction returns the ORIGINAL function: keep it in a local and call it from
    -- inside the new function. (Calling a value that may be any? is a Luau type error,
    -- so the original is handed over as a plain local, never via a reassigned one.)
    local original = fireFn
    local okH = pcall(function()
        local hooked = hookfunction(original, function(payload, ...)
            local s = env().StunEvade_Settings
            if s and s.block and type(payload) == "table"
                and (payload.BlockBreak == true or payload.StunType == STUN_BLOCK_BROKEN) then
                return
            end
            return hooked(payload, ...)
        end)
    end)
    if okH then
        stunHooked = true
        env().StunEvade_StunHooked = true
    end
    return okH
end

local function isBlockValue(obj)
    return obj.Name == "Block" and obj:IsA("NumberValue")
end

local function killBlockValue(obj)
    task.defer(function()
        if settings.block and blockMode == "delete" and obj.Parent then
            pcall(function() obj:Destroy() end)
        end
    end)
end

local function blockDeleteHook(char)
    if blockConn then blockConn:Disconnect(); blockConn = nil end
    blockHookedChar = nil
    if not (settings.block and blockMode == "delete" and char) then return end
    for _, child in ipairs(char:GetChildren()) do
        if isBlockValue(child) then killBlockValue(child) end
    end
    blockConn = char.ChildAdded:Connect(function(child)
        if isBlockValue(child) then killBlockValue(child) end
    end)
    blockHookedChar = char
end

local function setBlock(on)
    settings.block = on
    if on and not blockMode then
        if hookBlockBreakStun() then
            blockMode = "hook"
            log("Infinite Block: hook mode (hit-block animation still plays)")
        else
            blockMode = "delete"
            log("Infinite Block: delete mode (no getgc/hookfunction - hit animation won't play)")
        end
    end
    blockDeleteHook(LocalPlayer.Character)
end

track(LocalPlayer.CharacterAdded:Connect(function(char)
    if settings.block then blockDeleteHook(char) end
end))

------------------------------------------------------------------------
-- Infinite Parry + Infinite Kicks
------------------------------------------------------------------------
local function isMySaber(t)
    if type(t) ~= "table" then return false end
    if type(rawget(t, "ParriesLeft")) ~= "number" or type(rawget(t, "KicksLeft")) ~= "number" then return false end
    return rawget(t, "Local") == true
end

local function saberStillValid(t)
    if not t then return false end
    local ok, valid = pcall(function()
        local cc = rawget(t, "CharacterComponent")
        return isMySaber(t) and cc ~= nil and cc.Instance == LocalPlayer.Character
    end)
    return ok and valid
end

local function scanForSaber()
    lastScan = os.clock()
    if type(filtergc) == "function" then
        local ok, res = pcall(filtergc, "table", { Keys = { "ParriesLeft", "KicksLeft" } })
        if ok and type(res) == "table" then
            for _, t in pairs(res) do
                if saberStillValid(t) then return t end
            end
        end
    end
    if type(getgc) ~= "function" then
        if not warnedNoGC then warnedNoGC = true; log("no getgc in this executor - parry/kicks can't work") end
        return nil
    end
    local ok, list = pcall(getgc, true)
    if not ok or type(list) ~= "table" then return nil end
    for _, t in ipairs(list) do
        if saberStillValid(t) then return t end
    end
    return nil
end

-- one accessor for everything that needs the saber: cached, rescanned every 2s
local function getSaber()
    if saberStillValid(saberComp) then return saberComp end
    saberComp = nil
    if os.clock() - lastScan < 0.5 then return nil end
    return scanForSaber()
end

------------------------------------------------------------------------
-- Force pin (the game's drain loop skips a bar that is exactly 0)
------------------------------------------------------------------------
local charComp
local lastCharScan = 0

local function isMyCharComp(t)
    if type(t) ~= "table" then return false end
    local ok, valid = pcall(function()
        return type(rawget(t, "Force")) == "number"
            and type(rawget(t, "MaxForce")) == "number"
            and t.Instance == LocalPlayer.Character
            and t.SetForce ~= nil
    end)
    return ok and valid
end

local function scanForCharComp()
    lastCharScan = os.clock()
    if saberComp then
        local cc = rawget(saberComp, "CharacterComponent")
        if isMyCharComp(cc) then return cc end
    end
    if type(filtergc) == "function" then
        local ok, res = pcall(filtergc, "table", { Keys = { "Force", "MaxForce" } })
        if ok and type(res) == "table" then
            for _, t in pairs(res) do
                if isMyCharComp(t) then return t end
            end
        end
    end
    if type(getgc) ~= "function" then return nil end
    local ok, list = pcall(getgc, true)
    if not ok or type(list) ~= "table" then return nil end
    for _, t in ipairs(list) do
        if isMyCharComp(t) then return t end
    end
    return nil
end

track(RunService.Heartbeat:Connect(function()
    if not settings.force then return end
    if not isMyCharComp(charComp) then
        charComp = nil
        if os.clock() - lastCharScan < 2 then return end
        charComp = scanForCharComp()
        if not charComp then return end
        log("Infinite Force: found your character component (bar is held full)")
    end
    local maxF = rawget(charComp, "MaxForce")
    if rawget(charComp, "Force") < maxF then
        charComp.Force = maxF
        pcall(function() charComp.SetForce:Fire(1) end)
    end
end))

track(RunService.Heartbeat:Connect(function()
    local pinBlock = settings.block and blockMode == "hook"
    if not (settings.parry or settings.kick or pinBlock or settings.autoParry
        or settings.autoEvade or settings.antiKick or settings.chaseMulti) then return end
    local sc = getSaber()
    if not sc then return end
    if settings.parry and rawget(sc, "ParriesLeft") < MAX_PARRIES then
        sc.ParriesLeft = MAX_PARRIES
        pcall(function() sc:SetParries() end)
    end
    if settings.kick and rawget(sc, "KicksLeft") < MAX_KICKS then
        sc.KicksLeft = MAX_KICKS
        pcall(function() sc:SetKicks() end)
    end
    if pinBlock then
        local b = rawget(sc, "BlocksLeft")
        if type(b) == "number" and b < MAX_BLOCK then
            sc.BlocksLeft = MAX_BLOCK
            pcall(function() sc:SetBlock() end)
        end
    end
end))

------------------------------------------------------------------------
-- Hitbox Expander
--   Each enemy gets a separate ANCHORED box inside their character model that follows
--   their root part every frame. Their real body is never touched, so no frozen players.
------------------------------------------------------------------------
local BOX_NAME = "HBE_Box"
local boxes = {}

local function isEnemy(plr)
    if plr == LocalPlayer then return false end
    if not settings.teamCheck then return true end
    if LocalPlayer.Team == nil or plr.Team == nil then return true end
    return plr.Team ~= LocalPlayer.Team
end

local function removeBox(char)
    local box = boxes[char]
    boxes[char] = nil
    if box then box:Destroy() end
end

local function removeAllBoxes()
    for char in pairs(boxes) do removeBox(char) end
end

local function getBox(char)
    local box = boxes[char]
    if box and box.Parent == char then return box end
    box = Instance.new("Part")
    box.Name = BOX_NAME
    box.Anchored = true
    box.CanCollide = false
    box.CanTouch = false
    box.CanQuery = true
    box.Massless = true
    box.CastShadow = false
    box.Material = Enum.Material.SmoothPlastic
    box.Color = Color3.fromRGB(255, 60, 60)
    box.Parent = char
    boxes[char] = box
    return box
end

track(RunService.RenderStepped:Connect(function()
    if not settings.hbe then return end
    local s = settings.hbeSize
    local size = Vector3.new(s, s, s)
    local seen = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 and isEnemy(plr) then
            local box = getBox(char)
            box.CFrame = hrp.CFrame
            if box.Size ~= size then box.Size = size end
            if box.Transparency ~= settings.hbeTransparency then box.Transparency = settings.hbeTransparency end
            seen[char] = true
        end
    end
    for char in pairs(boxes) do
        if not seen[char] then removeBox(char) end
    end
end))

local function setHBE(on)
    settings.hbe = on
    if not on then removeAllBoxes() end
end
