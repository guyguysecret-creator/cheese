------------------------------------------------------------------------
-- Log buffer (F9 has no log box any more; this is kept so nothing else breaks)
------------------------------------------------------------------------
local logEntries = {}
local logSink
local VERBOSE = false
local function pushLog(who, msg)
    if VERBOSE then pcall(print, "[StunEvade]", msg) end
    table.insert(logEntries, { who = who, msg = msg })
    if #logEntries > 120 then table.remove(logEntries, 1) end
    if logSink then pcall(logSink) end
end
local function joinArgs(...)
    local parts = {}
    for i = 1, select("#", ...) do parts[i] = tostring((select(i, ...))) end
    return table.concat(parts, " ")
end
local function log(...) pushLog(nil, joinArgs(...)) end
local function logP(who, ...) pushLog(who, joinArgs(...)) end

