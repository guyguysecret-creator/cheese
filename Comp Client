-- Auto Parry
--   You hold right-click (saber ignited, state "blocking"); the script presses
--   left-click for you when an incoming swing is really aimed at you.
--
--   How it detects swings: attackers' swing animations replicate to your client, so
--   we look at every other player's Animator for one of the game's attack animations
--   (Attack_1-4 for every form + dash attacks) and read its TimePosition.
--
--   A swing counts as a THREAT only if ALL of these hold:
--     - aimed at you: attacker's facing is within ~65 deg of the line to you
--       (stray swings at other people / at nothing are ignored)
--     - about to land: we track their blade and predict the time until it reaches you
--       (distance / closing speed), and click when that is <= ping + 0.18s - so fast
--       dash attacks and high ping automatically trigger from further away
--     - committed: swing has been running >= 50ms (a feint that's cancelled instantly
--       never gets a parry), and it isn't past ~70% of the animation (hit already done)
--   Parry in the game stays active ~0.7s, so firing a little early is safe.
--
--   Multiple attackers: all threats are scored each frame, ONE parry covers every swing
--   in that window, and each swing (animation instance) can only trigger once - so
--   combo follow-ups are new swings and get their own check once the 1.5s cooldown ends.
--   Baits: right before clicking the threat is re-checked; if the swing was cancelled
--   in the meantime, that attacker gets a "bait score" that makes us wait slightly
--   longer on their next swings.
--   Timing: a small random delay (0-40ms) and a per-swing random +-12% on the trigger
--   time, so it isn't frame-perfect every time. "Parry timing (ms)" in the panel
--   shifts everything: + = later, - = earlier.
--
--   Safety: never clicks unless your saber is in the BLOCKING state, you have parries
--   left and the parry cooldown is over - otherwise a click would swing instead.
------------------------------------------------------------------------
local AP = {
    CONE_COS = 0.3,      -- cos(~72 deg): how directly the attacker must face you
    MAX_RANGE = 55,      -- studs: ignore attackers further than this (dash attacks start far away)
    ZIG_ANGLE = 65,        -- stun evade: how far (degrees) the first (fake) leg swings off 'straight away'; later legs use 70% / 40% / 25% of it
    ZIG_FAKE = 0.13,       -- stun evade: length (s) of the short fake leg at the start
    SNIPE_MIN_DIST = 33,   -- jump chase: only when they are further than one dash reaches (studs)
    SNIPE_MIN_STUN = 0.9,  -- jump chase: only with at least this much stun left (s)
    SNIPE_JUMP_AFTER = 0.3, -- jump chase: seconds into the dash before the jump
    EVADE_FACING = 0.5,    -- stun evade: attacker counts as "looking straight at you" above this (1 = dead on)
    DASH_GUARD_SPEED = 25, -- studs/s toward you that counts as "dashing at you"
    DASH_GUARD_RANGE = 70, -- studs
    DASH_GUARD_LEAD = 0.1, -- s extra lead (on top of ping) for the dash-guard parry
    DASH_REACH = 8,     -- studs in front of a dashing attacker that their blade can hit
    BODY_RADIUS = 2.5,   -- studs: blade counts as "landed" this close to your center
    MIN_SWING_SPEED = 9, -- studs/s: blade speed relative to THEIR body that counts as a swing
    HIT_RADIUS = 4.5,    -- studs: blade's closest approach to your center that counts as "aimed at you"
    MIN_CLOSING = 5,     -- studs/s: blade must be heading toward you at least this fast
    KICK_RESPONSE = "parry", -- what to do about an incoming kick: "parry" or "dash" (taps E)
    KICK_TOL = 3,        -- studs of forgiveness around the kick's real hit box
    KICK_RANGE = 9,     -- studs: kick hit box reaches ~4.5 studs, plus slack (after ping/dash compensation)
    KICK_CONE = 0.45,    -- cos(~63 deg): kicker must face you (beyond NEAR_RANGE)
    KICK_WINDUP = 0.4,   -- s from kick start until the hit box turns on (game constant)
    COUNTER_RANGE = 26,  -- Anti-kick counter: react to a kicker this close (studs), wider than Auto Parry's kick test
    COUNTER_FAR = 50,    -- Anti-kick counter: a kicker this far who is FACING you also counts (a dash-kick starts its kick from up to ~one dash + one kick away)
    NEAR_RANGE = 7,      -- studs: inside this, facing is ignored (sweeping swings from the side)
    KICK_CLOSE = 9,      -- (v95) Anti-kick: a plain kick (no dash) is only countered from this close (studs)
    DASH_RUSH = 30,      -- (v96) studs/s toward you that counts as DASHING at you (walking is 16)
    CLOSE_COMMIT = 0.015, -- s: shorter feint filter when the attacker is within CLOSE_RANGE
    CLOSE_RANGE = 12,  -- studs: inside this, a swing animation facing you = parry right away
    CLOSE_CONE = 0.55,   -- cos(~57 deg): how directly they must face you for the close rule
    CLOSE_MISS = 6.5,    -- studs: close rule is skipped if the blade clearly passes this far from you
    MIN_COMMIT = 0.03,   -- s the swing must have run (feint filter)
    MAX_PHASE = 0.85,    -- ignore swings nearly finished
    AIM = 0.18,          -- s: we want the hit to land this long AFTER our parry is active
    TIME_VARIANCE = 0.12, -- per-swing random +-12% on the trigger time
    JITTER_MAX = 0.025,  -- extra human delay 0..25ms (triangular, ~12ms average)
    DASH_CLOSING = 22,   -- studs/s: attacker body rushing at you this fast = dash attack
    DEBUG = false,       -- (only matters when VERBOSE is on) explains why a swing/kick was ignored
    FALLBACK_HIT = 0.25, -- s into a swing the hit lands, only if no blade parts are found
    MULTI_ULTRA = 50,    -- ms: "Multi delay" at or below this = ULTRA multi (no pacing at all)
    -- anti-feint / anti-fake (v67)
    FEINT_HOLD = 0.10,   -- s: how much later than normal a young swing may be answered while we watch for a feint
    FEINTER_HOLD = 0.05, -- s: extra hold vs players who have been feinting you
    CLOSE_HIT = 0.24,    -- s of animation time into a swing where a close-range hit lands (close rule estimate)
    DASH_TIME = 0.5,     -- s: a force dash lasts this long (60 studs/s -> ~30 studs)
    DASH_FAST = 40,      -- studs/s flat speed that means "mid-dash"
    SWING_ACTIVE = 0.45, -- s: a normal swing can still hit up to about this long after it starts
    FROM_BLOCK = 0.1,    -- s: an unknown "attack" animation starting this soon after blocking = their PARRY
    guard = {}, feint = {}, feintT = {}, dashT = {},  -- per-player state (filled in by updateSwings)
    learnedParry = {},   -- custom-form PARRY animation ids learned in play (never treated as swings again)
    armed = {},          -- [player] = time: Dash guard saw them dash in - answer their follow-up swing instantly
    rushT = {},          -- [player] = last time they were moving toward me fast (forwards OR backwards)
}

-- Pacing between multi cycles (Parry chase + Anti-kick counter). Normal: the game's own minimum for
-- that input (`base`: ~0.15s swing / ~0.18s dash) PLUS "Multi delay", +-20% so it isn't a metronome.
-- If "Multi delay" is lowered a TON (MULTI_ULTRA ms or less) the pacing is dropped completely: inputs
-- go out every frame and only the game's own cooldowns limit them. Very fast - and it looks it.
local function multiGap(base)
    local d = (settings.multiDelay or 0) / 1000
    if d * 1000 <= AP.MULTI_ULTRA then return 0 end
    return base + d * (0.8 + math.random() * 0.4)
end
-- (v74) Anti-kick counter pacing: a human-looking 0.26-0.34s between multis (+-random), a bit slower than
-- before (it was capped at 0.2s, which looked too fast). ULTRA Multi delay (50 or below) still goes all out.
function AP.counterGap(base)
    if (settings.multiDelay or 0) <= AP.MULTI_ULTRA then return 0 end
    return math.max(base, 0.26 + math.random() * 0.08)
end

-- Is somebody ELSE a clearly better target for this player's kick/dash than me? (closer to them and
-- right in front of them). Anti-kick uses it so a kick or dash aimed at a third person - two people
-- fighting near you - never makes you let go of block. Inside 5 studs it always says "no": that close,
-- the kick's box reaches you anyway.
local function betterTargetThanMe(kHrp, myHrp)
    local toMe = Vector3.new(myHrp.Position.X - kHrp.Position.X, 0, myHrp.Position.Z - kHrp.Position.Z)
    local dMe = toMe.Magnitude
    if dMe <= 5 then return false end
    local lf = Vector3.new(kHrp.CFrame.LookVector.X, 0, kHrp.CFrame.LookVector.Z)
    -- (v73) a kicker dashing BACKWARDS (reverse kick) heads where they move, not where they look
    local okV, vel = pcall(function() return kHrp.AssemblyLinearVelocity end)
    if okV and vel then
        local fv = Vector3.new(vel.X, 0, vel.Z)
        if fv.Magnitude >= 15 then lf = fv end
    end
    if lf.Magnitude < 0.01 then return false end
    lf = lf.Unit
    for _, p in ipairs(Players:GetPlayers()) do
        local c = p ~= LocalPlayer and p.Character
        local h = c and c:FindFirstChild("HumanoidRootPart")
        if h and c ~= kHrp.Parent then
            local v = Vector3.new(h.Position.X - kHrp.Position.X, 0, h.Position.Z - kHrp.Position.Z)
            local d = v.Magnitude
            if d > 0.01 and d < dMe - 2 and lf:Dot(v / d) >= 0.8 then return true end
        end
    end
    return false
end

