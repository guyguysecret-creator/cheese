                TweenService:Create(stroke, fout, { Transparency = 1 }):Play()
                TweenService:Create(lbl, fout, { TextTransparency = 1 }):Play()
                task.wait(0.45)
                if box.Parent then box:Destroy() end
            end)
        end)
