-- the kick uses the "ParryBreak" animation (Client.Components.Lightsaber.States.Combat.Kicking)
local KICK_ID = "13552157283"
local DASH_ID = "6302511048" -- Dash_Animation (force dash, E)

local pingEma = 0.08
local baitScore = {}                              -- [player] = n
local handledSwing = setmetatable({}, { __mode = "k" }) -- swing track -> true
local swingVariance = setmetatable({}, { __mode = "k" }) -- swing track -> random factor
local apBusy = false
local apLoggedFirst = false

-- The game can SWAP a player's attack/block/parry animation ids at runtime (custom
-- animation packs: Animations.ChangeTempleGuard & co), so a fixed attack-id list misses
-- those players. Fix: every animation id the game ships that is NOT an attack is listed
-- here; any other non-looping animation on a player whose saber is out is treated as a
-- swing too ("unknown" attack) - and the id is printed once so you can see it.
local NON_ATTACK_IDS = {}
for _, id in ipairs({
    6312272936, 6312274072, 6317093733, 6317094309, 6728895746,           -- flips, roll
    6584511045, 7873070812,                                               -- throws
    72741768067322, 89740527877951, 128004514519482, 108843758967999,
    91879086197386, 117020519174436,                                      -- force powers
    13552166958, 13552173835, 13552177816, 13552182822,                   -- skids
    6322860474, 6669642689, 101135636991956, 6753364277, 10443668308,     -- parries
    6297531803, 6322313635, 6322315386,                                   -- stuns
    6291932252, 6291933169, 6292610264, 6292625270, 6292146811, 6292155163,
    6291934524, 6291935220, 6292615823, 6292632003,                       -- equip / sheathe
    6317096682, 6688720735, 6753335745, 6860753522, 10443588041, 109060630722907, -- idles
    6317097513, 6312280575, 6312281206, 6312281779, 6312282511, 6669641262,
    7101397703, 6736233297, 7101402353, 6861038808, 6861088961, 6860799757,
    7101356513, 6753361279, 6860759883, 109369432331476,                  -- blocks
    6302511048, 6302512079, 6382639524, 6392682622,                       -- dashes (movement)
}) do NON_ATTACK_IDS[tostring(id)] = true end
local loggedUnknown = {}

-- returns track, isKick, isUnknownAnim
local function findAttackTrack(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then return nil end
    local ok, tracks = pcall(animator.GetPlayingAnimationTracks, animator)
    if not ok or type(tracks) ~= "table" then return nil end
    local unknown, attack, dash
    local attackPos = math.huge
    for _, trk in ipairs(tracks) do
        local okId, id = pcall(function() return string.match(trk.Animation.AnimationId, "%d+") end)
        if okId and id then
            -- a KICK wins over everything: the swing animation that was playing a moment
            -- earlier can still be fading out and used to hide the kick from us
            if id == KICK_ID then return trk, true, false end
            if ATTACK_IDS[id] then
                -- fast combos: the old swing is still fading while the next one starts.
                -- Always follow the NEWEST one (smallest TimePosition) so we never flip
                -- back and forth between the two and lose our blade-speed history.
                local okP, pos = pcall(function() return trk.TimePosition end)
                if okP and pos < attackPos then attack, attackPos = trk, pos end
            elseif id == DASH_ID then
                dash = dash or trk
            elseif not unknown and not NON_ATTACK_IDS[id] then
                local okL, looped, len = pcall(function() return trk.Looped, trk.Length end)
                if okL and not looped and len > 0.2 and len < 4 then unknown = { trk, id } end
            end
        end
    end
    if attack then return attack, false, false end
    -- DASH GUARD (optional): a force-dash toward you is the first half of dash-kicks and
    -- dash-attacks, so it is also a (early) warning for high-ping players
    if dash and settings.dashGuard then return dash, false, false, true end
    if unknown then
        -- only count it if their saber is actually out (blade parts exist) - filters emotes
        local hasBlade = false
        for _, d in ipairs(char:GetDescendants()) do
            if d.Name == "Core" and d.Parent and string.match(d.Parent.Name, "Blade") then hasBlade = true break end
        end
        if hasBlade then
            if AP.DEBUG and not loggedUnknown[unknown[2]] then
                loggedUnknown[unknown[2]] = true
                logP(char.Name, "Auto Parry: treating unrecognised animation " .. unknown[2] .. " from " .. char.Name .. " as a swing (custom attack pack?)")
            end
            return unknown[1], false, true
        end
    end
    return nil
end

-- Timing model (v2): instead of "are they within X studs" we predict WHEN the blade
-- will reach you. Every frame we track points along each attacker's blade (the "Core"
-- parts inside their "Blade" models - the same parts the game raycasts from), measure
-- how fast they're moving toward you (minus your own movement), and compute
--     timeToHit = (distance - bodyRadius) / closingSpeed
-- We click when timeToHit <= ping + AIM (+ your offset), i.e. so the parry is already
-- active when the hit lands but hasn't run out yet (it lasts ~0.7s).
local bladeCache = setmetatable({}, { __mode = "k" }) -- character -> { cores, t }
local swingState = {}                                  -- [player] = { trk, prev, speed, ttc }

local function getCores(char)
    local c = bladeCache[char]
    if c and os.clock() - c.t < 1.5 then return c.cores end
    local cores = {}
    for _, d in ipairs(char:GetDescendants()) do
        if d.Name == "Core" and d:IsA("BasePart") and d.Parent and string.match(d.Parent.Name, "Blade") then
            cores[#cores + 1] = d
        end
    end
    bladeCache[char] = { cores = cores, t = os.clock() }
    return cores
end

-- called once per frame: refresh every attacker's blade speed + time-to-hit
local plrVel, plrVelFast, plrLastPos, plrPeak = {}, {}, {}, {} -- every player's body velocity, tracked all the time

local function updateSwings(myHrp, dt)
    local myPos, myVel = myHrp.Position, myHrp.AssemblyLinearVelocity
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            -- always know how fast everyone is moving, so the very first frame of a kick
            -- already has a velocity to predict with (no 2-frame warm-up)
            local hrp0 = char and char:FindFirstChild("HumanoidRootPart")
            if hrp0 and dt > 0 then
                local last = plrLastPos[plr]
                if last then
                    local v = (hrp0.Position - last) / dt
                    if v.Magnitude > 150 then v = Vector3.zero end -- respawn / teleport
                    plrVel[plr] = (plrVel[plr] or v) * 0.5 + v * 0.5
                    -- fast-reacting version (70% newest sample): a dash takes off in 1-2
                    -- frames and the slow average above would still read "standing still"
                    plrVelFast[plr] = (plrVelFast[plr] or v) * 0.3 + v * 0.7
                    -- peak speed over roughly the last 0.7s (decays), for dash-kicks
                    plrPeak[plr] = math.max(plrVelFast[plr].Magnitude, (plrPeak[plr] or 0) * math.max(0, 1 - dt * 1.5))
                end
                plrLastPos[plr] = hrp0.Position
            end
            local trk, isKick, isUnknown, isDash
            if char then trk, isKick, isUnknown, isDash = findAttackTrack(char) end
            local old = swingState[plr]
            if old and (not trk or old.trk ~= trk) and AP.DEBUG and not handledSwing[old.trk] and old.why
                and old.why ~= "too early" and os.clock() - (AP._lastDbg or 0) > 0.7 then
                -- that swing/kick ended without us answering it: say why (rate-limited)
                AP._lastDbg = os.clock()
                logP(plr.Name, ("Auto Parry ignored %s from %s: %s"):format(old.isKick and "kick" or "swing", plr.Name, old.why))
            end
            if not trk then
                swingState[plr] = nil
            else
                local st = swingState[plr]
                -- remember "someone near me is kicking" for Anti-kick (unknown stun types)
                if isKick then
                    local hk = char:FindFirstChild("HumanoidRootPart")
                    if hk and (hk.Position - myPos).Magnitude <= 70 then -- 70: a dash-kicker is drawn FAR away
                        ((getgenv and getgenv()) or _G).ForceHBE_LastKick = os.clock()
                    end
                end
                if not st or st.trk ~= trk then
                    st = { trk = trk, prev = nil, relV = {}, swingV = {}, ttc = nil,
                           isKick = isKick, unknown = isUnknown, isDash = isDash, t0 = os.clock(), maxSwing = 0 }
                    swingState[plr] = st
                    -- A custom-pack PARRY animation looks just like an attack to us (its id isn't
                    -- in the game's list). A parry is a reaction: it starts while somebody ELSE
                    -- near that player is mid-swing/kick. If so, remember it - Auto Parry then
                    -- ignores it instead of wasting your parry at the same moment they parry.
                    if isUnknown then
                        local hp = char:FindFirstChild("HumanoidRootPart")
                        if hp then
                            for other, ost in pairs(swingState) do
                                if other ~= plr and ost and not ost.unknown and not ost.isDash then
                                    local oc = other.Character
                                    local oh = oc and oc:FindFirstChild("HumanoidRootPart")
                                    if oh and (oh.Position - hp.Position).Magnitude <= 16 then
                                        st.looksLikeParry = true
                                        break
                                    end
                                end
                            end
                        end
                    end
                    if isDash and AP.DEBUG then
                        logP(plr.Name, ("Auto Parry SAW %s dash (%.0f studs away)"):format(plr.Name,
                            (char:FindFirstChild("HumanoidRootPart") and (char.HumanoidRootPart.Position - myPos).Magnitude) or -1))
                    end
                    if isKick and AP.DEBUG then
                        local hrpK = char:FindFirstChild("HumanoidRootPart")
                        logP(plr.Name, ("Auto Parry SAW a kick from %s (%.0f studs away)"):format(
                            plr.Name, hrpK and (hrpK.Position - myPos).Magnitude or -1))
                    end
                end
                local pts = {}
                for _, core in ipairs(getCores(char)) do
                    if core.Parent then
                        local cf, half = core.CFrame, core.Size.Y / 2
                        pts[#pts + 1] = cf.Position + cf.UpVector * half
                        pts[#pts + 1] = cf.Position
                        pts[#pts + 1] = cf.Position - cf.UpVector * half
                    end
                end
                -- enemy body velocity from position change (to separate SWING motion
                -- from simply walking / strafing around you)
                local hrpE = char:FindFirstChild("HumanoidRootPart")
                local ePos = hrpE and hrpE.Position
                local eVel = plrVel[plr] or Vector3.zero
                st.prevE = ePos
                st.eVel = eVel

                -- how fast is their whole BODY rushing at you? (dash attacks come from far away)
                local bodyClosing = 0
                if ePos then
                    local toMeB = myPos - ePos
                    bodyClosing = (eVel - myVel):Dot(toMeB / math.max(toMeB.Magnitude, 0.01))
                end
                st.bodyClosing = bodyClosing

                local best, missMin
                if st.prev and #pts == #st.prev and dt > 0 then
                    for i, pt in ipairs(pts) do
                        local worldVel = (pt - st.prev[i]) / dt
                        -- smooth so a single jittery frame can't trigger it
                        local rel = worldVel - myVel                -- blade motion as YOU see it
                        local swing = worldVel - eVel               -- blade motion relative to their body
                        st.relV[i] = (st.relV[i] or rel) * 0.5 + rel * 0.5
                        st.swingV[i] = (st.swingV[i] or swing) * 0.5 + swing * 0.5
                        if st.swingV[i].Magnitude > st.maxSwing then st.maxSwing = st.swingV[i].Magnitude end
                        local relV = st.relV[i]
                        local relSpeed = relV.Magnitude
                        if relSpeed > 3 then
                            local toMe = myPos - pt
                            -- follow the blade's path forward: where does it pass closest to you?
                            local tStar = toMe:Dot(relV) / (relSpeed * relSpeed)
                            if tStar >= 0 and tStar < 1 then
                                local miss = (toMe - relV * tStar).Magnitude
                                if not missMin or miss < missMin then missMin = miss end
                                -- path threat: a real swing (fast relative to THEIR body, so walking
                                -- past you doesn't count) that passes through you
                                if (st.swingV[i].Magnitude >= AP.MIN_SWING_SPEED or bodyClosing >= AP.DASH_CLOSING)
                                    and miss <= AP.HIT_RADIUS
                                    and relV:Dot(toMe) / math.max(toMe.Magnitude, 0.01) >= AP.MIN_CLOSING then
                                    local t = math.max(tStar - AP.BODY_RADIUS / relSpeed, 0)
                                    if not best or t < best then best = t end
                                end
                            end
                        end
                    end
                end
                st.prev = (#pts > 0) and pts or nil
                st.ttc = best
                st.missMin = missMin
                st.hasBlade = #pts > 0
            end
        end
    end
end

-- when to click: parry must be active by the time the hit lands
local function triggerTime(trk)
    local v = swingVariance[trk]
    if not v then
        v = 1 + (math.random() * 2 - 1) * AP.TIME_VARIANCE
        swingVariance[trk] = v
    end
    local offset = (settings.parryOffset or 0) / 1000 -- + = later, - = earlier
    if settings.pingAdjust then
        -- "ping sweet spot": your own ping, flipped negative, plus the box value on top
        -- (e.g. 80ms ping + box -75 => -155ms). Because pingEma follows your live ping, a
        -- spike makes it fire earlier and a drop makes it fire later, automatically.
        offset = offset - pingEma
    end
    return math.max((pingEma + AP.AIM) * v - offset, 0.02)
end

-- is this player's current swing a real threat to us? returns urgency (lower = sooner), swingTrack
local function assessThreat(plr, myHrp)
    local char = plr.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    local st = swingState[plr]
    if not hrp or not hum or hum.Health <= 0 or not st then return nil end

    local trk = st.trk
    if handledSwing[trk] then return nil end
    st.why = nil

    local function no(why) st.why = why return nil end

    local okT, timePos, speed, length, playing = pcall(function()
        return trk.TimePosition, trk.Speed, trk.Length, trk.IsPlaying
    end)
    if not okT or not playing then return no("animation stopped (cancelled / stunned)") end

    local toMe = myHrp.Position - hrp.Position
    local d = math.max(toMe.Magnitude, 0.01)
    local face = hrp.CFrame.LookVector:Dot(toMe / d)

    -- DASH GUARD: an enemy force-dashing straight at you. Their dash-kick / dash-attack
    -- comes the moment they land, so on high ping this is the early warning we need.
    -- We parry so that the parry is up as they ARRIVE (it then covers the ~0.7s after).
    if st.isDash then
        if not settings.dashGuard then return no("dash guard is off") end
        local fast = plrVelFast[plr] or Vector3.zero
        local dirE = toMe / d
        local toward = fast:Dot(dirE)
        if toward < AP.DASH_GUARD_SPEED then return no("dash isn't heading at you") end
        if d > AP.DASH_GUARD_RANGE then return no(("dasher too far (%.0f studs)"):format(d)) end
        if face < 0.45 then return no("dasher not facing you") end
        -- what we see is a ping old, so they are already closer than they look
        local tArrive = math.max(d - AP.DASH_REACH, 0) / toward - pingEma
        if tArrive > pingEma + AP.DASH_GUARD_LEAD then return no("too early") end
        return math.max(tArrive, 0), trk
    end

    -- KICK: no blade involved. The kick's hit box is a ~4.5 stud cube in front of the
    -- kicker that switches on 0.4s after the kick starts (Kicking state: KICK_WINDUP),
    -- so: kicker is close (or rushing in), facing you, and the active moment is near.
    if st.isKick then
        -- HIGH PING: we only SEE the kick about one ping after it really started, and the
        -- kicker's position we see is that old too. So: (1) the kick is further along than
        -- it looks, (2) a kicker who dashes in during the 0.4s windup is closer than shown.
        local sinceStart = os.clock() - st.t0 + pingEma
        if sinceStart > AP.KICK_WINDUP + 0.75 + pingEma then return no("kick was already over") end
        -- WHERE WILL YOU BOTH BE when the hit box switches on? The kicker's position we see
        -- is one ping old and the box turns on KICK_WINDUP after the kick began. A kicker
        -- 26 studs away who is not closing in can never hit, so it is NOT answered
        -- (answering it only burns the 1.5s parry cooldown, then the real kick lands).
        local tAct = math.max(AP.KICK_WINDUP - sinceStart, 0)
        local eVel = plrVelFast[plr] or st.eVel or Vector3.zero
        local kPred = hrp.Position + eVel * (tAct + pingEma)
        local mePred = myHrp.Position + myHrp.AssemblyLinearVelocity * tAct
        local dAct = (mePred - kPred).Magnitude
        local slack = math.min(math.min(pingEma, 0.5) * 12, 4) -- a little extra forgiveness, capped
        -- DASH-KICK: you can only kick when you are NOT dashing, so a dash-kicker dashes in
        -- first and kicks the moment they land. On a laggy screen that kicker is still drawn
        -- partway through the dash (ping x dash speed studs behind where they really are),
        -- and their speed has already dropped to ~0. So remember how fast they were going in
        -- the last ~0.7s and allow for that much "hidden" distance.
        local hidden = math.min(plrPeak[plr] or 0, 90) * (pingEma + 0.15)
        -- Test 1 (geometry): is your body inside the kick's real hit box (4.5-stud cube
        -- in front of the kicker) once we add tolerance for turning / ping drift?
        local rel = hrp.CFrame:PointToObjectSpace(myHrp.Position)
        local tol = AP.KICK_TOL + slack
        local inBox = d <= 14 and (-rel.Z) >= -1.5 and (-rel.Z) <= 4.5 + tol
            and math.abs(rel.X) <= 2.25 + tol and math.abs(rel.Y) <= 2.25 + tol
        -- Test 2 (old rule, now ping-aware): close enough + roughly facing you
        local coneK = AP.KICK_CONE - math.min(pingEma, 0.4) * 0.8 -- laggier = more forgiving aim
        local inReach = dAct <= AP.KICK_RANGE + slack or d <= AP.KICK_RANGE + slack + hidden
        local nearOK = inReach and (face >= coneK or d <= AP.NEAR_RANGE)
        if not inBox and not nearOK then
            if not inReach then
                return no(("kicker too far (%.0f studs now, ~%.0f when the kick lands, %.0f hidden by dash+lag)"):format(d, dAct, hidden))
            end
            return no("kicker not facing you")
        end
        -- a kick can't be cancelled and its windup is fixed, so there is nothing to wait
        -- for: answer the moment we recognise it (any waiting only costs ping-time we lack)
        return math.max(AP.KICK_WINDUP - sinceStart, 0), trk
    end

    local elapsed = timePos / math.max(speed, 0.1)
    -- up close there is almost no time, so the feint filter is much shorter there
    local minCommit = (d <= AP.CLOSE_RANGE and AP.CLOSE_COMMIT or AP.MIN_COMMIT)
        + math.min(0.12, (baitScore[plr] or 0) * 0.03)
    if elapsed < minCommit then return no("too early") end                -- feint filter
    if length > 0 and timePos / length > AP.MAX_PHASE then return no("swing was nearly over") end

    if d > AP.MAX_RANGE then return no(("attacker too far (%.0f studs)"):format(d)) end
    -- facing only matters at range: someone beside you can sweep the blade across you
    -- without their body facing you, so inside NEAR_RANGE the blade path decides instead
    if face < AP.CONE_COS and d > AP.NEAR_RANGE then return no("attacker not facing you") end

    if st.unknown and st.looksLikeParry then return no("looks like their parry (someone else is attacking them)") end
    local ttc = st.ttc
    -- DASH ATTACK: their whole body is rushing at you - no need for the blade path
    local bodyClosing = st.bodyClosing or 0
    if not ttc and bodyClosing >= AP.DASH_CLOSING then
        ttc = math.max(d - AP.DASH_REACH, 0) / bodyClosing
    end
    -- CLOSE-RANGE RULE: slow regular swings and fast multi-hit combos right next to you
    -- don't move fast enough for the path check, so up close the swing animation itself
    -- is the signal: attacker is near, facing you, and the blade isn't clearly going
    -- somewhere else -> parry right away. (Unknown/custom animations must show some
    -- real blade movement first.)
    if not ttc and d <= AP.CLOSE_RANGE
        and (face >= AP.CLOSE_CONE or d <= AP.NEAR_RANGE)
        and (st.missMin == nil or st.missMin <= AP.CLOSE_MISS)
        and not st.unknown then -- unknown/custom animations must PROVE they swing at you (blade path), see below
        ttc = 0
    end
    if not st.hasBlade then
        -- no blade parts found on this player: fall back to swing-animation timing
        ttc = math.max(AP.FALLBACK_HIT - elapsed, 0)
    end
    if not ttc then
        if d <= AP.CLOSE_RANGE then
            return no(("swing is aimed away from you (blade passes %.1f studs off)"):format(st.missMin or -1))
        end
        return no("blade not heading toward you")
    end
    if ttc > triggerTime(trk) then return no("too early") end
    return ttc, trk
end

-- only true when a left-click would really PARRY (not swing)
local function canParryNow()
    local sc = saberComp
    if not saberStillValid(sc) then return false end
    local okS, state = pcall(function() return rawget(sc, "CombatStateMachine"):GetCurrentState() end)
    if not okS or state ~= "blocking" then return false end
    if (rawget(sc, "ParriesLeft") or 0) <= 0 then return false end
    local okC, onCd = pcall(function() return rawget(sc, "Cooldowns"):OnCooldown("parry") end)
    if okC and onCd then return false end
    return true
end

local function sendParryClick()
    if type(mouse1click) == "function" and pcall(mouse1click) then return true end
    if type(mouse1press) == "function" and type(mouse1release) == "function" then
        if pcall(mouse1press) then
            task.wait(0.03)
            pcall(mouse1release)
            return true
        end
    end
    -- last resort (best effort): feed the saber's own state machine the attack input
    return pcall(function()
        saberComp.CombatStateMachine:Input("ATTACK", { inputState = Enum.UserInputState.Begin })
    end)
end

-- Parry through the game's own input handler - the exact function a real left-click
-- calls (Lightsaber:ProcessInput), minus the delay of the OS mouse pipeline. If the
-- game didn't start a parry (parry cooldown still not running after 80ms) we click.
local function sendParryDirect()
    local ok = pcall(function()
        saberComp:ProcessInput(true, { name = "ATTACK", inputState = Enum.UserInputState.Begin })
    end)
    if not ok then return sendParryClick() end
    task.delay(0.08, function()
        local sc = saberComp
        if not sc or not saberStillValid(sc) then return end
        local okC, onCd = pcall(function() return rawget(sc, "Cooldowns"):OnCooldown("parry") end)
        if okC and not onCd then sendParryClick() end -- parry didn't register: real click
    end)
    return true
end

-- optional kick answer: tap E (Force Dash) to get out of the kick's hit box
local lastDash = 0
local function sendDash()
    if type(keypress) == "function" and type(keyrelease) == "function" then
        if pcall(keypress, 0x45) then -- 0x45 = E
            task.wait(0.03)
            pcall(keyrelease, 0x45)
            return true
        end
    end
    return false
end
local function usesDash(st) return st ~= nil and st.isKick and AP.KICK_RESPONSE == "dash" end
local function responseAvailable(st, canParry)
    if usesDash(st) then return os.clock() - lastDash > 1 end
    return canParry
end

local apStep
track(RunService.Heartbeat:Connect(function(dt)
    if not settings.autoParry then
        -- Anti-kick alone still needs to SEE kicks (to know which stuns are kick stuns)
        if settings.antiKick then
            local c = LocalPlayer.Character
            local h = c and c:FindFirstChild("HumanoidRootPart")
            if h then updateSwings(h, dt) end
        end
        return
    end

    local okP, p = pcall(function() return LocalPlayer:GetNetworkPing() end)
    if okP and type(p) == "number" then
        -- follow a spike quickly (so we compensate right away) but come back down gently
        -- (so one lucky low reading doesn't make us late)
        local rate = (p > pingEma) and 8 or 1.5
        pingEma = pingEma + (p - pingEma) * math.min(1, dt * rate)
    end
    apStep(dt)
end))

-- the whole Auto Parry decision. Runs every frame AND the instant a kick animation starts
-- (see the AnimationPlayed hook below), so we don't lose up to a frame waiting for the
-- next Heartbeat - a tiny but real amount of time when you have high ping.
apStep = function(dt)
    local char = LocalPlayer.Character
    local myHrp = char and char:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end
    updateSwings(myHrp, dt) -- keep blade speeds fresh every frame, even before you block
    if apBusy then return end
    local canParry = canParryNow()

    -- score every attacker, react to the most urgent swing/kick we can actually answer
    local bestEta, bestTrk, bestPlr
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local eta, trk = assessThreat(plr, myHrp)
            if eta then
                if not responseAvailable(swingState[plr], canParry) then
                    swingState[plr].why = "it WAS a threat, but you weren't blocking / parry on cooldown / no parries left"
                elseif not bestEta or eta < bestEta then
                    bestEta, bestTrk, bestPlr = eta, trk, plr
                end
            end
        end
    end
    if not bestTrk then return end

    apBusy = true
    -- humanized delay, but when the hit is basically here (close fights) react instantly
    local bestIsKick = swingState[bestPlr] and swingState[bestPlr].isKick
    local delay = (bestIsKick or bestEta < 0.1) and 0 or ((math.random() + math.random()) / 2) * AP.JITTER_MAX
    local function respond()
        apBusy = false
        if not settings.autoParry then return end
        local c = LocalPlayer.Character
        local hrp2 = c and c:FindFirstChild("HumanoidRootPart")
        if not hrp2 then return end

        -- bait / feint check: is it still a live, aimed, in-range swing?
        local eta2, trk2 = assessThreat(bestPlr, hrp2)
        if trk2 ~= bestTrk then
            if not bestTrk.IsPlaying then baitScore[bestPlr] = (baitScore[bestPlr] or 0) + 1 end
            return
        end
        local st2 = swingState[bestPlr]
        if not responseAvailable(st2, canParryNow()) then return end
        baitScore[bestPlr] = math.max(0, (baitScore[bestPlr] or 0) - 0.5)

        if usesDash(st2) then
            -- kick answered with a dash instead of a parry
            handledSwing[bestTrk] = true
            lastDash = os.clock()
            task.spawn(sendDash)
            return
        end

        -- one parry covers everyone swinging (or kicking) right now
        handledSwing[bestTrk] = true
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and not usesDash(swingState[plr]) then
                local _, t2 = assessThreat(plr, hrp2)
                if t2 then handledSwing[t2] = true end
            end
        end

        -- kicks are the time-critical case: use the game's own input path (no OS mouse
        -- latency), with a real click as a back-up if it didn't take
        local sent
        if st2 and (st2.isKick or st2.isDash) then sent = sendParryDirect() else sent = sendParryClick() end
        if AP.DEBUG then
            -- "fired" only means we SENT it - this checks whether the game really started a parry
            local tgt, wasKick = bestPlr.Name, st2 and st2.isKick
            task.delay(0.15, function()
                local sc = saberComp
                if not sc then return end
                local okC, onCd = pcall(function() return rawget(sc, "Cooldowns"):OnCooldown("parry") end)
                local okS, state = pcall(function() return rawget(sc, "CombatStateMachine"):GetCurrentState() end)
                if okC and onCd then
                    logP(tgt, ("Parry CONFIRMED vs %s%s"):format(tgt, wasKick and " (kick)" or ""))
                else
                    logP(tgt, ("Parry did NOT start vs %s (your state: %s)"):format(tgt, tostring(okS and state or "?")))
                end
            end)
        end
        if sent and not apLoggedFirst then
            apLoggedFirst = true
            logP(bestPlr.Name, ("Auto Parry fired (first one this session) vs %s | live ping %.0f ms"):format(bestPlr.Name, pingEma * 1000))
        end
    end
    if delay <= 0 then task.spawn(respond) else task.delay(delay, respond) end
end

-- the instant ANY player's kick animation starts playing, decide right away (event-driven)
do
    local function hook(plr)
        if plr == LocalPlayer then return end
        local function onChar(char)
            task.spawn(function()
                local hum = char:WaitForChild("Humanoid", 10)
                local animator = hum and hum:WaitForChild("Animator", 10)
                if not animator then return end
                track(animator.AnimationPlayed:Connect(function(t)
                    local ok, id = pcall(function() return string.match(t.Animation.AnimationId, "%d+") end)
                    if ok and id == KICK_ID then
                        -- Anti-kick: note "a kick just started near me" the instant it does
                        -- (event-driven, so it's set before the stun can possibly arrive)
                        local mine = LocalPlayer.Character
                        local mh = mine and mine:FindFirstChild("HumanoidRootPart")
                        local kh = char:FindFirstChild("HumanoidRootPart")
                        if mh and kh and (mh.Position - kh.Position).Magnitude <= 70 then
                            ((getgenv and getgenv()) or _G).ForceHBE_LastKick = os.clock()
                        end
                        if settings.autoParry then apStep(0) end
                    end
                end))
            end)
        end
        if plr.Character then onChar(plr.Character) end
        track(plr.CharacterAdded:Connect(onChar))
    end
    for _, plr in ipairs(Players:GetPlayers()) do hook(plr) end
    track(Players.PlayerAdded:Connect(hook))
end

------------------------------------------------------------------------
-- Auto Evade
--   The game gives you a short window right after you're stunned (STUN_DASH_WINDOW,
--   0.4s) in which a force dash is still allowed - after it, dashing is blocked until
--   the stun ends. A dash needs a movement key held (the game checks W/S with
--   UserInputService:IsKeyDown), and W makes it a FORWARD dash (the way you face).
--   So the moment your saber enters the "stunned" state we: snap your character (and the
--   camera) around to face AWAY from the attacker, hold W, wait one frame so the game
--   sees it, then send the dash through the game's own input function (the same one the
--   E key calls); if that didn't start a dash we tap a real E as a back-up; finally W is
--   released and the camera is handed back. Needs Force for a dash (Infinite Force helps).
--   Triggered both by the state machine's StateChanged event (instant) and a per-frame
--   check (back-up).
------------------------------------------------------------------------
local evadeBusy, wasStunned, lastCSM = false, false, nil
local KEY_W, KEY_E = 0x57, 0x45

local KEY_A, KEY_D = 0x41, 0x44

-- WHERE TO GO. The attacker = whoever has a swing/kick/dash in progress first, otherwise
-- the nearest player within 60 studs. All vectors are flat (no up/down).
--   * attacker NOT looking straight at you: evade OPPOSITE to where they're looking
--     (-lookVector) - i.e. away from the side they're facing, never into their swing.
--   * attacker looking DIRECTLY at you (the case where "opposite of their look" would send
--     you straight past/through them): turn away from them and slip out DIAGONALLY,
--     W+A or W+D, picked at random.
-- returns faceDir, moveDir, sideKey (a virtual-key code or nil)
local function evadePlan(hrp)
    local best, bestPri, bestD
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local ch = plr.Character
            local h = ch and ch:FindFirstChild("HumanoidRootPart")
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            if h and hum and hum.Health > 0 then
                local d = (h.Position - hrp.Position).Magnitude
                local pri = swingState[plr] and 0 or 1
                if d <= 60 and (not best or pri < bestPri or (pri == bestPri and d < bestD)) then
                    best, bestPri, bestD = h, pri, d
                end
            end
        end
    end
    local function flat(v) return Vector3.new(v.X, 0, v.Z) end
    local function unit(v, fallback)
        if v.Magnitude < 0.05 then return fallback end
        return v.Unit
    end
    local myLook = unit(flat(hrp.CFrame.LookVector), Vector3.new(0, 0, -1))
    if not best then
        local back = -myLook -- nobody near: just turn around
        return back, back, nil
    end
    local away = unit(flat(hrp.Position - best.Position), -myLook)        -- from attacker to you
    local f = unit(flat(best.CFrame.LookVector), away)                    -- where the attacker looks
    local facingYou = f:Dot(away)                                         -- 1 = looking straight at you
    if facingYou >= AP.EVADE_FACING then
        local side = (math.random(2) == 1) and 1 or -1                    -- +1 = left (A), -1 = right (D)
        local move = CFrame.Angles(0, math.rad(45 * side), 0):VectorToWorldSpace(away)
        return away, move, (side == 1) and KEY_A or KEY_D
    end
    return -f, -f, nil
end

local function movementState()
    local sc = saberComp
    if not saberStillValid(sc) then return nil end
    local ok, st = pcall(function() return rawget(sc, "MovementStateMachine"):GetCurrentState() end)
    return ok and st or nil
end

-- BLOCK BUFFER: the game doesn't let you block while dashing or while stunned (blocking is
-- refused when the movement state is dashing/running/flipping/skidding, and the combat
-- state during a stun isn't a state that accepts block at all), and the key-press that
-- happens during that time is simply lost - you'd have to let go and press again after
-- the dash. This remembers that you're holding right-click and presses block for you the
-- very first moment the game allows it - the same input a real right-click sends - so the
-- block is up right as the evade ends. (It can't make you block DURING the dash/stun:
-- that would mean telling the server you're blocking when the game says you can't.)
local function blockBuffer()
    local t0 = os.clock()
    while os.clock() - t0 < 3 and settings.autoEvade do
        local sc = saberComp
        if saberStillValid(sc) then
            local okS, cs = pcall(function() return rawget(sc, "CombatStateMachine"):GetCurrentState() end)
            if okS and cs == "blocking" then return end
            if okS and cs == "ignited"
                and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                local ms = movementState()
                if ms ~= "dashing" and ms ~= "flipping" and ms ~= "low_flipping" and ms ~= "skidding" then
                    pcall(function()
                        sc:ProcessInput(true, { name = "BLOCK", inputState = Enum.UserInputState.Begin })
                    end)
                end
            end
        end
        RunService.Heartbeat:Wait()
    end
end

local function groundedMS(ms) return ms == "idle_m" or ms == "running" end

-- the game's own dash input (what pressing E does) - no OS keyboard latency
local function sendDashInput()
    if saberStillValid(saberComp) then
        pcall(function()
            saberComp:ProcessInput(true, { name = "FORCE_DASH", inputState = Enum.UserInputState.Begin })
        end)
    end
end

-- every keyboard key + the mouse buttons EXCEPT right-click: bound as one "sink" above the
-- game's own bindings while an evade/chase runs, so nothing you press can interrupt it
local sinkInputs
local function getSinkInputs()
    if sinkInputs then return sinkInputs end
    sinkInputs = {}
    for _, k in ipairs(Enum.KeyCode:GetEnumItems()) do
        if k ~= Enum.KeyCode.Unknown then sinkInputs[#sinkInputs + 1] = k end
    end
    sinkInputs[#sinkInputs + 1] = Enum.UserInputType.MouseButton1
    sinkInputs[#sinkInputs + 1] = Enum.UserInputType.MouseButton3
    sinkInputs[#sinkInputs + 1] = Enum.UserInputType.MouseWheel
    return sinkInputs
end
local function bindSink(name)
    pcall(function()
        game:GetService("ContextActionService"):BindActionAtPriority(name,
            function() return Enum.ContextActionResult.Sink end, false, 9000, table.unpack(getSinkInputs()))
    end)
end
local function unbindSink(name)
    pcall(function() game:GetService("ContextActionService"):UnbindAction(name) end)
end

local function combatStateNow()
    local sc = saberComp
    if not saberStillValid(sc) then return nil end
    local ok, st = pcall(function() return rawget(sc, "CombatStateMachine"):GetCurrentState() end)
    return ok and st or nil
end

local function doEvade()
    if evadeBusy or not settings.autoEvade then return end
    evadeBusy = true
    task.spawn(function()
        local haveKeys = type(keypress) == "function" and type(keyrelease) == "function"
        local cam = workspace.CurrentCamera
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp then evadeBusy = false return end
        local stunStart = os.clock()

        -- NO INPUT CAN MESS IT UP: from this moment every key and mouse button except
        -- right-click is swallowed (and we steer the character ourselves). The game only
        -- asks "is W down?" via UserInputService:IsKeyDown, which the sink doesn't affect.
        bindSink("ForceHBE_EvadeSink")
        -- A jump you spammed BEFORE the sink existed can still be queued on the humanoid and
        -- fire the moment you land - which cuts the dash after ~0.1s. So jumping is switched
        -- off for the whole evade and the queued jump is cleared every frame.
        if hum then pcall(function() hum.Jump = false; hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false) end) end
        local function cleanup(camToRestore, camType)
            pcall(function() RunService:UnbindFromRenderStep("ForceHBE_EvadeMove") end)
            unbindSink("ForceHBE_EvadeSink")
            if hum then pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true) end) end
            if haveKeys then pcall(keyrelease, KEY_W) end
            if camToRestore and camType then pcall(function() camToRestore.CameraType = camType end) end
            evadeBusy = false
        end

        -- MID-AIR: a dash can't start in the air, so wait for the ground. Ground contact is read
        -- from the humanoid itself (FloorMaterial) - it flips the instant you touch down, before
        -- the game's own movement state catches up - and the dash below is retried EVERY frame
        -- so it goes off the very first frame the game accepts it.
        local function onGround()
            return (hum and hum.FloorMaterial ~= Enum.Material.Air) or groundedMS(movementState())
        end
        if not onGround() then
            local t = os.clock()
            while os.clock() - t < 4 and settings.autoEvade and not onGround() do
                if hum then hum.Jump = false end
                RunService.RenderStepped:Wait()
            end
            if combatStateNow() ~= "stunned" then -- stun already over: nothing left to escape
                cleanup()
                return
            end
            char = LocalPlayer.Character
            hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then cleanup() return end
        end

        -- 1) DECIDE the way (see evadePlan), TURN instantly (character + camera)
        local faceDir = evadePlan(hrp)
        local prevCamType
        pcall(function() hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + faceDir) end)
        if cam then
            pcall(function()
                prevCamType = cam.CameraType
                cam.CameraType = Enum.CameraType.Scriptable
                local eye = hrp.Position - faceDir * 10 + Vector3.new(0, 4, 0)
                cam.CFrame = CFrame.lookAt(eye, hrp.Position + faceDir * 20)
            end)
        end

        -- 2) ZIG-ZAG: steer 45 deg to one side (W+D / W+A feel), flip to the other side every
        --    ZIGZAG_STEP seconds, and keep alternating for the whole dash
        local startSide = (math.random(2) == 1) and 1 or -1
        local zigStart = os.clock()
        pcall(function()
            RunService:BindToRenderStep("ForceHBE_EvadeMove", Enum.RenderPriority.Last.Value, function()
                if not hum then return end
                hum.Jump = false
                local seg = math.floor((os.clock() - zigStart) / AP.ZIGZAG_STEP)
                local side = (seg % 2 == 0) and startSide or -startSide
                hum:Move(CFrame.Angles(0, math.rad(45 * side), 0):VectorToWorldSpace(faceDir), false)
            end)
        end)

        -- 3) hold W and DASH. Right after a stun the game only allows a dash inside the first
        --    0.4s ("stun dash window"); after that it refuses until the stun is over - and a
        --    dash started a hair before the stun ends gets its speed reset by the stun ending
        --    (that's the "dashes for 0.1s"). So past the window we wait until you're really out
        --    of the stun, then dash on the next frame.
        if haveKeys then pcall(keypress, KEY_W) end
        RunService.RenderStepped:Wait()                          -- earliest moment the game can see the key
        local wasBlocked = false
        for _ = 1, 150 do                                        -- ~2.5s at 60fps
            local onWindowCd = false
            if saberStillValid(saberComp) then
                local okC, v = pcall(function() return rawget(saberComp, "Cooldowns"):OnCooldown("stun_dash_window") end)
                onWindowCd = okC and v or false
            end
            local late = os.clock() - stunStart >= 0.4
            local blocked = onWindowCd or (late and combatStateNow() == "stunned")
            if wasBlocked and not blocked then RunService.RenderStepped:Wait() end -- let the stun's exit finish
            wasBlocked = blocked
            if not blocked then sendDashInput() end
            RunService.RenderStepped:Wait()
            if movementState() == "dashing" or not settings.autoEvade then break end
        end
        zigStart = os.clock() -- zig-zag starts counting from the real start of the dash
        -- the game cancels a dash when ANY of W/A/S/D/left-click is pressed (a listener it adds
        -- when the dash starts). Take that listener out - and keep it out every frame.
        local function dropCancelListener()
            pcall(function() rawget(saberComp, "_janitor"):Remove("DashCancelInputBegan") end)
        end
        dropCancelListener()
        task.spawn(blockBuffer)                                  -- hold right-click => block the instant it's allowed

        -- 4) steer until the dash really ends (at least 0.15s, at most 0.9s)
        local t0 = os.clock()
        while os.clock() - t0 < 0.9 and (os.clock() - t0 < 0.15 or movementState() == "dashing") do
            dropCancelListener()
            RunService.RenderStepped:Wait()
        end

        cleanup(cam, prevCamType)
    end)
end

------------------------------------------------------------------------
-- Parry chase  (+ "cut the parry animation" so you can move right after a parry)
--   1. Watching: right after you parry, if a nearby player's STUN animation starts, that
--      parry worked and they're stunned.
--   2. The rest of your parry animation is cut short (the game only lets you act normally
--      once it finishes - that was the delay before you could chase). The server-side parry
--      is not touched. Needs Auto Parry or Parry chase on.
--   3. Parry chase (own switch): run at them (or where their evade dash is taking them) and
--      multi: hold W + A, dash (E), cancel the dash into a swing - repeated on the first frame
--      the game accepts each step (see the timing notes in startChase). If they don't evade
--      we only move/dash as much as needed to stay on them. Stops AT ONCE when their stun
--      animation ends, if they leave or die, you get stunned, or after 6s.------------------------------------------------------------------------
local STUN_ANIM_IDS = { ["6297531803"] = true, ["6322313635"] = true, ["6322315386"] = true }
local function findStunTrack(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then return nil end
    local ok, tracks = pcall(animator.GetPlayingAnimationTracks, animator)
    if not ok or type(tracks) ~= "table" then return nil end
    for _, trk in ipairs(tracks) do
        local okId, id = pcall(function() return string.match(trk.Animation.AnimationId, "%d+") end)
        if okId and id and STUN_ANIM_IDS[id] then return trk end
    end
    return nil
end

local function cutParry()
    local sc = saberComp
    if not saberStillValid(sc) then return end
    pcall(function()
        local a = rawget(sc, "Animations").Parry
        if a and a.IsPlaying then a:Stop(0) end -- its Stopped event ends the parrying state
    end)
    task.defer(function()
        RunService.Heartbeat:Wait()
        if combatStateNow() == "parrying" then -- didn't end by itself: finish it ourselves
            local held = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
            pcall(function()
                rawget(sc, "CombatStateMachine"):Input(held and "parry_to_block" or "parry_finished")
            end)
        end
    end)
end

local chaseBusy = false
local function startChase(plr)
    if chaseBusy then return end
    chaseBusy = true
    task.spawn(function()
        local haveKeys = type(keypress) == "function" and type(keyrelease) == "function"
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp then chaseBusy = false return end

        -- Steering: ONE move vector, applied after the game's own controls every frame. We never
        -- set the character's CFrame or touch the camera any more (that snapping is what made the
        -- old chase look weird) - the humanoid turns toward where it's moving by itself.
        local moveDir = hrp.CFrame.LookVector
        pcall(function()
            RunService:BindToRenderStep("ForceHBE_ChaseMove", Enum.RenderPriority.Last.Value, function()
                if hum then hum:Move(moveDir, false) end
            end)
        end)

        -- the multi is  W + A + E, then swing:  hold W and A (the dash reads "is W down?")
        if haveKeys then
            pcall(keypress, KEY_W)
            pcall(keypress, KEY_A)
        end

        -- target velocity measured here, so it works even when Auto Parry is off
        local lastTPos, tVel = nil, Vector3.zero
        local lastTime = os.clock()

        -- THE TIMING (all numbers are the game's own, from CombatConstants):
        --   dash cooldown 0.18s | swing debounce 0.15s | dash costs 32 force + 8 to cancel
        --   a dash can only be cancelled into a swing while the combat state is "ignited"
        --   (not mid-swing), and the swing animation's own "Merge" point puts it back to
        --   "ignited" early - so we simply act on the first frame each condition is true:
        --     1. state ready + dash off cooldown        -> E  (dash)
        --     2. the frame AFTER the dash has started   -> cancel it = swing (what a click does)
        --     3. state ready but dash still cooling down -> plain swing as filler
        --   Nothing is sent earlier than the game accepts it, so no input gets wasted/dropped.
        local DASH_COST = 32 + 8
        local dashFrames, cancelled = 0, false
        local t0 = os.clock()
        while os.clock() - t0 < 6 and settings.parryChase do
            local tc = plr.Character
            local th = tc and tc:FindFirstChild("HumanoidRootPart")
            local thum = tc and tc:FindFirstChildOfClass("Humanoid")
            if not th or not thum or thum.Health <= 0 then break end
            if not findStunTrack(tc) then break end            -- their stun ended: STOP at once
            local cs = combatStateNow()
            if cs == "stunned" then break end                  -- you got hit: stop
            hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then break end

            -- where they ARE and where they're HEADING (they may be dashing/evading away)
            local now = os.clock()
            local dt = math.max(now - lastTime, 1 / 240)
            lastTime = now
            if lastTPos then tVel = tVel * 0.4 + ((th.Position - lastTPos) / dt) * 0.6 end
            lastTPos = th.Position
            local dist = (Vector3.new(th.Position.X, 0, th.Position.Z) - Vector3.new(hrp.Position.X, 0, hrp.Position.Z)).Magnitude
            -- lead: our dash covers ~60 studs/s, so aim where they'll be by the time we get there
            local lead = math.min(dist / 60, 0.45)
            local aim = th.Position + tVel * lead
            local to = Vector3.new(aim.X - hrp.Position.X, 0, aim.Z - hrp.Position.Z)
            if to.Magnitude > 0.5 then
                local dir = to.Unit
                -- far away: straight at them. Up close: slip ~35 degrees to the left (W + A) while swinging
                if dist <= 9 then dir = CFrame.Angles(0, math.rad(35), 0):VectorToWorldSpace(dir) end
                moveDir = dir
            end

            local ms = movementState()
            local sc = saberComp
            local force = 0
            if saberStillValid(sc) then
                local okF, f = pcall(function() return rawget(rawget(sc, "CharacterComponent"), "Force") end)
                force = okF and f or 0
            end

            if ms == "dashing" then
                dashFrames += 1
                -- remove the key listener that would cancel the dash on any key press
                pcall(function() rawget(sc, "_janitor"):Remove("DashCancelInputBegan") end)
                if not cancelled and dashFrames >= 2 and (cs == "ignited" or cs == "blocking") then
                    cancelled = true
                    -- left-click during a dash = dash-cancel straight into a swing
                    local h = rawget(sc, "_dashCancelHandler")
                    if type(h) == "function" then
                        pcall(h, true)
                    else
                        pcall(function()
                            sc:ProcessInput(true, { name = "ATTACK", inputState = Enum.UserInputState.Begin })
                        end)
                    end
                end
            else
                dashFrames, cancelled = 0, false
                if (cs == "ignited" or cs == "blocking") and saberStillValid(sc) then
                    local okC, onCd = pcall(function() return rawget(sc, "Cooldowns"):OnCooldown("dash") end)
                    if not (okC and onCd) and groundedMS(ms) and force >= DASH_COST then
                        sendDashInput()                         -- E (W and A are held)
                    elseif cs == "ignited" then
                        -- dash still cooling down (or no force): keep hitting with plain swings
                        pcall(function()
                            sc:ProcessInput(true, { name = "ATTACK", inputState = Enum.UserInputState.Begin })
                        end)
                    end
                end
            end
            RunService.RenderStepped:Wait()
        end

        pcall(function() RunService:UnbindFromRenderStep("ForceHBE_ChaseMove") end)
        if haveKeys then
            pcall(keyrelease, KEY_W)
            pcall(keyrelease, KEY_A)
        end
        chaseBusy = false
    end)
end
-- watch for "I just parried and the attacker got stunned"
do
    local wasParrying, parryAt = false, -math.huge
    track(RunService.Heartbeat:Connect(function()
        if not (settings.autoParry or settings.parryChase) then wasParrying = false return end
        local parrying = combatStateNow() == "parrying"
        if parrying and not wasParrying then parryAt = os.clock() end
        wasParrying = parrying
        if os.clock() - parryAt > 1.0 then return end          -- only look right after a parry
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local tc = plr.Character
                local th = tc and tc:FindFirstChild("HumanoidRootPart")
                if th and (th.Position - hrp.Position).Magnitude <= 30 then
                    local trk = findStunTrack(tc)
                    local okT, pos = pcall(function() return trk and trk.TimePosition end)
                    if trk and okT and pos < 0.6 then            -- a FRESH stun right after my parry
                        parryAt = -math.huge                     -- count it once
                        cutParry()
                        if settings.parryChase then startChase(plr) end
                        break
                    end
                end
            end
        end
    end))
end

track(RunService.Heartbeat:Connect(function()
    if not settings.autoEvade then wasStunned = false return end
    local sc = saberComp
    if not saberStillValid(sc) then return end
    local okS, csm = pcall(function() return rawget(sc, "CombatStateMachine") end)
    if not okS or not csm then return end
    -- instant path: react the moment the state machine switches to "stunned"
    if csm ~= lastCSM then
        lastCSM = csm
        pcall(function()
            track(csm.StateChanged:Connect(function(state)
                if state == "stunned" and settings.autoEvade then doEvade() end
            end))
        end)
    end
    -- back-up path: per-frame check
    local okG, state = pcall(function() return csm:GetCurrentState() end)
    local stunned = okG and state == "stunned"
    if stunned and not wasStunned then doEvade() end
    wasStunned = stunned
end))

------------------------------------------------------------------------
-- Anti-kick
--   When a kick lands, the SERVER sends your game a "stun" message (type BLOCK_KICKED
--   or PARRY_KICKED) and your game then puts you in the Stunned state: you can't act
--   and the camera shakes. This hooks the saber component's HandleSignal (the function
--   that receives that message) and drops those two stun types, so on YOUR screen you
--   simply aren't stunned and keep full control.
--   Honest limits: the server still decided the kick connected, so your block/parry
--   state or any damage on the server side is not undone, and it does NOT stun the
--   kicker (only a real parry does that). If the server also locks your actions while
--   "stunned" you may still be blocked from some of them.
--   Needs hookfunction + getgc (same as the other getgc features).
------------------------------------------------------------------------
-- Anti-kick v2. Two hooks, so no path into the stunned state is left open:
--   (1) Lightsaber:HandleSignal  - where the server's stun message arrives
--   (2) FiniteStateMachine:Input - the "stun_request" that actually enters Stunned
--       (that is the thing that plays the stun animation + BlockBreak sound)
-- A stun counts as a KICK stun if its type is BLOCK_KICKED/PARRY_KICKED (3/4), OR if a
-- kick animation was seen on someone within ~20 studs of you in the last 1.5s (covers
-- kicks on an un-blocking player, whose stun type we don't know).
local antiKickStatus = "off"
local function isKickStun(env, stunData)
    if type(stunData) ~= "table" then return false end
    local t = stunData.StunType
    if t == 3 or t == 4 then
        -- a kick stun just arrived: open the sparks/sound cleanup window NOW, even if we
        -- never saw the kick animation (first time an animation plays on your screen it
        -- can arrive late while its asset loads - the stun message doesn't wait for it)
        env.ForceHBE_LastKick = os.clock()
        return true
    end
    local lk = env.ForceHBE_LastKick
    return lk ~= nil and os.clock() - lk < 2.2
end

local function installAntiKick()
    local env = (getgenv and getgenv()) or _G
    -- The hooks below live for the whole game session and keep the code they were created
    -- with, so they never call this copy's functions directly: they call THESE env entries,
    -- which every (re)run of the script refreshes. That way updating the script takes effect
    -- without rejoining (an old hook running an old version was a cause of "works 85%").
    env.ForceHBE_IsKickStun = function(stunData) return isKickStun(env, stunData) end
    if env.ForceHBE_KickHook3 then
        antiKickStatus = "active"
        pcall(function() if env.ForceHBE_HookAudio then env.ForceHBE_HookAudio() end end)
        return true
    end
    local function fail(why) antiKickStatus = "NOT active: " .. why return false, why end
    if type(hookfunction) ~= "function" then return fail("no hookfunction in this executor") end
    if not saberStillValid(saberComp) then return fail("saber not found (equip + ignite it)") end
    local okC, classes = pcall(function()
        local mt = getmetatable(saberComp)
        local sabClass
        if type(mt) == "table" then
            if type(rawget(mt, "HandleSignal")) == "function" then sabClass = mt
            elseif type(mt.__index) == "table" and type(rawget(mt.__index, "HandleSignal")) == "function" then sabClass = mt.__index end
        end
        local fsmClass
        local csm = rawget(saberComp, "CombatStateMachine")
        local fm = csm and getmetatable(csm)
        if type(fm) == "table" then
            if type(rawget(fm, "Input")) == "function" then fsmClass = fm
            elseif type(fm.__index) == "table" and type(rawget(fm.__index, "Input")) == "function" then fsmClass = fm.__index end
        end
        return { sab = sabClass, fsm = fsmClass }
    end)
    if not okC or not classes.sab then return fail("couldn't find HandleSignal") end

    local oldHandle, oldInput
    local okH, err = pcall(function()
        oldHandle = hookfunction(rawget(classes.sab, "HandleSignal"), function(self, req, payload, ...)
            local s = env.ForceHBE_Settings -- always the settings of the copy currently running
            local pred = env.ForceHBE_IsKickStun
            if s and s.antiKick and req == 15 and pred and pred(payload) then return end -- 15 = STUN
            return oldHandle(self, req, payload, ...)
        end)
        if classes.fsm then
            oldInput = hookfunction(rawget(classes.fsm, "Input"), function(self, name, data, ...)
                local s = env.ForceHBE_Settings
                local pred = env.ForceHBE_IsKickStun
                if s and s.antiKick and name == "stun_request" and type(data) == "table"
                    and pred and pred(data.StunData) then
                    return false
                end
                return oldInput(self, name, data, ...)
            end)
        end
    end)
    if not okH then return fail("hook failed: " .. tostring(err)) end
    env.ForceHBE_KickHook3 = true
    antiKickStatus = classes.fsm and "active" or "active (partial)"
    pcall(function() if env.ForceHBE_HookAudio then env.ForceHBE_HookAudio() end end) -- mute stun sounds too
    return true
end

-- Auto Evade, EARLY trigger: hook the exact spot where the server's stun message arrives
-- (Lightsaber:HandleSignal, request 15) and start the evade right there - before the game
-- has even finished switching to its Stunned state - instead of waiting to notice the
-- state change. doEvade waits one frame before dashing, so the stun has fully started by
-- then. If Anti-kick is going to drop this stun there's nothing to escape, so skip it.
local function installEvadeHook()
    local env = (getgenv and getgenv()) or _G
    -- each run points the hook at ITS doEvade/settings
    env.ForceHBE_OnStun = function(payload)
        if settings.antiKick and isKickStun(env, payload) then return end
        doEvade()
    end
    if env.ForceHBE_EvadeHook then return true end
    if type(hookfunction) ~= "function" or not saberStillValid(saberComp) then return false end
    local okC, class = pcall(function()
        local mt = getmetatable(saberComp)
        if type(mt) ~= "table" then return nil end
        if type(rawget(mt, "HandleSignal")) == "function" then return mt end
        if type(mt.__index) == "table" and type(rawget(mt.__index, "HandleSignal")) == "function" then return mt.__index end
        return nil
    end)
    if not okC or not class then return false end
    local old
    local okH = pcall(function()
        old = hookfunction(rawget(class, "HandleSignal"), function(self, req, payload, ...)
            local s = env.ForceHBE_Settings
            if s and s.autoEvade and req == 15 and env.ForceHBE_OnStun then
                pcall(env.ForceHBE_OnStun, payload)
            end
            return old(self, req, payload, ...)
        end)
    end)
    if okH then env.ForceHBE_EvadeHook = true end
    return okH
end

local antiKickSwitch -- set by the UI so the key can flip the on-screen switch too
local antiKickStatusSink -- set by the UI: shows antiKickStatus under the key row
local function setAntiKick(on)
    settings.antiKick = on
    if antiKickSwitch then antiKickSwitch(on, true) end
    if on then
        local ok, why = installAntiKick()
        if ok then log("Anti-kick ON - kick stuns are ignored on your screen")
        else log("Anti-kick ON but not active yet: " .. tostring(why) .. " (retrying every 2s)") end
    else
        antiKickStatus = "off"
        log("Anti-kick OFF")
    end
    if antiKickStatusSink then antiKickStatusSink() end
end

-- Anti-kick FX cleanup: the stun SPARKS and SOUND. For ~1.5s after a nearby kick (same
-- window the stun filter uses) we
--   * mute the game's own stun sounds (AudioUtil:PlaySound/PlayLocalSound for names that
--     look like stun/break/kick-hit sounds) via hookfunction,
--   * destroy any Sound / spark / particle instance that gets created near you or on you,
--   * switch off every ParticleEmitter on your character, and put them back afterwards.
-- Best effort: effects the SERVER creates and shows only to others can't be touched.
do
    local env = (getgenv and getgenv()) or _G
    local SoundService = game:GetService("SoundService")

    -- PRELOAD the animations kicks use. The first time an animation plays on your screen
    -- its asset has to download, so it can show up LATE - after the hit and the stun - which
    -- is exactly "only the first kick (and the first dash-kick) gets through". Loaded now,
    -- they play on time from the first kick on.
    task.spawn(function()
        local list = {}
        for _, id in ipairs({
            13552157283,                                  -- the kick
            6302511048, 6302512079, 6382639524, 6392682622, -- dashes
            6297531803, 6322313635, 6322315386,           -- stun animations
            6322860474, 6317097513,                       -- parry, block
        }) do
            local a = Instance.new("Animation")
            a.AnimationId = "rbxassetid://" .. id
            list[#list + 1] = a
        end
        pcall(function() game:GetService("ContentProvider"):PreloadAsync(list) end)
        for _, a in ipairs(list) do a:Destroy() end
    end)

    -- "is a kick happening near me right now?" - ALSO published through env so the
    -- long-lived audio hook always runs the newest version of this check
    local function inWindow()
        local lk = env.ForceHBE_LastKick
        return settings.antiKick and lk ~= nil and os.clock() - lk < 2.2
    end
    env.ForceHBE_InKickWindow = inWindow
    local function badSoundName(n)
        n = tostring(n):lower()
        if n:find("woosh") or n:find("whoosh") then return false end -- the swing/kick whoosh isn't a hit sound
        return n:find("break") or n:find("stun") or n:find("kick") or n:find("hit")
            or n:find("impact") or n:find("spark") or n:find("clash")
    end
    env.ForceHBE_BadSound = badSoundName

    -- 1) the game's own audio helper (found in memory, like the other getgc features).
    --    The hook calls the env functions above, so it never goes stale.
    local function hookAudio()
        if env.ForceHBE_AudioHook2 or type(hookfunction) ~= "function" then return end
        local audio
        local function isAudio(t)
            return type(t) == "table" and type(rawget(t, "PlaySound")) == "function"
        end
        if type(filtergc) == "function" then
            local ok, res = pcall(filtergc, "table", { Keys = { "PlaySound", "PlayLocalSound" } })
            if ok and type(res) == "table" then for _, t in pairs(res) do if isAudio(t) then audio = t break end end end
        end
        if not audio and type(getgc) == "function" then
            local ok, list = pcall(getgc, true)
            if ok and type(list) == "table" then
                for _, t in ipairs(list) do
                    if isAudio(t) and type(rawget(t, "PlayLocalSound")) == "function" then audio = t break end
                end
            end
        end
        if not audio then return end
        local function wrap(fnName)
            local fn = rawget(audio, fnName)
            if type(fn) ~= "function" then return end
            local old
            pcall(function()
                old = hookfunction(fn, function(self, name, ...)
                    local win, bad = env.ForceHBE_InKickWindow, env.ForceHBE_BadSound
                    if win and bad and type(name) == "string" and win() and bad(name) then return end
                    return old(self, name, ...)
                end)
            end)
        end
        wrap("PlaySound"); wrap("PlayLocalSound")
        env.ForceHBE_AudioHook2 = true
    end
    env.ForceHBE_HookAudio = hookAudio

    -- 2) kill sound / spark instances created around you during the window
    local function killFx(d)
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local near
        if d:IsA("Sound") then
            -- on you, stun-like name, or ANY new sound created on a part within 16 studs
            -- (covers the victim's hit sounds when YOU are the one kicking)
            local sp = d:FindFirstAncestorWhichIsA("BasePart")
            near = d:IsDescendantOf(char) or badSoundName(d.Name)
                or (sp ~= nil and (sp.Position - hrp.Position).Magnitude <= 16 and not tostring(d.Name):lower():find("woosh"))
        elseif d:IsA("ParticleEmitter") or d:IsA("Sparkles") or d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Trail") or d:IsA("Beam") then
            local part = d:FindFirstAncestorWhichIsA("BasePart")
            near = part and (d:IsDescendantOf(char) or (part.Position - hrp.Position).Magnitude <= 16)
        end
        if near then pcall(function()
            if d:IsA("Sound") then d.Volume = 0; d:Stop() end
            if d:IsA("ParticleEmitter") then d.Enabled = false end
            d:Destroy()
        end) end
    end
    track(game.DescendantAdded:Connect(function(d)
        if inWindow() then killFx(d) end
    end))

    -- 3) things that ALREADY exist (cached sounds the game replays, emitters it :Emit()s):
    --    while the window is open, every frame
    --      - any playing sound on you / in SoundService / near you with a stun-like name -> volume 0
    --      - any particle emitter on you or within 16 studs -> fully transparent + disabled
    --        (Enabled=false alone doesn't stop :Emit(); transparency does)
    --    and everything is put back when the window closes.
    local savedVol, savedTrans, savedEnabled = {}, {}, {}
    local function muteSound(d, inChar)
        if d.IsPlaying and (inChar or badSoundName(d.Name)) then
            if savedVol[d] == nil then savedVol[d] = d.Volume end
            d.Volume = 0
            pcall(d.Stop, d)
        end
    end
    local function hideFx(d)
        if d:IsA("ParticleEmitter") then
            if savedTrans[d] == nil then savedTrans[d] = d.Transparency; savedEnabled[d] = d.Enabled end
            d.Transparency = NumberSequence.new(1)
            d.Enabled = false
            pcall(d.Clear, d)
        elseif d:IsA("Sparkles") or d:IsA("Fire") or d:IsA("Smoke") then
            if savedEnabled[d] == nil then savedEnabled[d] = d.Enabled end
            d.Enabled = false
        end
    end
    local frameN = 0
    track(RunService.Heartbeat:Connect(function()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        -- WHEN YOU KICK: your own game also shows hit sparks + a hit sound on your screen.
        -- While your saber is in its "kicking" state, keep the window open too, so the
        -- same cleanup hides them for you (each player's script only changes their OWN screen)
        if settings.antiKick and saberStillValid(saberComp) then
            local okK, st = pcall(function() return rawget(saberComp, "CombatStateMachine"):GetCurrentState() end)
            if okK and st == "kicking" then env.ForceHBE_LastKick = os.clock() end
        end
        if inWindow() and hrp then
            frameN += 1
            for _, d in ipairs(char:GetDescendants()) do
                if d:IsA("Sound") then muteSound(d, true) else hideFx(d) end
            end
            if frameN % 2 == 0 then -- the wider sweep every other frame (it's heavier)
                for _, d in ipairs(SoundService:GetDescendants()) do
                    if d:IsA("Sound") then muteSound(d, false) end
                end
                local okP, parts = pcall(workspace.GetPartBoundsInRadius, workspace, hrp.Position, 16)
                if okP and parts then
                    for _, part in ipairs(parts) do
                        if not part:IsDescendantOf(char) then
                            for _, d in ipairs(part:GetDescendants()) do
                                if d:IsA("Sound") then muteSound(d, false) else hideFx(d) end
                            end
                        end
                    end
                end
            end
        elseif next(savedVol) or next(savedTrans) or next(savedEnabled) then
            for d, v in pairs(savedVol) do if d.Parent then pcall(function() d.Volume = v end) end end
            for d, v in pairs(savedTrans) do if d.Parent then pcall(function() d.Transparency = v end) end end
            for d, v in pairs(savedEnabled) do if d.Parent then pcall(function() d.Enabled = v end) end end
            table.clear(savedVol); table.clear(savedTrans); table.clear(savedEnabled)
            frameN = 0
        end
    end))
end

------------------------------------------------------------------------
-- KEYBINDS. A bind is plain text: "K", "Ctrl+U", "Ctrl+Shift+F5", "MB3" (middle click) or
-- "MB4" / "MB5" (the mouse SIDE buttons). Modifiers must match exactly, so Ctrl+U does not
-- fire on a plain U. Any toggle can register one with KB.add(getBind, onFire) and get a
-- rebind box in the menu with KB.makeRow(order, label, settingsKey).
-- NOTE: Roblox itself never reports the side buttons, so they are read through the
-- executor's own iskeypressed (virtual-key 0x05 / 0x06) when it has that function.
------------------------------------------------------------------------
local KB = { list = {}, capturing = false, side = { { vk = 0x05, name = "MB4" }, { vk = 0x06, name = "MB5" } } }
function KB.mods()
    local U = UserInputService
    return U:IsKeyDown(Enum.KeyCode.LeftControl) or U:IsKeyDown(Enum.KeyCode.RightControl),
        U:IsKeyDown(Enum.KeyCode.LeftShift) or U:IsKeyDown(Enum.KeyCode.RightShift),
        U:IsKeyDown(Enum.KeyCode.LeftAlt) or U:IsKeyDown(Enum.KeyCode.RightAlt)
end
function KB.prefix()
    local c, s, a = KB.mods()
    return (c and "Ctrl+" or "") .. (s and "Shift+" or "") .. (a and "Alt+" or "")
end
function KB.parse(spec)
    local ctrl, shift, alt, key = false, false, false, nil
    for part in tostring(spec):gmatch("[^+]+") do
        local low = part:lower()
        if low == "ctrl" then ctrl = true elseif low == "shift" then shift = true
        elseif low == "alt" then alt = true else key = part end
    end
    return ctrl, shift, alt, key
end
function KB.match(spec, keyName)
    local c, s, a, key = KB.parse(spec)
    if not key or key ~= keyName then return false end
    local mc, ms, ma = KB.mods()
    return c == mc and s == ms and a == ma
end
function KB.fire(keyName)
    if KB.capturing then return end
    for _, b in ipairs(KB.list) do
        local spec = b.key()
        if spec and spec ~= "None" and KB.match(spec, keyName) then pcall(b.fire) end
    end
end
function KB.add(getBind, onFire) KB.list[#KB.list + 1] = { key = getBind, fire = onFire } end
function KB.sideDown(vk)
    if type(iskeypressed) ~= "function" then return false end
    local ok, v = pcall(iskeypressed, vk)
    return ok and v == true
end
track(UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType == Enum.UserInputType.Keyboard then KB.fire(input.KeyCode.Name)
    elseif input.UserInputType == Enum.UserInputType.MouseButton3 then KB.fire("MB3") end
end))
do
    local was = {}
    track(RunService.Heartbeat:Connect(function()
        for _, s in ipairs(KB.side) do
            local down = KB.sideDown(s.vk)
            if down and not was[s.name] then KB.fire(s.name) end
            was[s.name] = down
        end
    end))
end
-- Anti-kick's toggle key
KB.add(function() return settings.antiKickKey end, function() setAntiKick(not settings.antiKick) end)

------------------------------------------------------------------------
-- Visuals (ESP) - purely a drawing on YOUR screen; nothing is sent to the server and
-- nobody else can see it. Per opponent (same enemy/team rule as the hitbox expander):
--   * an outline + soft fill that shows through walls (red; yellow when under 30% health)
--   * name + distance, a health bar, and a status line: STUNNED / BLOCKING / PARRYING /
--     ATTACKING / KICKING / DASHING (read from the animations you can see them playing)
--   * ESTIMATED cooldowns: their real cooldowns live on THEIR game, so we start a timer when
--     we see them parry (1.5s) or kick (2s) - the game's own cooldown lengths.
------------------------------------------------------------------------
local espClear
do
    local ESP_BLOCK = {}
    for _, id in ipairs({ 6317097513, 6669641262, 6753361279, 6860759883, 10443668308, 109369432331476 }) do
        ESP_BLOCK[tostring(id)] = true
    end
    local ESP_PARRY = {}
    for _, id in ipairs({ 6322860474, 6669642689, 101135636991956, 6753364277 }) do
        ESP_PARRY[tostring(id)] = true
    end
    local PARRY_CD, KICK_CD = 1.5, 2.0

    local objs = {}                                         -- [character] = ui pieces
    local seenTrack = setmetatable({}, { __mode = "k" })    -- animation tracks we already timed
    local parryAt, kickAt = {}, {}                          -- [player] = when we saw it start

    local function removeOne(char)
        local o = objs[char]
        if not o then return end
        pcall(function() o.hl:Destroy() end)
        pcall(function() o.gui:Destroy() end)
        objs[char] = nil
    end
    espClear = function() for char in pairs(objs) do removeOne(char) end end

    local function label(parent, y, h, size, bold)
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, 0, 0, h)
        l.Position = UDim2.fromOffset(0, y)
        l.BackgroundTransparency = 1
        l.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
        l.TextSize = size
        l.TextColor3 = Color3.new(1, 1, 1)
        l.TextStrokeTransparency = 0.35
        l.Text = ""
        l.Parent = parent
        return l
    end

    local function build(char)
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        local hl = Instance.new("Highlight")
        hl.Name = "ForceHBE_ESP"
        hl.Adornee = char
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop   -- through walls
        hl.FillColor = Color3.fromRGB(255, 40, 40)
        hl.FillTransparency = 0.82
        hl.OutlineColor = Color3.fromRGB(255, 40, 40)
        hl.OutlineTransparency = 0
        hl.Parent = char

        local gui = Instance.new("BillboardGui")
        gui.Name = "ForceHBE_ESPGui"
        gui.Adornee = char:FindFirstChild("Head") or hrp
        gui.AlwaysOnTop = true
        gui.Size = UDim2.fromOffset(150, 58)
        gui.StudsOffset = Vector3.new(0, 2.8, 0)
        gui.MaxDistance = 600
        gui.Parent = char

        local o = { hl = hl, gui = gui }
        o.name = label(gui, 0, 14, 12, true)
        local bg = Instance.new("Frame")
        bg.Size = UDim2.new(0.8, 0, 0, 6)
        bg.Position = UDim2.new(0.1, 0, 0, 16)
        bg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        bg.BackgroundTransparency = 0.25
        bg.BorderSizePixel = 0
        bg.Parent = gui
        o.bg = bg
        local fill = Instance.new("Frame")
        fill.Size = UDim2.fromScale(1, 1)
        fill.BackgroundColor3 = Color3.fromRGB(60, 220, 90)
        fill.BorderSizePixel = 0
        fill.Parent = bg
        o.fill = fill
        o.status = label(gui, 25, 14, 11, true)
        o.cd = label(gui, 39, 13, 10, false)
        o.cd.TextColor3 = Color3.fromRGB(255, 210, 90)
        objs[char] = o
        return o
    end

    local acc = 0
    track(RunService.Heartbeat:Connect(function(dt)
        acc = acc + dt
        if acc < 0.08 then return end
        acc = 0
        if not settings.esp then
            if next(objs) then espClear() end
            return
        end
        local me = LocalPlayer.Character
        local myHrp = me and me:FindFirstChild("HumanoidRootPart")
        local seen = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if plr ~= LocalPlayer and hrp and hum and hum.Health > 0 and isEnemy(plr) then
                seen[char] = true
                local o = objs[char] or build(char)
                if o then
                    local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                    -- outline: red, yellow when they're low (easy to spot who to finish)
                    local low = frac < 0.3
                    o.hl.Enabled = settings.espOutline
                    local c = low and Color3.fromRGB(255, 225, 60) or Color3.fromRGB(255, 40, 40)
                    o.hl.OutlineColor, o.hl.FillColor = c, c
                    o.gui.Enabled = settings.espInfo
                    if settings.espInfo then
                        local dist = myHrp and (hrp.Position - myHrp.Position).Magnitude or 0
                        o.name.Text = ("%s  %dm"):format(plr.DisplayName ~= "" and plr.DisplayName or plr.Name, math.floor(dist))
                        o.fill.Size = UDim2.fromScale(frac, 1)
                        o.fill.BackgroundColor3 = Color3.fromHSV(frac * 0.33, 0.85, 0.95) -- green -> red
                        -- what are they doing right now?
                        local status, parrying, blocking = "", false, false
                        local ok, tracks = pcall(function()
                            return hum:FindFirstChildOfClass("Animator"):GetPlayingAnimationTracks()
                        end)
                        if ok and type(tracks) == "table" then
                            for _, trk in ipairs(tracks) do
                                local okId, id = pcall(function() return string.match(trk.Animation.AnimationId, "%d+") end)
                                if okId and id then
                                    if ESP_PARRY[id] then
                                        parrying = true
                                        if not seenTrack[trk] then seenTrack[trk] = true; parryAt[plr] = os.clock() end
                                    elseif ESP_BLOCK[id] then
                                        blocking = true
                                    elseif id == KICK_ID then
                                        if not seenTrack[trk] then seenTrack[trk] = true; kickAt[plr] = os.clock() end
                                    end
                                end
                            end
                        end
                        local stunTrk = findStunTrack(char)
                        local atkTrk, isKick, _, isDash = findAttackTrack(char)
                        if stunTrk then status = "STUNNED"
                        elseif isKick then status = "KICKING"
                        elseif atkTrk and not isDash then status = "ATTACKING"
                        elseif parrying then status = "PARRYING"
                        elseif blocking then status = "BLOCKING" end
                        o.status.Text = status
                        o.status.TextColor3 = (status == "STUNNED") and Color3.fromRGB(120, 220, 255)
                            or (status == "BLOCKING" or status == "PARRYING") and Color3.fromRGB(150, 170, 255)
                            or Color3.fromRGB(255, 120, 120)
                        -- estimated cooldowns
                        local parts = {}
                        local pl = parryAt[plr] and (PARRY_CD - (os.clock() - parryAt[plr]))
                        if pl and pl > 0 then parts[#parts + 1] = ("Parry %.1fs"):format(pl) end
                        local kl = kickAt[plr] and (KICK_CD - (os.clock() - kickAt[plr]))
                        if kl and kl > 0 then parts[#parts + 1] = ("Kick %.1fs"):format(kl) end
                        o.cd.Text = (#parts > 0) and ("CD (est): " .. table.concat(parts, "  ")) or ""
                    end
                end
            end
        end
        for char in pairs(objs) do
            if not seen[char] or not char.Parent then removeOne(char) end
        end
    end))
end
