-- Visuals (ESP) - purely a drawing on YOUR screen; nothing is sent to the server and
-- nobody else can see it. Per opponent (same enemy/team rule as the hitbox expander):
--   * an outline + soft fill that shows through walls (red; yellow when under 30% health)
--   * name + distance, a health bar, and a status line: STUNNED / BLOCKING / PARRYING /
--     ATTACKING / KICKING / DASHING (read from the animations you can see them playing)
--   * ESTIMATED cooldowns: their real cooldowns live on THEIR game, so we start a timer when
--     we see them parry (1.5s) or kick (2s) - the game's own cooldown lengths.
------------------------------------------------------------------------
local espClear
do
    local ESP_BLOCK = {}
    for _, id in ipairs({ 6317097513, 6669641262, 6753361279, 6860759883, 10443668308, 109369432331476 }) do
        ESP_BLOCK[tostring(id)] = true
    end
    local ESP_PARRY = {}
    for _, id in ipairs({ 6322860474, 6669642689, 101135636991956, 6753364277 }) do
        ESP_PARRY[tostring(id)] = true
    end
    local PARRY_CD, KICK_CD = 1.5, 2.0

    local objs = {}                                         -- [character] = ui pieces
    local seenTrack = setmetatable({}, { __mode = "k" })    -- animation tracks we already timed
    local parryAt, kickAt = {}, {}                          -- [player] = when we saw it start
    local parryVerdict = {}                                 -- [player] = { at = parryAt, v = "hit"/"wasted" }

    local function removeOne(char)
        local o = objs[char]
        if not o then return end
        pcall(function() o.hl:Destroy() end)
        pcall(function() o.gui:Destroy() end)
        objs[char] = nil
    end
    espClear = function() for char in pairs(objs) do removeOne(char) end end

    local function label(parent, y, h, size, bold)
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, 0, 0, h)
        l.Position = UDim2.fromOffset(0, y)
        l.BackgroundTransparency = 1
        l.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
        l.TextSize = size
        l.TextColor3 = Color3.new(1, 1, 1)
        l.TextStrokeTransparency = 0.35
        l.Text = ""
        l.Parent = parent
        return l
    end

    local function build(char)
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        local hl = Instance.new("Highlight")
        hl.Name = "ForceHBE_ESP"
        hl.Adornee = char
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop   -- through walls
        hl.FillColor = Color3.fromRGB(255, 40, 40)
        hl.FillTransparency = 0.82
        hl.OutlineColor = Color3.fromRGB(255, 40, 40)
        hl.OutlineTransparency = 0
        hl.Parent = char

        local gui = Instance.new("BillboardGui")
        gui.Name = "ForceHBE_ESPGui"
        gui.Adornee = char:FindFirstChild("Head") or hrp
        gui.AlwaysOnTop = true
        gui.Size = UDim2.fromOffset(150, 72)
        gui.StudsOffset = Vector3.new(0, 2.8, 0)
        gui.MaxDistance = 600
        gui.Parent = char

        local o = { hl = hl, gui = gui }
        o.name = label(gui, 0, 14, 12, true)
        local bg = Instance.new("Frame")
        bg.Size = UDim2.new(0.86, 0, 0, 11)
        bg.Position = UDim2.new(0.07, 0, 0, 16)
        bg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        bg.BackgroundTransparency = 0.25
        bg.BorderSizePixel = 0
        bg.Parent = gui
        o.bg = bg
        local fill = Instance.new("Frame")
        fill.Size = UDim2.fromScale(1, 1)
        fill.BackgroundColor3 = Color3.fromRGB(60, 220, 90)
        fill.BorderSizePixel = 0
        fill.Parent = bg
        o.fill = fill
        -- health PERCENTAGE written on the bar
        local pct = Instance.new("TextLabel")
        pct.Size = UDim2.fromScale(1, 1)
        pct.BackgroundTransparency = 1
        pct.Font = Enum.Font.GothamBold
        pct.TextSize = 9
        pct.TextColor3 = Color3.new(1, 1, 1)
        pct.TextStrokeTransparency = 0.3
        pct.Text = ""
        pct.ZIndex = 3
        pct.Parent = bg
        o.pct = pct
        o.status = label(gui, 30, 14, 11, true)
        o.cd = label(gui, 44, 13, 10, true)    -- stun timer / kick cooldown
        o.cd.TextColor3 = Color3.fromRGB(120, 220, 255)
        o.cd2 = label(gui, 57, 13, 10, true)   -- parry result + parry cooldown
        o.cd2.TextColor3 = Color3.fromRGB(255, 210, 90)
        objs[char] = o
        return o
    end

    local acc = 0
    track(RunService.Heartbeat:Connect(function(dt)
        acc = acc + dt
        if acc < 0.08 then return end
        acc = 0
        if not settings.esp then
            if next(objs) then espClear() end
            return
        end
        local me = LocalPlayer.Character
        local myHrp = me and me:FindFirstChild("HumanoidRootPart")
        local seen = {}

        -- 1) everyone who should be drawn, nearest first
        local list = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if plr ~= LocalPlayer and hrp and hum and hum.Health > 0
                and (not settings.espTeamCheck or not sameTeam(plr)) and not inWhitelist("esp", plr) then
                list[#list + 1] = { plr = plr, char = char, hrp = hrp, hum = hum,
                    d = myHrp and (hrp.Position - myHrp.Position).Magnitude or 0 }
            end
        end
        table.sort(list, function(a, b) return a.d < b.d end)

        -- 2) draw each one. Three things that used to break the ESP for players who just joined
        --    or just respawned are handled here:
        --    * the game / a respawn can destroy or re-parent the outline + bar we attached to a
        --      character -> every tick we check they're still attached and rebuild if not
        --    * the bar's anchor (the head) is replaced while a character loads -> re-pointed every tick
        --    * Roblox only draws ~31 outlines at once, so in a full server the LAST players in the
        --      list lost theirs -> only the 25 NEAREST get an outline (everyone keeps the info bar)
        --    * one player's error can't stop the loop for the players after them any more (pcall)
        for rank, e in ipairs(list) do
            local plr, char, hrp, hum = e.plr, e.char, e.hrp, e.hum
            seen[char] = true
            pcall(function()
                local o = objs[char]
                if o and (not o.hl.Parent or not o.gui.Parent or o.hl.Parent ~= char or o.gui.Parent ~= char) then
                    removeOne(char)
                    o = nil
                end
                o = o or build(char)
                if o then
                    o.hl.Adornee = char
                    o.gui.Adornee = char:FindFirstChild("Head") or hrp
                    local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                    -- outline: red, yellow when they're low (easy to spot who to finish)
                    local low = frac < 0.3
                    o.hl.Enabled = settings.espOutline and rank <= 25
                    local c = low and Color3.fromRGB(255, 225, 60) or Color3.fromRGB(255, 40, 40)
                    o.hl.OutlineColor, o.hl.FillColor = c, c
                    o.gui.Enabled = settings.espInfo
                    if settings.espInfo then
                        local dist = myHrp and (hrp.Position - myHrp.Position).Magnitude or 0
                        o.name.Text = ("%s  %dm"):format(plr.DisplayName ~= "" and plr.DisplayName or plr.Name, math.floor(dist))
                        o.fill.Size = UDim2.fromScale(frac, 1)
                        o.fill.BackgroundColor3 = Color3.fromHSV(frac * 0.33, 0.85, 0.95) -- green -> red
                        o.pct.Text = ("%d%%"):format(math.floor(frac * 100 + 0.5))
                        -- what are they doing right now?
                        local status, parrying, blocking = "", false, false
                        local ok, tracks = pcall(function()
                            return hum:FindFirstChildOfClass("Animator"):GetPlayingAnimationTracks()
                        end)
                        if ok and type(tracks) == "table" then
                            for _, trk in ipairs(tracks) do
                                local okId, id = pcall(function() return string.match(trk.Animation.AnimationId, "%d+") end)
                                if okId and id then
                                    if ESP_PARRY[id] then
                                        parrying = true
                                        if not seenTrack[trk] then seenTrack[trk] = true; parryAt[plr] = os.clock() end
                                    elseif ESP_BLOCK[id] then
                                        blocking = true
                                    elseif id == KICK_ID then
                                        if not seenTrack[trk] then seenTrack[trk] = true; kickAt[plr] = os.clock() end
                                    end
                                end
                            end
                        end
                        local stunTrk = findStunTrack(char)
                        local atkTrk, isKick, _, isDash = findAttackTrack(char)
                        if stunTrk then status = "STUNNED"
                        elseif isKick then status = "KICKING"
                        elseif atkTrk and not isDash then status = "ATTACKING"
                        elseif parrying then status = "PARRYING"
                        elseif blocking then status = "BLOCKING" end
                        o.status.Text = status
                        o.status.TextColor3 = (status == "STUNNED") and Color3.fromRGB(120, 220, 255)
                            or (status == "BLOCKING" or status == "PARRYING") and Color3.fromRGB(150, 170, 255)
                            or Color3.fromRGB(255, 120, 120)
                        -- STUN TIMER. A stunned player's stun animation is played so that its length equals the
                        -- stun length (Stunned state: speed = animation length / stun time), so what's left of
                        -- the animation IS the time left in the stun.
                        local line1 = {}
                        if stunTrk then
                            local okS, rem = pcall(function()
                                return (stunTrk.Length - stunTrk.TimePosition) / math.max(stunTrk.Speed, 0.05)
                            end)
                            if okS and rem and rem > 0 then
                                line1[#line1 + 1] = ("STUN %.1fs"):format(math.min(rem, 3))
                            end
                        end
                        -- kick cooldown (estimated from when we saw the kick start)
                        local kl = kickAt[plr] and (KICK_CD - (os.clock() - kickAt[plr]))
                        if kl and kl > 0 then line1[#line1 + 1] = ("Kick CD %.1fs"):format(kl) end
                        o.cd.Text = table.concat(line1, "  ")

                        -- PARRY: did it hit anything, or was it WASTED?  A parry that works stuns whoever it
                        -- caught, so within ~0.9s of their parry we look for someone near them in a stun
                        -- (that includes you, if you're the one who got parried). Nobody stunned = wasted.
                        local line2 = ""
                        local pa = parryAt[plr]
                        if pa then
                            local el = os.clock() - pa
                            local verdict = parryVerdict[plr]
                            if not verdict or verdict.at ~= pa then
                                verdict = { at = pa, v = nil }
                                parryVerdict[plr] = verdict
                            end
                            if not verdict.v then
                                local caught = false
                                if combatStateNow() == "stunned" and myHrp and (myHrp.Position - hrp.Position).Magnitude <= 25 then
                                    caught = true
                                end
                                if not caught then
                                    for _, other in ipairs(Players:GetPlayers()) do
                                        local oc = other ~= plr and other ~= LocalPlayer and other.Character
                                        local oh = oc and oc:FindFirstChild("HumanoidRootPart")
                                        if oh and (oh.Position - hrp.Position).Magnitude <= 25 and findStunTrack(oc) then
                                            caught = true
                                            break
                                        end
                                    end
                                end
                                if caught then verdict.v = "hit" elseif el >= 0.9 then verdict.v = "wasted" end
                            end
                            local left = PARRY_CD - el
                            if left > 0 then
                                local word = (verdict.v == "wasted") and "Parry WASTED" or (verdict.v == "hit") and "Parry hit" or "Parry..."
                                line2 = ("%s - CD %.1fs"):format(word, left)
                                o.cd2.TextColor3 = (verdict.v == "wasted") and Color3.fromRGB(255, 190, 60) or Color3.fromRGB(160, 200, 255)
                            end
                        end
                        o.cd2.Text = line2
                    end
                end
            end)
        end
        for char in pairs(objs) do
            if not seen[char] or not char.Parent then removeOne(char) end
        end
    end))
end
