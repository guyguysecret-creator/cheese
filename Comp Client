-- CAMERA SAFETY (v78). Only the Parry chase lock-on ever takes the camera over now. Handing it back
-- ALWAYS gives you the normal game camera (Custom, following your own character) - never a "saved"
-- type that could itself be a stuck Scriptable camera. And a watchdog: if the script was the last to
-- take the camera and nothing of ours is using it any more, it is handed back within a quarter second.
------------------------------------------------------------------------
AP.camOwners = {}
AP.camTouchedAt = -math.huge
function AP.releaseCam(owner, want)
    AP.camOwners[owner] = nil
    if next(AP.camOwners) then return end -- someone else of ours still has it
    pcall(function() RunService:UnbindFromRenderStep("ForceHBE_ChaseCam") end)
    pcall(function() RunService:UnbindFromRenderStep("ForceHBE_EaseCam") end)
    pcall(function()
        local cam = workspace.CurrentCamera
        if not cam then return end
        if cam.CameraType == Enum.CameraType.Scriptable then
            cam.CameraType = (want and want ~= Enum.CameraType.Scriptable) and want or Enum.CameraType.Custom
        end
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum and cam.CameraSubject ~= hum then cam.CameraSubject = hum end
    end)
end
do
    local acc = 0
    track(RunService.Heartbeat:Connect(function(dt)
        acc = acc + dt
        if acc < 0.25 then return end
        acc = 0
        if next(AP.camOwners) then return end
        if os.clock() - AP.camTouchedAt > 30 then return end -- not ours (game menus etc. are left alone)
        local cam = workspace.CurrentCamera
        if cam and cam.CameraType == Enum.CameraType.Scriptable then
            AP.releaseCam("watchdog")
            log("camera was left stuck - handed back to you")
        end
    end))
end

-- SMOOTH CAMERA (v88). Every time the script turns your view it now EASES round (no snapping), turning
-- the short way, and it keeps the view LEVEL: the up/down angle is held between a little above the
-- horizon and a comfortable look-down, so you never end up staring at the floor or up from under it.
-- It only rotates the normal game camera around your character at your own zoom - never takes it over.
AP.CAM_PITCH_MIN, AP.CAM_PITCH_MAX = math.rad(-30), math.rad(5)
function AP.camStep(cam, flatDir, dt, speed)
    if not cam or cam.CameraType ~= Enum.CameraType.Custom then return 0 end
    if not flatDir or flatDir.Magnitude < 0.01 then return 0 end
    local focus = cam.Focus.Position
    local cf = cam.CFrame
    local dist = (cf.Position - focus).Magnitude
    local look = cf.LookVector
    local pitch = math.asin(math.clamp(look.Y, -1, 1))
    local fromYaw = math.atan2(look.X, look.Z)
    if Vector3.new(look.X, 0, look.Z).Magnitude < 0.01 then fromYaw = math.atan2(flatDir.X, flatDir.Z) end
    local toYaw = math.atan2(flatDir.X, flatDir.Z)
    local d = (toYaw - fromYaw + math.pi) % (2 * math.pi) - math.pi -- shortest way round
    local a = 1 - math.exp(-speed * math.min(dt, 0.1))           -- same feel at any FPS
    local yaw = fromYaw + d * a
    local p = pitch + (math.clamp(pitch, AP.CAM_PITCH_MIN, AP.CAM_PITCH_MAX) - pitch) * a
    local newLook = Vector3.new(math.sin(yaw) * math.cos(p), math.sin(p), math.cos(yaw) * math.cos(p))
    if dist < 0.6 then
        cam.CFrame = CFrame.lookAt(cf.Position, cf.Position + newLook)   -- first person: turn on the spot
    else
        cam.CFrame = CFrame.lookAt(focus - newLook * dist, focus)
    end
    return math.abs(d)
end
-- CAMERA FOLLOWS YOUR FACING (v89): whenever the script turns your character (chase, evade, anti-kick,
-- perfect trade) the camera smoothly swings round to look the way your character is facing, kept level.
AP.camFollowUntil = 0
function AP.followFacing(sec)
    AP.camFollowUntil = math.max(AP.camFollowUntil, os.clock() + (sec or 0.6))
end
pcall(function() RunService:UnbindFromRenderStep("ForceHBE_FollowCam") end)
-- (v91) CAMERA LOCK-ON: while the script fights someone (auto parry from behind, parry chase, perfect
-- trade) the camera is TAKEN OVER and snapped onto them every frame, level, and your character is turned
-- with it. With shift lock the game turns your character to the CAMERA, so if the camera still pointed
-- away the dash / multi went out backwards - now camera and character both face the opponent first.
AP.lockPlr, AP.lockUntil = nil, 0
function AP.lockOn(plr, sec)
    if not plr then return end
    local keep = (AP.lockPlr == plr) and AP.lockUntil or 0
    AP.lockPlr = plr
    AP.lockUntil = math.max(keep, os.clock() + (sec or 0.6))
end
function AP.lockTargetDir()
    if not AP.lockPlr or os.clock() > AP.lockUntil then return nil end
    local mh = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local tc = AP.lockPlr.Character
    local th = tc and tc:FindFirstChild("HumanoidRootPart")
    local th2 = tc and tc:FindFirstChildOfClass("Humanoid")
    if not mh or not th or (th2 and th2.Health <= 0) then return nil end
    local to = Vector3.new(th.Position.X - mh.Position.X, 0, th.Position.Z - mh.Position.Z)
    if to.Magnitude < 0.3 then return nil end
    return to.Unit, mh
end
-- wait (a few frames at most) until you are really facing them, so the attack goes out forward
function AP.waitFacing(plr, maxT)
    local t0 = os.clock()
    while os.clock() - t0 < (maxT or 0.2) do
        local mh = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local th = plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
        if not mh or not th then return end
        local to = Vector3.new(th.Position.X - mh.Position.X, 0, th.Position.Z - mh.Position.Z)
        local lf = Vector3.new(mh.CFrame.LookVector.X, 0, mh.CFrame.LookVector.Z)
        local cam = workspace.CurrentCamera
        local cl = cam and Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z) or lf
        if to.Magnitude < 0.3 or (lf.Magnitude > 0.1 and cl.Magnitude > 0.1
            and lf.Unit:Dot(to.Unit) > 0.9 and cl.Unit:Dot(to.Unit) > 0.85) then return end
        RunService.RenderStepped:Wait()
    end
end
pcall(function()
    RunService:BindToRenderStep("ForceHBE_FollowCam", Enum.RenderPriority.Camera.Value + 1, function(dt)
        -- (v96) direction lock (Stun evade): camera + character snapped to face the way you escape
        if AP.lockDirVec and os.clock() < (AP.lockDirUntil or 0) then
            local mh = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local v = Vector3.new(AP.lockDirVec.X, 0, AP.lockDirVec.Z)
            if mh and v.Magnitude > 0.05 then
                v = v.Unit
                AP.camStep(workspace.CurrentCamera, v, dt, 1e6)
                pcall(function() mh.CFrame = CFrame.lookAt(mh.Position, mh.Position + v) end)
                return
            end
        end
        local lockDir, lockHrp = AP.lockTargetDir()
        if lockDir then
            AP.camStep(workspace.CurrentCamera, lockDir, dt, 1e6) -- instant: camera snapped onto them
            pcall(function() lockHrp.CFrame = CFrame.lookAt(lockHrp.Position, lockHrp.Position + lockDir) end)
            return
        end
        if os.clock() > AP.camFollowUntil then return end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local lv = hrp.CFrame.LookVector
        local flat = Vector3.new(lv.X, 0, lv.Z)
        if flat.Magnitude < 0.05 then return end
        AP.camStep(workspace.CurrentCamera, flat.Unit, dt, 7)
    end)
end)
-- ease the view round to face a direction over a short moment, then let go
function AP.easeCamTo(dir, dur)
    local cam = workspace.CurrentCamera
    if not cam then return end
    local flat = Vector3.new(dir.X, 0, dir.Z)
    if flat.Magnitude < 0.01 then return end
    flat = flat.Unit
    local t0 = os.clock()
    pcall(function() RunService:UnbindFromRenderStep("ForceHBE_EaseCam") end)
    pcall(function()
        RunService:BindToRenderStep("ForceHBE_EaseCam", Enum.RenderPriority.Camera.Value + 1, function(dt)
            local left = AP.camStep(cam, flat, dt, 9)
            if os.clock() - t0 > (dur or 0.45) or left < math.rad(1.5) then
                pcall(function() RunService:UnbindFromRenderStep("ForceHBE_EaseCam") end)
            end
        end)
    end)
end

local chaseBusy = false
local function startChase(plr) -- returns true if a chase started
    if chaseBusy then return false end
    chaseBusy = true
    task.spawn(function()
      -- The whole chase runs inside pcall. Before, any error in the middle (e.g. the saber component
      -- being swapped out mid-chase) killed the chase with "chaseBusy" still ON - and from then on
      -- every later chase was silently skipped. Now an error always falls through to a full clean-up.
      local okChase, errChase = pcall(function()
        local haveKeys = type(keypress) == "function" and type(keyrelease) == "function"
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp then chaseBusy = false return end

        -- OPTION "Chase: unblock to start": with it ON the chase only begins once you have let go of block
        -- (wait a moment for you to release it; if you keep holding, no chase). OFF = start right away.
        if settings.chaseUnblock then
            local waitFrom = os.clock()
            while settings.parryChase and os.clock() - waitFrom < 1.0 do
                local cs0 = combatStateNow()
                local holding = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
                if not holding and cs0 ~= "blocking" and cs0 ~= "parrying" then break end
                RunService.Heartbeat:Wait()
            end
            if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) or combatStateNow() == "blocking" then
                chaseBusy = false
                return
            end
        end

        -- Steering: ONE move vector, applied after the game's own controls every frame. We never
        -- set the character's CFrame or touch the camera (the humanoid turns toward where it's
        -- moving by itself), so changing direction in the middle of a dash is just a new vector.
        -- (v90) face the person you parried FIRST (they may be behind you), so every dash / multi is forward
        AP.faceToward(plr, false)
        AP.lockOn(plr, 0.4)
        local moveDir = hrp.CFrame.LookVector
        pcall(function()
            RunService:BindToRenderStep("ForceHBE_ChaseMove", Enum.RenderPriority.Last.Value, function()
                if hum then hum:Move(moveDir, false) end
                AP.noBackKey()
                AP.lockOn(plr, 0.3) -- camera stays locked on them for the whole chase (lets go 0.3s after)
            end)
        end)
        AP.waitFacing(plr, 0.25) -- face them FIRST, then start attacking

        -- the dash reads "is W down?"; the multi is W + A + E
        if haveKeys then
            pcall(keypress, KEY_W)
            pcall(keypress, KEY_A)
        end

        local lastTPos, tVel = nil, Vector3.zero   -- target velocity, measured here (works with Auto Parry off)
        local lastTime = os.clock()

        -- CAMERA LOCK-ON (always on with Parry chase): while chasing, the camera swings round onto the
        -- person you stunned and stays on them - behind you, looking at them - eased in (not snapped) so it
        -- reads as a player tracking their opponent. It eases back afterwards instead of cutting.
        local lockPos
        local cam = workspace.CurrentCamera
        local prevCamType, camStartLook
        -- (v86) NO MORE CAMERA GLITCH. The lock-on used to switch the camera to Scriptable and fly it to its own
        -- spot 11 studs behind you; when the chase ended the game's camera took back over from ITS saved
        -- angle and zoom, so the view jumped/swung (worst without shift lock). Now the camera stays the
        -- normal game camera the whole time: right after the game places it each frame we only TURN it
        -- (around your character, at your own zoom and pitch) toward the person you're chasing. The game's
        -- camera carries on from wherever we turned it, so when the chase ends there is nothing to hand back.
        local function restoreCam()
            if not prevCamType then return end
            prevCamType = nil
            pcall(function() RunService:UnbindFromRenderStep("ForceHBE_ChaseCam") end)
            AP.camOwners.chase = nil
        end
        if settings.chaseCam and cam and cam.CameraType == Enum.CameraType.Custom then
            pcall(function()
                prevCamType = cam.CameraType
                pcall(function() RunService:UnbindFromRenderStep("ForceHBE_EaseCam") end)
                RunService:BindToRenderStep("ForceHBE_ChaseCam", Enum.RenderPriority.Camera.Value + 1, function(dt)
                    if not lockPos or cam.CameraType ~= Enum.CameraType.Custom then return end
                    -- (v89) camera looks where YOUR CHARACTER faces (it's turned onto them each frame)
                    AP.followFacing(0.3)
                end)
            end)
            -- safety net: whatever happens, the camera is handed back (a chase lasts 6s at most)
            task.delay(8, restoreCam)
        end
        local DASH_COST = 32 + 8
        local MELEE, ARRIVED = 7, 5     -- re-set every frame: tighter when the Hitbox Expander is OFF
        local mode = "approach"

        -- re-aim: where they ARE and where they're HEADING. Called ONCE per frame. Returns the flat
        -- distance to them (nil if they're gone).
        local function updateAim()
            local tc = plr.Character
            local th = tc and tc:FindFirstChild("HumanoidRootPart")
            local me = LocalPlayer.Character
            local mh = me and me:FindFirstChild("HumanoidRootPart")
            if not th or not mh then return nil end
            hrp = mh
            local now = os.clock()
            local dt = math.max(now - lastTime, 1 / 240)
            lastTime = now
            if lastTPos then tVel = tVel * 0.4 + ((th.Position - lastTPos) / dt) * 0.6 end
            lastTPos = th.Position
            lockPos = th.Position
            local dist = (Vector3.new(th.Position.X, 0, th.Position.Z) - Vector3.new(mh.Position.X, 0, mh.Position.Z)).Magnitude
            -- lead: our dash covers ~60 studs/s, so aim where they'll be by the time we get there
            local lead = math.min(dist / 60, 0.5)
            local aim = th.Position + tVel * lead
            local to = Vector3.new(aim.X - mh.Position.X, 0, aim.Z - mh.Position.Z)
            if to.Magnitude > 0.5 then
                local dir = to.Unit
                -- in the multi, slip ~35 degrees to the left (W + A) while swinging
                -- (only with the Hitbox Expander on: without it a swing taken 35 deg off-target misses)
                if mode == "multi" and dist <= 9 and settings.hbe then dir = CFrame.Angles(0, math.rad(35), 0):VectorToWorldSpace(dir) end
                moveDir = dir
            end
            return dist
        end

        -- WITHOUT the Hitbox Expander your swing only connects if you are CLOSE and FACING them (the
        -- expander makes their hit area ~12 studs wide, which forgives both). So with it off, the chase
        -- closes in tighter and snaps your character to face them for each swing / multi dash.
        local function faceTarget()
            -- (v90) always (HBE on too): every chase dash / multi goes out FACING them, forward
            if not lastTPos or not hrp then return end
            pcall(function()
                local pos = hrp.Position
                hrp.CFrame = CFrame.lookAt(pos, Vector3.new(lastTPos.X, pos.Y, lastTPos.Z))
                AP.followFacing(0.4)
            end)
        end
        local function cancelListener()
            pcall(function() rawget(saberComp, "_janitor"):Remove("DashCancelInputBegan") end)
        end
        local function sendAttack()
            pcall(function()
                saberComp:ProcessInput(true, { name = "ATTACK", inputState = Enum.UserInputState.Begin })
            end)
        end

        -- JUMP CHASE (optional, "Jump chase" switch) - the dash snipe, for when they evaded VERY far:
        --     left-click (swing)  ->  W + E (dash)  ->  Space (jump)
        --   Why it goes further: the game slows you to jumping speed when you jump from a standstill or
        --   a run, but NOT when you jump out of a dash - so you keep dash speed (60 studs/s) for the
        --   whole jump. Jumping late in the dash (SNIPE_JUMP_AFTER) adds the full air time on top of
        --   the dash itself: about 50 studs instead of 30. While airborne you can still steer, and a
        --   swing taken in the air after a dash is the game's quick dash-swing.
        local sniped = false
        local function doSnipe()
            sniped = true
            sendAttack()                                   -- 1) left-click: swing
            RunService.RenderStepped:Wait()
            updateAim()
            sendDashInput()                                -- 2) W (held) + E: dash
            RunService.RenderStepped:Wait()
            updateAim()
            if movementState() ~= "dashing" then return end -- the dash didn't start: carry on normally
            local ts = os.clock()
            while os.clock() - ts < AP.SNIPE_JUMP_AFTER and movementState() == "dashing" do
                cancelListener()
                updateAim()                                -- keep steering toward them the whole time
                RunService.RenderStepped:Wait()
            end
            pcall(function()                               -- 3) Space: jump out of the dash
                saberComp:ProcessInput(true, { name = "JUMP", inputState = Enum.UserInputState.Begin })
            end)
        end

        -- TWO PHASES (plus the optional jump snipe above)
        --   APPROACH (they're further than MELEE): a FULL-LENGTH dash toward where they are going.
        --     It is never cut short or interrupted - it runs its whole distance while the move vector
        --     is re-aimed every frame, so if they change direction your dash swings over to follow
        --     them. When it ends and they're still far, the next full dash starts as soon as the dash
        --     cooldown allows.
        --   MULTI (they're within MELEE, or the dash reached them): W + A + E, then swing -
        --     dash, and on the next frame cancel it into a swing, paced by "Multi delay". (Game
        --     numbers: dash cooldown 0.18s, swing debounce 0.15s, dash 32 force + 8 to cancel; a dash
        --     can only become a swing while the combat state is "ignited".)
        local dashFrames, cancelled = 0, false
        local nextMultiAt = 0 -- pacing: the multi never starts a new cycle before this time
        -- (v69) 3 HITS PER STUN: the pause between cycles is shrunk so that what's left of their stun fits
        -- 3 cycles in total. "Multi delay" can only make it slower when there is time to spare; it never
        -- pushes you below 3 hits. The game's own minimum (0.15s swing / 0.18s dash) is the floor.
        local hitsDone, WANT_HITS = 0, 3
        local function chaseGap(base, remLeft)
            hitsDone += 1
            local normal = multiGap(base)
            local left = WANT_HITS - hitsDone
            if left <= 0 then return normal end
            local budget = math.max(base, (remLeft - 0.12) / left)
            return math.min(normal, budget)
        end
        local t0 = os.clock()
        local stunOver = false
        local lastRaw = 0 -- (v97) stun time left as we SEE it (no ping taken off) when the loop stopped
        while os.clock() - t0 < 6 and settings.parryChase do
            local tc = plr.Character
            local thum = tc and tc:FindFirstChildOfClass("Humanoid")
            if not tc or not thum or thum.Health <= 0 then break end
            local stunTrk = findStunTrack(tc)
            if not stunTrk then stunOver = true break end      -- their stun ended: stop (no extra hit - see SMART LAST HIT)
            -- TIME LEFT IN THEIR STUN - the same number the ESP shows: their stun animation is played
            -- so that its length equals the stun length, so what's left of the animation is what's
            -- left of the stun. We see it one ping late (they're already further along), so ping is
            -- subtracted. A dash/swing already started would still land after the stun is over -
            -- that was the over-multi.
            local remEff = 9
            local okR, rem = pcall(function()
                return (stunTrk.Length - stunTrk.TimePosition) / math.max(stunTrk.Speed, 0.05)
            end)
            if okR and type(rem) == "number" then remEff = rem - pingEma; lastRaw = rem end
            if remEff <= 0.05 then stunOver = true break end   -- their stun is over (or about to be): stop
            -- a new dash needs ~0.35s to land, a cancel-into-swing ~0.15s: don't START what can't land
            -- (v97: a little more margin - the last hit used to land just as they could parry again)
            local canDash = remEff >= 0.35
            local canSwing = remEff >= 0.15
            local cs = combatStateNow()
            if cs == "stunned" then break end                  -- you got hit: stop
            MELEE, ARRIVED = (settings.hbe and 7 or 5), (settings.hbe and 5 or 3.5)

            local dist = updateAim()
            if not dist then break end

            local ms = movementState()
            local sc = saberComp
            local force = 0
            if saberStillValid(sc) then
                local okF, f = pcall(function() return rawget(rawget(sc, "CharacterComponent"), "Force") end)
                force = okF and f or 0
            end
            local ready = (cs == "ignited" or cs == "blocking")

            if ms == "dashing" then
                dashFrames += 1
                cancelListener() -- take out the listener that would cancel the dash on any key press
                local function cancelIntoSwing()
                    cancelled = true
                    faceTarget()
                    local h = saberStillValid(sc) and rawget(sc, "_dashCancelHandler")
                    if type(h) == "function" then
                        pcall(h, true)                          -- left-click during a dash = dash-cancel into a swing
                    else
                        sendAttack()
                    end
                end
                if mode == "multi" then
                    if not cancelled and dashFrames >= 2 and ready and canSwing then cancelIntoSwing() end
                elseif dist <= ARRIVED and not cancelled and dashFrames >= 2 and ready and canSwing then
                    -- this full dash has REACHED them: its last moment becomes the first swing
                    mode = "multi"
                    hitsDone += 1                               -- the arrival swing is hit #1
                    cancelIntoSwing()
                end
                -- otherwise: keep dashing - the whole length - just steering toward them
            else
                dashFrames, cancelled = 0, false
                local onCd = false
                if saberStillValid(sc) then
                    local okC, v = pcall(function() return rawget(sc, "Cooldowns"):OnCooldown("dash") end)
                    onCd = okC and v or false
                end
                if ms == "jumping" or ms == "free_falling" then
                    -- airborne after the jump snipe: steer (already done) and swing the moment you're on them
                    if dist <= MELEE + 2 and cs == "ignited" and canSwing and os.clock() >= nextMultiAt then
                        mode = "multi"
                        faceTarget()
                        sendAttack()
                        nextMultiAt = os.clock() + chaseGap(0.15, remEff)
                    end
                elseif dist > MELEE then
                    mode = "approach"
                    if settings.jumpChase and not sniped and dist > AP.SNIPE_MIN_DIST and remEff >= AP.SNIPE_MIN_STUN
                        and cs == "ignited" and not onCd and groundedMS(ms) and force >= DASH_COST then
                        doSnipe()                               -- very far: dash-snipe with a jump
                    elseif ready and not onCd and groundedMS(ms) and force >= 32 and canDash then
                        sendDashInput()                         -- a full dash toward them
                    end
                else
                    mode = "multi"
                    -- PACING: the game would allow a new cycle every ~0.18s, which looks like a machine.
                    -- "Multi delay" adds extra time between cycles (+-20% so it isn't a metronome).
                    -- (Multi delay at or below AP.MULTI_ULTRA ms = no pacing: ULTRA multi, every frame.)
                    if os.clock() >= nextMultiAt and canSwing then
                        if ready and not onCd and groundedMS(ms) and force >= DASH_COST and canDash then
                            faceTarget()
                            sendDashInput()                     -- E (W and A are held)
                            nextMultiAt = os.clock() + chaseGap(0.18, remEff)
                        elseif cs == "ignited" then
                            -- dash still cooling down (or no force): keep hitting with plain swings
                            faceTarget()
                            sendAttack()
                            nextMultiAt = os.clock() + chaseGap(0.15, remEff)
                        end
                    end
                end
            end
            RunService.RenderStepped:Wait()
        end

        -- (v97) SMART LAST HIT. The old "bonus multi" always threw one more full multi after their stun ended -
        -- and that's the hit that got parried. Now there's only a last hit when it can still land:
        --   * their stun animation is still playing on our screen with at least ~0.1s left, AND
        --   * they're right next to you (no dash needed), AND your saber can swing RIGHT NOW
        -- then it's ONE instant plain swing (the fastest hit there is, no dash, no waiting). If they're
        -- already out of the stun, too far, or you can't swing this frame: no extra hit.
        if stunOver and settings.parryChase then
            pcall(function()
                local tc = plr.Character
                if not tc or not findStunTrack(tc) then return end       -- already free: they'd parry it
                if lastRaw < 0.1 then return end                         -- not enough stun left to land it
                local dist = updateAim()
                if not dist or dist > MELEE + 1 then return end          -- would need a dash: too slow
                if combatStateNow() ~= "ignited" then return end         -- can't swing this instant
                faceTarget()
                sendAttack()
                local tE = os.clock()
                while os.clock() - tE < 0.08 do updateAim() RunService.RenderStepped:Wait() end
            end)
        end

        pcall(function() RunService:UnbindFromRenderStep("ForceHBE_ChaseMove") end)
        if haveKeys then
            pcall(keyrelease, KEY_W)
            pcall(keyrelease, KEY_A)
        end
        restoreCam()
        chaseBusy = false
        reblockIfHeld()
      end)
      if not okChase then
        warn("[ForceHBE] parry chase error (cleaned up, next chase will work): " .. tostring(errChase))
        pcall(function() RunService:UnbindFromRenderStep("ForceHBE_ChaseMove") end)
        pcall(function() RunService:UnbindFromRenderStep("ForceHBE_ChaseCam") end)
        if type(keyrelease) == "function" then
            pcall(keyrelease, KEY_W)
            pcall(keyrelease, KEY_A)
        end
        AP.releaseCam("chase")
        chaseBusy = false
        reblockIfHeld()
      end
    end)
    return true
end
-- watch for "I just parried and the attacker got stunned"
do
    -- the chase starts after a PARRY that stunned someone OR after YOUR KICK stunned someone
    local wasParrying, parryAt, kickAt = false, -math.huge, -math.huge
    local wasKicking, kickStartAt = false, -math.huge
    -- FRESHNESS (v68): every stun animation is stamped with the moment WE FIRST SEE IT. A stun is "fresh"
    -- when we first saw it after the parry / kick began. (v67 and earlier judged freshness by the stun
    -- animation's TimePosition < 0.6 - but the stun plays at roughly double speed and a laggy opponent's
    -- animation often reaches us already well past that, so most parries never triggered the chase.)
    local stunSeen = setmetatable({}, { __mode = "k" })
    -- (rules: a fresh stun after your parry on someone close who attacked recently and is facing you, or a
    -- fresh stun after your kick on someone close in front of you; "Chase only" picks WHO may be chased)
    track(RunService.Heartbeat:Connect(function()
        if not (settings.autoParry or settings.parryChase) then wasParrying = false return end
        local now = os.clock()
        local csNow = combatStateNow()
        local parrying = csNow == "parrying"
        if parrying and not wasParrying then parryAt = now end
        wasParrying = parrying
        local kicking = csNow == "kicking"
        if kicking and not wasKicking then kickStartAt = now end
        if kicking then kickAt = now end                         -- last moment my kick was running
        wasKicking = kicking
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        -- stamp every stun near me the first time it shows up (always - so an OLD stun can never look new)
        local stunned = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local tc = plr.Character
                local th = tc and tc:FindFirstChild("HumanoidRootPart")
                if th and (th.Position - hrp.Position).Magnitude <= 35 then
                    local trk = findStunTrack(tc)
                    if trk then
                        if not stunSeen[trk] then stunSeen[trk] = now end
                        stunned[#stunned + 1] = { plr = plr, th = th, trk = trk }
                    end
                end
            end
        end
        -- windows: a parry stays up ~0.7s and the stun has to travel attacker -> server -> you, so it can
        -- show up well over a second after the parry started
        local afterParry = now - parryAt <= 1.8
        local afterKick = now - kickAt <= 1.2
        if not (afterParry or afterKick) or #stunned == 0 then return end
        if not settings.parryChase then return end
        for _, s in ipairs(stunned) do
            local plr, th, trk = s.plr, s.th, s.trk
            -- "Chase only" list: when anyone is ticked, ONLY those players are ever chased
            local allow = settings.whitelist.chase
            local allowed = (next(allow) == nil) or allow[plr.UserId] == true
            -- "Chase team check": never your own team
            if settings.chaseTeamCheck and sameTeam(plr) then allowed = false end
            -- enough stun left to be worth it
            local okR, rem = pcall(function() return (trk.Length - trk.TimePosition) / math.max(trk.Speed, 0.05) end)
            local worth = not okR or type(rem) ~= "number" or rem - pingEma > 0.2
            if allowed and worth then
                local seen = stunSeen[trk] or now
                local la = lastAtk[plr]
                local wasAttacker = (la and now - la < 2.5) or not next(lastAtk) -- not just a bystander who got stunned
                -- close to you and facing you (they were swinging at YOU)
                local toMe = Vector3.new(hrp.Position.X - th.Position.X, 0, hrp.Position.Z - th.Position.Z)
                local fightingMe = false
                if toMe.Magnitude > 0.01 and toMe.Magnitude <= 16 then
                    local lf = Vector3.new(th.CFrame.LookVector.X, 0, th.CFrame.LookVector.Z)
                    fightingMe = toMe.Magnitude <= 7 or (lf.Magnitude > 0.01 and lf.Unit:Dot(toMe.Unit) >= 0.3)
                end
                -- AFTER MY KICK: the kicked player was not necessarily swinging at me (a kick breaks a
                -- block), so the "was attacking me" test is skipped - but they must be close and
                -- roughly in front of me
                local kickOK = false
                if afterKick and seen >= kickStartAt - 0.05 and toMe.Magnitude > 0.01 and toMe.Magnitude <= 14 then
                    local mf = Vector3.new(hrp.CFrame.LookVector.X, 0, hrp.CFrame.LookVector.Z)
                    kickOK = toMe.Magnitude <= 6 or (mf.Magnitude > 0.01 and mf.Unit:Dot(-toMe.Unit) >= 0.2)
                end
                local viaParry = afterParry and seen >= parryAt - 0.05 and wasAttacker and fightingMe
                if (viaParry or kickOK) and not chaseBusy then
                    if viaParry then cutParry() end
                    if startChase(plr) then
                        parryAt, kickAt = -math.huge, -math.huge  -- count it once (only once it really started)
                    end
                    break
                end
            end
        end
    end))
end

track(RunService.Heartbeat:Connect(function()
    if not settings.autoEvade then wasStunned = false return end
    local sc = saberComp
    if not saberStillValid(sc) then return end
    local okS, csm = pcall(function() return rawget(sc, "CombatStateMachine") end)
    if not okS or not csm then return end
    -- instant path: react the moment the state machine switches to "stunned"
    if csm ~= lastCSM then
        lastCSM = csm
        pcall(function()
            track(csm.StateChanged:Connect(function(state)
                if state == "stunned" and settings.autoEvade then doEvade() end
            end))
        end)
    end
    -- back-up path: per-frame check
    local okG, state = pcall(function() return csm:GetCurrentState() end)
    local stunned = okG and state == "stunned"
    if stunned and not wasStunned then doEvade() end
    wasStunned = stunned
end))

------------------------------------------------------------------------
-- Anti-kick = KICK COUNTER. (Replaces the old "ignore the stun" version.)
--   A kick breaks a block, so when someone is about to kick you:
--     1. UNBLOCK at once - nothing left for the kick to break - and
--     2. MULTI the kicker (W + A + E dash, cancel into a swing, over and over, paced by "Multi delay")
--        until their kick animation is over, then stop.
--   "About to kick you" is the same test Auto Parry uses for kicks (close enough / dashing in,
--   facing you, hit box about to switch on). While Anti-kick is on, Auto Parry leaves kicks to it.
--   You approach the kicker's SIDE, not the front, because a kick's hit box is a cube in front of them.
------------------------------------------------------------------------
do -- hooks from older versions of this script (which stay in the game until you rejoin) look up
   -- these entries; clearing them turns those old hooks into harmless pass-throughs
    local env = (getgenv and getgenv()) or _G
    env.ForceHBE_IsKickStun, env.ForceHBE_InKickWindow, env.ForceHBE_BadSound = nil, nil, nil
end
local antiKickStatus = "off"
local antiKickStatusSink -- set by the UI: shows antiKickStatus under the key row
local counterBusy = false
local countered = setmetatable({}, { __mode = "k" }) -- kick animations we already answered

local function startKickCounter(plr, kickTrk)
    if counterBusy then return end
    counterBusy = true
    countered[kickTrk] = true
    task.spawn(function()
        local haveKeys = type(keypress) == "function" and type(keyrelease) == "function"
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp then counterBusy = false return end
        antiKickStatus = "countering " .. plr.Name
        if antiKickStatusSink then antiKickStatusSink() end
        -- (so an unexpected unblock can always be traced: F9 says who triggered it)
        pcall(function()
            local kh = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            log(("Anti-kick: countering a kick from %s (%.0f studs away) - this lets go of block"):format(
                plr.Name, kh and (kh.Position - hrp.Position).Magnitude or -1))
        end)

        local function unblock()
            pcall(function()
                saberComp:ProcessInput(true, { name = "BLOCK", inputState = Enum.UserInputState.End })
            end)
        end
        -- 1) UNBLOCK - the very first thing, before anything else can go wrong
        if combatStateNow() == "blocking" then unblock() end

        -- (v85) FACE THE KICKER FIRST. The dash goes the way you move, but its animation and speed follow
        -- the way you FACE - so with your back to them the counter came out as a backwards dash. Now you
        -- are turned to face them on the very first frame (before any dash), and kept facing them every
        -- frame until the counter ends (after the game's own camera / shift lock, so it can't turn you back).
        local faceAt
        local moveDir = hrp.CFrame.LookVector
        pcall(function()
            local kh = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            if not kh then return end
            faceAt = kh.Position
            local pos = hrp.Position
            local flat = Vector3.new(faceAt.X - pos.X, 0, faceAt.Z - pos.Z)
            if flat.Magnitude > 0.5 then
                moveDir = flat.Unit
                hrp.CFrame = CFrame.lookAt(pos, pos + flat)
                AP.followFacing(0.6)
            end
        end)
        pcall(function()
            RunService:BindToRenderStep("ForceHBE_CounterMove", Enum.RenderPriority.Last.Value, function()
                if hum then hum:Move(moveDir, false) end
                -- the game checks S BEFORE W: S held (backing away) = backwards dash, so let go of it
                if haveKeys and UserInputService:IsKeyDown(Enum.KeyCode.S) then pcall(keyrelease, 0x53) end
                if faceAt and hrp and hrp.Parent then
                    local pos = hrp.Position
                    local flat = Vector3.new(faceAt.X - pos.X, 0, faceAt.Z - pos.Z)
                    if flat.Magnitude > 0.5 then hrp.CFrame = CFrame.lookAt(pos, pos + flat); AP.followFacing(0.4) end
                end
            end)
        end)
        if haveKeys then
            pcall(keypress, KEY_W)
            pcall(keypress, KEY_A)
        end

        -- Everything that can fail runs inside pcall, and the clean-up below ALWAYS runs. (Before, one
        -- error in the middle left "counterBusy" stuck on, which silently disabled Anti-kick for the
        -- rest of the session - a likely cause of "works sometimes".)
        local okRun, errRun = pcall(function()
            -- start from the kicker's already-tracked speed: a far dash-kicker is mid-run on frame one
            local lastTPos, tVel, lastTime = nil, (plrVelFast[plr] or Vector3.zero), os.clock()
            local DASH_COST, MELEE = 32 + 8, (settings.hbe and 7 or 5)
            local dashFrames, cancelled, nextMultiAt = 0, false, 0
            local dashAsked, dashAskAt = false, nil
            local function sendAttack()
                pcall(function()
                    saberComp:ProcessInput(true, { name = "ATTACK", inputState = Enum.UserInputState.Begin })
                end)
            end
            local function faceTarget()
                -- (v85) always (HBE on too): every dash / swing goes out facing them
                if not lastTPos or not hrp then return end
                pcall(function()
                    local pos = hrp.Position
                    local flat = Vector3.new(lastTPos.X - pos.X, 0, lastTPos.Z - pos.Z)
                    if flat.Magnitude > 0.5 then hrp.CFrame = CFrame.lookAt(pos, pos + flat); AP.followFacing(0.5) end
                end)
            end

            local t0 = os.clock()
            while os.clock() - t0 < 2.5 and settings.antiKick do
                local tc = plr.Character
                local th = tc and tc:FindFirstChild("HumanoidRootPart")
                local thum = tc and tc:FindFirstChildOfClass("Humanoid")
                local mh = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not th or not thum or thum.Health <= 0 or not mh then break end
                hrp = mh
                faceAt = th.Position -- keep facing them as they move

                -- STOP when their kick animation is over (we see it one ping late, so ping is subtracted)
                local okK, playing, rem = pcall(function()
                    return kickTrk.IsPlaying, (kickTrk.Length - kickTrk.TimePosition) / math.max(kickTrk.Speed, 0.05)
                end)
                if not okK or not playing then break end
                local remEff = (type(rem) == "number") and (rem - pingEma) or 9
                if remEff <= 0.05 then break end
                local canDash, canSwing = remEff >= 0.25, remEff >= 0.1
                local cs = combatStateNow()
                if cs == "stunned" then break end              -- the kick got you anyway: stop
                -- the game puts you straight back into block after a swing while the block button is
                -- still held - so keep letting go for as long as the counter runs
                if cs == "blocking" then unblock() end

                -- where they are / are heading
                local now = os.clock()
                local dt = math.max(now - lastTime, 1 / 240)
                lastTime = now
                if lastTPos then tVel = tVel * 0.4 + ((th.Position - lastTPos) / dt) * 0.6 end
                lastTPos = th.Position
                local dist = (Vector3.new(th.Position.X, 0, th.Position.Z) - Vector3.new(mh.Position.X, 0, mh.Position.Z)).Magnitude
                local lead = math.min(dist / 60, 0.4)
                -- (what you see of them is one ping old: a dash-sniper has already gone further than drawn)
                local center = th.Position + tVel * (lead + pingEma * 0.8)
                -- aim at their FLANK (the side I'm already on), not the cube in front of them
                local look = Vector3.new(th.CFrame.LookVector.X, 0, th.CFrame.LookVector.Z)
                look = look.Magnitude > 0.05 and look.Unit or Vector3.new(0, 0, -1)
                local right = Vector3.new(th.CFrame.RightVector.X, 0, th.CFrame.RightVector.Z)
                right = right.Magnitude > 0.05 and right.Unit or Vector3.new(1, 0, 0)
                local mySide = (right:Dot(Vector3.new(mh.Position.X - th.Position.X, 0, mh.Position.Z - th.Position.Z)) >= 0) and 1 or -1
                local aimPoint = (dist > 6) and (center + right * mySide * 4.5 - look * 1.5) or center
                local to = Vector3.new(aimPoint.X - mh.Position.X, 0, aimPoint.Z - mh.Position.Z)
                if to.Magnitude > 0.5 then moveDir = to.Unit end

                local ms = movementState()
                local sc = saberComp
                local force = 0
                if saberStillValid(sc) then
                    local okF, f = pcall(function() return rawget(rawget(sc, "CharacterComponent"), "Force") end)
                    force = okF and f or 0
                end
                -- a dash can start from "ignited" OR "blocking" (the dash itself cancels block); a swing needs "ignited"
                local dashReady = (cs == "ignited" or cs == "blocking")
                local swingReady = (cs == "ignited")

                if ms == "dashing" then
                    dashFrames += 1
                    if dashAsked and dashFrames == 1 then
                        -- a multi dash really started: NOW the pacing gap begins
                        dashAsked, dashAskAt = false, nil
                        nextMultiAt = os.clock() + AP.counterGap(0.18)
                    end
                    pcall(function() rawget(sc, "_janitor"):Remove("DashCancelInputBegan") end)
                    -- the dash runs its full length toward the flank; once on them, it becomes a swing
                    if not cancelled and dashFrames >= 2 and swingReady and dist <= MELEE + 3 and canSwing then
                        cancelled = true
                        faceTarget()
                        local h = rawget(sc, "_dashCancelHandler")
                        if type(h) == "function" then pcall(h, true) else sendAttack() end
                    end
                else
                    dashFrames, cancelled = 0, false
                    local onCd = false
                    if saberStillValid(sc) then
                        local okC, v = pcall(function() return rawget(sc, "Cooldowns"):OnCooldown("dash") end)
                        onCd = okC and v or false
                    end
                    if dist > MELEE then
                        if dashReady and not onCd and groundedMS(ms) and force >= 32 and canDash then
                            sendDashInput()                     -- close the gap with a full dash
                        end
                    elseif os.clock() >= nextMultiAt and canSwing then
                        -- RIGHT ON THEM (a plain kick next to you): MULTI until their kick animation is over -
                        -- W + A + E dash, cancelled into a swing on the next frames (the "dashing" branch above),
                        -- over and over, paced like the Parry chase but never slower than 0.2s (the kick
                        -- window is short). A plain swing is only used when a dash isn't possible right now
                        -- (dash cooldown / no Force).
                        -- (v72) WHY IT USED TO SWING: the game only allows a dash while W is really down, and
                        -- W is pressed the very frame the counter starts - so the first dash was refused,
                        -- the script then waited a whole multi gap, and by then the kick was nearly over ->
                        -- plain swings. Now a refused dash is simply asked for again on the next frame, the
                        -- gap only starts once the dash REALLY started, and a plain swing is used only
                        -- when you don't have the Force for a dash at all.
                        -- (safety: if the game keeps refusing the dash for 0.12s+, swing instead so the
                        -- kick is still answered)
                        local stuck = dashAsked and dashAskAt and os.clock() - dashAskAt > 0.12
                        if force >= DASH_COST and haveKeys and not stuck then
                            if dashReady and not onCd and groundedMS(ms) then
                                faceTarget()
                                sendDashInput()
                                if not dashAsked then dashAskAt = os.clock() end
                                dashAsked = true
                            end
                            nextMultiAt = os.clock()              -- retry next frame until the dash starts
                        elseif swingReady then
                            dashAsked, dashAskAt = false, nil
                            faceTarget()
                            sendAttack()
                            nextMultiAt = os.clock() + AP.counterGap(0.15)
                        end
                    end
                end
                RunService.RenderStepped:Wait()
            end
        end)
        if not okRun then warn("[ForceHBE] kick counter error: " .. tostring(errRun)) end

        -- ALWAYS clean up
        pcall(function() RunService:UnbindFromRenderStep("ForceHBE_CounterMove") end)
        if haveKeys then
            pcall(keyrelease, KEY_W)
            pcall(keyrelease, KEY_A)
        end
        counterBusy = false
        reblockIfHeld() -- still holding block? put it back so you are not left with the saber out
        antiKickStatus = settings.antiKick and "ready" or "off"
        if antiKickStatusSink then antiKickStatusSink() end
    end)
end

-- ONE place that decides "counter this kick?" - used by the per-frame watcher AND (instantly) by the
-- AnimationPlayed hook the moment a kick animation starts on anyone
local function tryCounterKick(plr)
    if not settings.antiKick or counterBusy then return end
    -- (v92) "Anti-kick only": anyone ticked = ONLY those players' kicks are countered (none ticked = all)
    local akl = settings.whitelist.antiKickOnly
    if akl and next(akl) ~= nil and not akl[plr.UserId] then return end
    -- (v82) only while you're actually in a fight: saber ignited (ignited / blocking / parrying / swinging).
    -- Sheathed, unequipped, or just walking around = Anti-kick never moves you.
    local csK = combatStateNow()
    if csK ~= "ignited" and csK ~= "blocking" and csK ~= "parrying" and csK ~= "swinging" then return end
    local me = LocalPlayer.Character
    local mh = me and me:FindFirstChild("HumanoidRootPart")
    if not mh then return end
    local st = swingState[plr]
    if st and st.isKick and not countered[st.trk] then
        local eta, trk = assessThreat(plr, mh, true)
        if eta and trk == st.trk then startKickCounter(plr, trk) end
    end
end
-- instant path: refresh the blade/animation state (dt 0 = no velocity update) and decide right now
AP.onKick = function(plr)
    if not settings.antiKick or counterBusy then return end
    local me = LocalPlayer.Character
    local mh = me and me:FindFirstChild("HumanoidRootPart")
    if not mh then return end
    pcall(updateSwings, mh, 0)
    tryCounterKick(plr)
end
-- per-frame path (covers everything the instant path missed)
track(RunService.Heartbeat:Connect(function()
    if not settings.antiKick or counterBusy then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then tryCounterKick(plr) end
    end
end))
-- (v68: the "Anti-kick: pre-unblock" feature - letting go of block when someone DASHES at you, before any
-- kick - was removed. A plain dash at you must never drop your block. Anti-kick still lets go of block
-- the instant a real kick starts, including far dash-kicks.)

------------------------------------------------------------------------
-- PERFECT TRADE (v75): you're blocking, an opponent's swing LANDS on your block - and the moment it does,
-- you let go of block and answer with ONE multi (W + A + E dash cancelled into a swing) straight at them,
-- then your block goes back up if you're still holding it. That's a trade: you took their hit on your
-- block and gave one back while they're still finishing their swing.
--   "Their swing landed on your block" is read from YOUR side, two ways (whichever comes first):
--     * your block-hit reaction animation starts (the game plays it on every blocked hit)
--     * your "Block" value drops (the server lowers it on every blocked hit)
--   The attacker = whoever close to you is mid-swing / just swung and is facing you.
--   Kicks are left to Anti-kick. Whitelisted players / teammates (Parry lists) are never traded with.
------------------------------------------------------------------------
do
    local RESP = {} -- the block-hit reaction animations (fixed for every form)
    for _, id in ipairs({ 6312280575, 6312281206, 6312281779, 6312282511, 6669641262, 7101397703, 6736233297,
        7101402353, 6861038808, 6861088961, 6860799757, 7101356513, 6753361279, 6860759883, 10443668308 }) do
        RESP[tostring(id)] = true
    end
    local tradeBusy, lastTrade = false, 0
    local blockSince, wasBlocking = math.huge, false
    local lastBlockObj, lastBlockVal

    local function flatV(v) return Vector3.new(v.X, 0, v.Z) end

    local function pickAttacker(mh)
        local best, bestScore
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and parryPicked(plr) and not (settings.parryTeamCheck and sameTeam(plr)) then
                local ch = plr.Character
                local h = ch and ch:FindFirstChild("HumanoidRootPart")
                local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                if h and hum and hum.Health > 0 then
                    local toMe = flatV(mh.Position - h.Position)
                    local d = toMe.Magnitude
                    if d <= 16 then
                        local swinging = findAttackTrack(ch) ~= nil
                        local la = lastAtk[plr]
                        local recent = la ~= nil and os.clock() - la < 0.7
                        if swinging or recent then
                            local lf = flatV(h.CFrame.LookVector)
                            local face = (d > 0.01 and lf.Magnitude > 0.01) and lf.Unit:Dot(toMe.Unit) or 1
                            if d <= 6 or face >= 0.2 then
                                local score = d - (swinging and 5 or 0) - face * 3
                                if not best or score < bestScore then best, bestScore = plr, score end
                            end
                        end
                    end
                end
            end
        end
        return best
    end

    -- delay = human reaction wait before starting (natural), plain = answer with a plain swing (no dash)
    local function doTrade(plr, delay, plain)
        if tradeBusy then return end
        tradeBusy, lastTrade = true, os.clock()
        task.spawn(function()
            if delay and delay > 0 then
                task.wait(delay)
                -- still worth it after "reacting"? you're still blocking and they're still close and alive
                local tc = plr.Character
                local th = tc and tc:FindFirstChild("HumanoidRootPart")
                local thum = tc and tc:FindFirstChildOfClass("Humanoid")
                local mh = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not settings.perfectTrade or counterBusy or chaseBusy or combatStateNow() ~= "blocking" or not th or not mh
                    or not thum or thum.Health <= 0 or flatV(th.Position - mh.Position).Magnitude > 16 then
                    tradeBusy = false
                    return
                end
            end
            local natural = (settings.tradeAccuracy or 100) < 100
            local haveKeys = type(keypress) == "function" and type(keyrelease) == "function"
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local moveDir
            local steer = false -- (v92) only steer YOUR movement during the dash + swing itself
            -- (v92) AIM ASSIST: aim where they'll BE when the hit lands (their position + their speed x a
            -- moment), not where they are now - so circling / strafing opponents still get hit
            local assist = settings.aimAssist ~= false -- (v93) Aim assist switch / key
            local function aimPoint(th)
                if not assist then return th.Position end -- off: aim where they are, no lead
                local v = Vector3.zero
                pcall(function() v = th.AssemblyLinearVelocity end)
                return th.Position + Vector3.new(v.X, 0, v.Z) * (0.12 + math.min(pingEma, 0.3))
            end
            local function aim()
                local tc = plr.Character
                local th = tc and tc:FindFirstChild("HumanoidRootPart")
                local mh = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not th or not mh then return nil end
                local to = flatV(aimPoint(th) - mh.Position)
                if to.Magnitude > 0.3 then moveDir = to.Unit end
                return th, mh
            end
            local function faceThem()
                -- (v92) ALWAYS face them (aim assist): the multi never goes out while you look elsewhere
                local th, mh = aim()
                if th and mh then
                    if not assist then
                        -- aim assist OFF: only turn you if they're off to the side / behind (so the multi
                        -- still never goes out backwards); otherwise your own aim is left alone
                        local to = flatV(th.Position - mh.Position)
                        local lf = flatV(mh.CFrame.LookVector)
                        if to.Magnitude > 0.1 and lf.Magnitude > 0.1 and lf.Unit:Dot(to.Unit) > 0.5 then return end
                    end
                    local p = aimPoint(th)
                    pcall(function() mh.CFrame = CFrame.lookAt(mh.Position, Vector3.new(p.X, mh.Position.Y, p.Z)) end)
                    AP.lockOn(plr, 0.4)
                end
            end
            local function unblock()
                pcall(function() saberComp:ProcessInput(true, { name = "BLOCK", inputState = Enum.UserInputState.End }) end)
            end
            local function swing()
                pcall(function() saberComp:ProcessInput(true, { name = "ATTACK", inputState = Enum.UserInputState.Begin }) end)
            end
            -- (v94) KEEP YOUR MOVEMENT: remember which movement keys YOU were already holding. At the end only the
            -- keys the script pressed itself are let go - before, letting go of W / A also let go of YOUR W / A,
            -- so you stopped dead after every trade until you pressed the key again.
            local KC = Enum.KeyCode
            local heldW = UserInputService:IsKeyDown(KC.W)
            local heldA = UserInputService:IsKeyDown(KC.A)
            local heldS = UserInputService:IsKeyDown(KC.S)
            local lastSSeen = heldS and os.clock() or -math.huge
            local okT, errT = pcall(function()
                aim()
                pcall(function()
                    RunService:BindToRenderStep("ForceHBE_TradeMove", Enum.RenderPriority.Last.Value, function()
                        -- (v92) your own movement is NOT stopped: we only steer during the dash + swing
                        if steer and hum and moveDir then hum:Move(moveDir, false) end
                        if UserInputService:IsKeyDown(KC.S) then lastSSeen = os.clock() end
                        if steer then AP.noBackKey() end -- S only let go during the dash + swing (never a backwards multi)
                        if assist then AP.lockOn(plr, 0.3) end -- camera locked on them for the trade (v91)
                    end)
                end)
                if assist then AP.lockOn(plr, 0.4) end
                faceThem()
                AP.waitFacing(plr, 0.15) -- face them FIRST, then dash / multi
                steer = true
                if haveKeys and not plain then pcall(keypress, KEY_W); pcall(keypress, KEY_A) end
                -- 1) let go of block
                unblock()
                -- (v76) the dash needs W to really be down; the OS key press usually lands by the next
                -- frame, so wait exactly that one frame instead of burning a refused dash first
                if haveKeys and not plain and not UserInputService:IsKeyDown(Enum.KeyCode.W) then RunService.RenderStepped:Wait() end
                -- 2) the dash: asked for again every frame until the game takes it (W has to register first)
                local force = 0
                pcall(function() force = rawget(rawget(saberComp, "CharacterComponent"), "Force") or 0 end)
                local dashed = false
                if haveKeys and force >= 40 and not plain then
                    local tD = os.clock()
                    while os.clock() - tD < 0.25 do
                        aim()
                        local cs = combatStateNow()
                        if cs == "blocking" then unblock() end
                        local onCd = false
                        pcall(function() onCd = rawget(saberComp, "Cooldowns"):OnCooldown("dash") end)
                        if (cs == "ignited" or cs == "blocking") and not onCd and groundedMS(movementState()) then
                            faceThem()
                            sendDashInput()
                            -- (v76) the game switches state instantly: check RIGHT AWAY instead of a frame later
                            if movementState() == "dashing" then dashed = true break end
                        end
                        RunService.RenderStepped:Wait()
                        if movementState() == "dashing" then dashed = true break end
                    end
                end
                -- 3) ...cancelled into the swing at once (or a plain swing if a dash wasn't possible)
                if dashed then
                    pcall(function() rawget(saberComp, "_janitor"):Remove("DashCancelInputBegan") end)
                end
                local tC = os.clock()
                while os.clock() - tC < 0.15 and combatStateNow() ~= "ignited" do
                    if combatStateNow() == "blocking" then unblock() end
                    RunService.RenderStepped:Wait()
                end
                faceThem()
                local h = dashed and saberStillValid(saberComp) and rawget(saberComp, "_dashCancelHandler")
                if type(h) == "function" then pcall(h, true) else swing() end
                -- keep steering just long enough for the swing to go out, then hand back (and re-block)
                RunService.RenderStepped:Wait()
                aim()
                RunService.RenderStepped:Wait()
                steer = false -- the move is out: your own movement from here on
            end)
            if not okT then warn("[ForceHBE] perfect trade error: " .. tostring(errT)) end
            steer = false
            pcall(function() RunService:UnbindFromRenderStep("ForceHBE_TradeMove") end)
            if haveKeys then
                -- (v94) only let go of keys the SCRIPT pressed; yours stay down so you keep moving
                if not heldW then pcall(keyrelease, KEY_W) end
                if not heldA then pcall(keyrelease, KEY_A) end
                -- S was let go during the dash: if you're still holding it, put it back
                if heldS and os.clock() - lastSSeen < 0.15 and not UserInputService:IsKeyDown(KC.S) then
                    pcall(keypress, 0x53)
                end
            end
            tradeBusy = false
            reblockIfHeld() -- block back up (only if you're still holding it)
        end)
    end

    local function tryTrade()
        if not settings.perfectTrade or tradeBusy or counterBusy or chaseBusy then return end
        -- (v77) built for multi spam on your block: a new trade can follow 0.15s after the last one, and a hit
        -- 0.04s after your block went back up already counts (only the block pose itself at block start doesn't)
        if os.clock() - lastTrade < 0.15 then return end
        if not wasBlocking or os.clock() - blockSince < 0.04 then return end
        local char = LocalPlayer.Character
        local mh = char and char:FindFirstChild("HumanoidRootPart")
        if not mh then return end
        local plr = pickAttacker(mh)
        if not plr then return end
        local st = swingState[plr]
        if st and st.isKick then return end -- kicks belong to Anti-kick
        local acc = math.clamp(settings.tradeAccuracy or 100, 0, 100)
        if acc >= 100 then
            doTrade(plr, 0, false) -- PERFECT: every hit, instantly, always a multi (the original behaviour)
            return
        end
        -- (v87) NATURAL (accuracy below 100): plays like a person. Everything follows the one number:
        --   * Trade accuracy % of blocked hits get traded (the rest you "just keep blocking")
        --   * after 2 trades in a row the next one is 4x less likely (no endless robotic streaks)
        --   * a random human reaction first: ~60 ms at 100, slower the lower it goes (+-40% each time),
        --     and after it we re-check you're still blocking and they're still there
        --   * some trades are a plain swing instead of a multi: half of (100 - accuracy) %
        --   * no instant snap-turn toward them (see faceThem)
        -- one decision per blocked hit: each hit fires two triggers and the 2nd must not re-roll
        local now = os.clock()
        if now - AP.tradeDecideT < 0.12 then return end
        AP.tradeDecideT = now
        if now - lastTrade > 2.5 then AP.tradeStreak = 0 end -- a long pause = a new exchange
        local chance = acc / 100
        if AP.tradeStreak >= 2 then chance = chance * 0.25 end
        if math.random() > chance then
            AP.tradeStreak = 0
            return
        end
        AP.tradeStreak += 1
        local react = (60 + (100 - acc) * 1.5) / 1000
        local delay = react * (0.6 + math.random() * 0.8)
        local plain = math.random() * 100 < (100 - acc) * 0.5
        doTrade(plr, delay, plain)
    end
    AP.tradeDecideT, AP.tradeStreak = 0, 0

    -- trigger 1: my block-hit reaction animation starts
    local function hookChar(char)
        task.spawn(function()
            local hum = char:WaitForChild("Humanoid", 10)
            local animator = hum and hum:WaitForChild("Animator", 10)
            if not animator then return end
            track(animator.AnimationPlayed:Connect(function(t)
                if not settings.perfectTrade then return end
                local ok, id = pcall(function() return string.match(t.Animation.AnimationId, "%d+") end)
                if ok and id and RESP[id] then tryTrade() end
            end))
        end)
    end
    if LocalPlayer.Character then hookChar(LocalPlayer.Character) end
    track(LocalPlayer.CharacterAdded:Connect(hookChar))

    -- trigger 2: my Block value drops; plus "how long have I been blocking"
    track(RunService.Heartbeat:Connect(function()
        if not settings.perfectTrade then wasBlocking = false return end
        local blocking = combatStateNow() == "blocking"
        if blocking and not wasBlocking then blockSince = os.clock() end
        if not blocking then blockSince = math.huge end
        wasBlocking = blocking
        local char = LocalPlayer.Character
        local bv = char and char:FindFirstChild("Block")
        if bv and bv:IsA("NumberValue") then
            local v = bv.Value
            if bv == lastBlockObj and lastBlockVal and v < lastBlockVal and blocking then tryTrade() end
            lastBlockObj, lastBlockVal = bv, v
        else
            lastBlockObj, lastBlockVal = nil, nil
        end
    end))
end

-- Auto Evade, EARLY trigger: hook the exact spot where the server's stun message arrives
-- (Lightsaber:HandleSignal, request 15) and start the evade right there - before the game
-- has even finished switching to its Stunned state - instead of waiting to notice the
-- state change. doEvade waits one frame before dashing, so the stun has fully started by
-- then.
local function installEvadeHook()
    local env = (getgenv and getgenv()) or _G
    -- each run points the hook at ITS doEvade/settings
    env.ForceHBE_OnStun = function(payload)
        doEvade()
    end
    if env.ForceHBE_EvadeHook then return true end
    if type(hookfunction) ~= "function" or not saberStillValid(saberComp) then return false end
    local okC, class = pcall(function()
        local mt = getmetatable(saberComp)
        if type(mt) ~= "table" then return nil end
        if type(rawget(mt, "HandleSignal")) == "function" then return mt end
        if type(mt.__index) == "table" and type(rawget(mt.__index, "HandleSignal")) == "function" then return mt.__index end
        return nil
    end)
    if not okC or not class then return false end
    local old
    local okH = pcall(function()
        old = hookfunction(rawget(class, "HandleSignal"), function(self, req, payload, ...)
            local s = env.ForceHBE_Settings
            if s and s.autoEvade and req == 15 and env.ForceHBE_OnStun then
                pcall(env.ForceHBE_OnStun, payload)
            end
            return old(self, req, payload, ...)
        end)
    end)
    if okH then env.ForceHBE_EvadeHook = true end
    return okH
end

