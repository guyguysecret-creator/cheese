local function wrapSaber(sc)
    if not sc or sc._wrapped then return end
    sc._wrapped = true

    local oldSetParries = sc.SetParries
    if type(oldSetParries) == "function" then
        sc.SetParries = function(self, ...)
            if settings.parry and visualParries ~= nil then
                local real = rawget(self, "ParriesLeft")
                rawset(self, "ParriesLeft", visualParries)
                local ok, res = pcall(oldSetParries, self, ...)
                rawset(self, "ParriesLeft", real)
                return res
            end
            return oldSetParries(self, ...)
        end
    end

    local oldSetKicks = sc.SetKicks
    if type(oldSetKicks) == "function" then
        sc.SetKicks = function(self, ...)
            if settings.kick and visualKicks ~= nil then
                local real = rawget(self, "KicksLeft")
                rawset(self, "KicksLeft", visualKicks)
                local ok, res = pcall(oldSetKicks, self, ...)
                rawset(self, "KicksLeft", real)
                return res
            end
            return oldSetKicks(self, ...)
        end
    end

    local oldSetBlock = sc.SetBlock
    if type(oldSetBlock) == "function" then
        sc.SetBlock = function(self, ...)
            if settings.block and visualBlock ~= nil then
                local real = rawget(self, "BlocksLeft")
                rawset(self, "BlocksLeft", visualBlock)
                local ok, res = pcall(oldSetBlock, self, ...)
                rawset(self, "BlocksLeft", real)
                return res
            end
            return oldSetBlock(self, ...)
        end
    end
end

local charComp

local function wrapCharComp(cc)
    if not cc or cc._wrapped then return end
    cc._wrapped = true

    local sf = cc.SetForce
    if sf and sf.Fire then
        local realSetForce = sf
        local lastVal = 1
        local proxy = {
            Fire = function(self, val, ...)
                if settings.force and visualForce ~= nil then
                    local maxF = rawget(cc, "MaxForce") or 100
                    if val < lastVal then
                        local spent = (lastVal - val) * maxF
                        visualForce = math.max(0, visualForce - spent)
                        lastForceSpend = os.clock()
                    end
                    lastVal = val
                    val = math.clamp(visualForce / maxF, 0, 1)
                end
                return realSetForce:Fire(val, ...)
            end
        }
        setmetatable(proxy, {
            __index = realSetForce,
            __newindex = realSetForce,
        })
        cc.SetForce = proxy
    end
end

local function isMyCharComp(t)
    if type(t) ~= "table" then return false end
    local ok, valid = pcall(function()
        return type(rawget(t, "Force")) == "number"
            and type(rawget(t, "MaxForce")) == "number"
            and t.Instance == LocalPlayer.Character
            and t.SetForce ~= nil
    end)
    return ok and valid
end

-- (v83) THE FREEZE FIX. Finding your saber / character component means walking the game's whole
-- memory (getgc).
local function gcScan(wantS, wantC)
    if GC.busy or os.clock() < GC.nextAt then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then GC.nextAt = os.clock() + 1 return end
    GC.busy = true
    task.spawn(function()
        local foundS, foundC
        local okRun, errRun = pcall(function()
            local function check(t)
                if type(t) ~= "table" then return end
                if wantS and not foundS and type(rawget(t, "ParriesLeft")) == "number"
                    and type(rawget(t, "KicksLeft")) == "number" and saberStillValid(t) then
                    foundS = t
                end
                if wantC and not foundC and type(rawget(t, "Force")) == "number"
                    and type(rawget(t, "MaxForce")) == "number" and isMyCharComp(t) then
                    foundC = t
                end
            end
            local function done() return (foundS or not wantS) and (foundC or not wantC) end
            -- filtergc is quick where it exists
            if type(filtergc) == "function" then
                if wantS then
                    local ok, res = pcall(filtergc, "table", { Keys = { "ParriesLeft", "KicksLeft" } })
                    if ok and type(res) == "table" then for _, t in pairs(res) do check(t) if foundS then break end end end
                end
                if wantC and not foundC then
                    local ok, res = pcall(filtergc, "table", { Keys = { "Force", "MaxForce" } })
                    if ok and type(res) == "table" then for _, t in pairs(res) do check(t) if foundC then break end end end
                end
            end
            if done() then return end
            if type(getgc) ~= "function" then
                if not warnedNoGC then warnedNoGC = true; log("no getgc in this executor - parry/kicks can't work") end
                return
            end
            local ok, list = pcall(getgc, true)
            if not ok or type(list) ~= "table" then return end
            local n = 0
            for _, t in ipairs(list) do
                check(t)
                if done() then break end
                n += 1
                if n % 3000 == 0 then task.wait() end -- let the game draw a frame
            end
            list = nil
        end)
        if not okRun then warn("[ForceHBE] memory scan error: " .. tostring(errRun)) end
        if foundS and saberStillValid(foundS) and not saberStillValid(saberComp) then
            saberComp = foundS
            wrapSaber(saberComp)
            log("found your lightsaber component")
        end
        if foundC and isMyCharComp(foundC) and not isMyCharComp(charComp) then
            charComp = foundC
            wrapCharComp(charComp)
            log("Infinite Force: found your character component")
        end
        local gotAll = (foundS or not wantS) and (foundC or not wantC)
        GC.wait = gotAll and 2 or math.min(GC.wait * 2, 20)
        GC.nextAt = os.clock() + GC.wait
        GC.busy = false
    end)
end
-- respawn / equip: scan again soon instead of waiting out the long back-off
local function gcSoon()
    GC.wait = 2
    GC.nextAt = math.min(GC.nextAt, os.clock() + 0.5)
end
local function gcWatchChar(char)
    gcSoon()
    track(char.ChildAdded:Connect(function(c) if c:IsA("Tool") then gcSoon() end end))
end
if LocalPlayer.Character then gcWatchChar(LocalPlayer.Character) end
