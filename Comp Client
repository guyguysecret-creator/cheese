local function tryUnlock()
    if hashPassword(pwBox.Text) == PASSWORD_HASH then
        pwBox.Text = ""
        lock.Visible = false
        if type(releaseSplash) == "function" then releaseSplash() end
        content.Visible = true -- the intro may still be up: the list shows over its last frames
        log("unlocked")
    else
        pwBox.Text = ""
        lockLabel.Text = "Wrong password."
        lockLabel.TextColor3 = Color3.fromRGB(220, 80, 80)
    end
end
