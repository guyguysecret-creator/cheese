        saberComp = nil
        -- the component is rebuilt when you equip/respawn; scanned for in the background (see gcScan)
        gcScan(true, settings.force and not isMyCharComp(charComp))
        return
    end
    wrapSaber(saberComp)

    local cs = combatStateNow()
    local isBlocking = (cs == "blocking") or userHoldsBlock()

    -- 1. Infinite Parry (visual depletion & normal 5s regen)
    if settings.parry then
        if not visualParries then visualParries = MAX_PARRIES end
        local p = rawget(saberComp, "ParriesLeft")
        if type(p) == "number" and p < MAX_PARRIES then
            local spent = MAX_PARRIES - p
            visualParries = math.max(0, visualParries - spent)
            lastParryTime = os.clock()
            saberComp.ParriesLeft = MAX_PARRIES
            pcall(function() saberComp:SetParries() end)
        else
            if not isBlocking and visualParries < MAX_PARRIES then
                if os.clock() - lastParryTime >= PARRY_REGEN_INTERVAL then
                    visualParries = math.min(MAX_PARRIES, visualParries + 1)
                    lastParryTime = os.clock()
                    pcall(function() saberComp:SetParries() end)
                end
            elseif isBlocking then
                lastParryTime = os.clock()
            end
            if type(p) == "number" and p < MAX_PARRIES then
                saberComp.ParriesLeft = MAX_PARRIES
            end
        end
    end

    -- 2. Infinite Kicks (visual depletion & normal 2s regen while blocking/sheathed)
    if settings.kick then
        if not visualKicks then visualKicks = MAX_KICKS end
        local k = rawget(saberComp, "KicksLeft")
        if type(k) == "number" and k < MAX_KICKS then
            local spent = MAX_KICKS - k
            visualKicks = math.max(0, visualKicks - spent)
            lastKickTime = os.clock()
            saberComp.KicksLeft = MAX_KICKS
            pcall(function() saberComp:SetKicks() end)
        else
            local isBlockingOrAway = isBlocking or (cs == "sheathed") or (cs == "idle_m")
            if isBlockingOrAway then
                if blockStartTime == 0 then blockStartTime = os.clock() end
                if os.clock() - blockStartTime >= KICK_REGEN_WAIT then
                    if visualKicks < MAX_KICKS and (os.clock() - lastKickTime >= KICK_REGEN_INTERVAL) then
                        visualKicks = math.min(MAX_KICKS, visualKicks + 1)
                        lastKickTime = os.clock()
                        pcall(function() saberComp:SetKicks() end)
                    end
                end
            else
                blockStartTime = 0
                lastKickTime = os.clock()
            end
            if type(k) == "number" and k < MAX_KICKS then
                saberComp.KicksLeft = MAX_KICKS
            end
        end
    end

    -- 3. Infinite Block (visual damage & normal 14/s regen when not blocking; stun dropped)
    if pinBlock then
        if not visualBlock then visualBlock = MAX_BLOCK end
        local b = rawget(saberComp, "BlocksLeft")
        if type(b) == "number" and b < MAX_BLOCK then
            local dmg = MAX_BLOCK - b
            visualBlock = math.max(0, visualBlock - dmg)
            lastBlockHit = os.clock()
            saberComp.BlocksLeft = MAX_BLOCK
            pcall(function() saberComp:SetBlock() end)
        else
            if not isBlocking and visualBlock < MAX_BLOCK then
                if os.clock() - lastBlockHit >= BLOCK_REGEN_DELAY then
                    visualBlock = math.min(MAX_BLOCK, visualBlock + BLOCK_REGEN_RATE * dt)
                    pcall(function() saberComp:SetBlock() end)
                end
            elseif isBlocking then
                lastBlockHit = os.clock()
            end
            if type(b) == "number" and b < MAX_BLOCK then
                saberComp.BlocksLeft = MAX_BLOCK
            end
        end
    end
end))

