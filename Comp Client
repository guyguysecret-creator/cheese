-- cleanup (used when you re-execute the script)
------------------------------------------------------------------------
local function cleanup()
    setForce(false)
    setBlock(false)
    settings.parry, settings.kick, settings.autoParry, settings.dashGuard = false, false, false, false
    settings.autoEvade = false
    settings.parryChase = false
    settings.antiKick = false
    settings.esp = false
    if espClear then espClear() end
    setHBE(false)
    for _, c in ipairs(connections) do
        if type(c) == "thread" then
            pcall(task.cancel, c)
        else
            pcall(function() c:Disconnect() end)
        end
    end
    if gui then pcall(function() local i = gui.Parent and gui.Parent:FindFirstChild("ForceHBE_Intro"); if i then i:Destroy() end end) end
    if gui then gui:Destroy() end
end
if getgenv then getgenv().ForceHBE_Cleanup = cleanup end

