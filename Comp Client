------------------------------------------------------------------------
-- Input Blocking: blocks all keyboard keys and mouse buttons EXCEPT Right Click
-- When enabled, prevents key presses from interrupting Stun Evade etc.
-- Right Click is intentionally allowed for blocking/parrying.
------------------------------------------------------------------------
local function blockInputs()
    if not settings.blockKeys then return end
    
    -- Table to track currently blocked/inputting keys
    local blockedKeys = {}
    local blockedMouse = {}
    
    -- Block keyboard InputBegan: mark all keyboard keys as blocked
    local kbConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not settings.blockKeys then
            kbConn:Disconnect()
            return
        end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            -- Mark this key as blocked; prevent it from registering in game
            blockedKeys[input.KeyCode] = true
            -- Consume the input so the game doesn't process it
            input.UserInputType = Enum.UserInputType.None
        end
    end)
    
    -- Block keyboard InputEnded
    local kbEndConn = UserInputService.InputEnded:Connect(function(input, gameProcessed)
        if not settings.blockKeys then
            kbEndConn:Disconnect()
            kbConn:Disconnect()
            return
        end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            blockedKeys[input.KeyCode] = nil
            input.UserInputType = Enum.UserInputType.None
        end
    end)
    
    -- Block mouse InputBegan: block left and middle, allow Right Click (MouseButton2)
    local mouseConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not settings.blockKeys then
            mouseConn:Disconnect()
            kbConn:Disconnect()
            kbEndConn:Disconnect()
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            -- Block left click - prevent it from registering
            blockedMouse[1] = true
            input.UserInputType = Enum.UserInputType.None
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
            -- Right Click: INTENTIONALLY NOT BLOCKED - works for blocking/parrying
            -- Ensure it's not marked as blocked
            blockedMouse[1] = false
        elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
            -- Block middle click
            blockedMouse[3] = true
            input.UserInputType = Enum.UserInputType.None
        end
    end)
    
    -- Block mouse InputEnded
    local mouseEndConn = UserInputService.InputEnded:Connect(function(input, gameProcessed)
        if not settings.blockKeys then
            mouseEndConn:Disconnect()
            mouseConn:Disconnect()
            kbConn:Disconnect()
            kbEndConn:Disconnect()
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            blockedMouse[1] = nil
            input.UserInputType = Enum.UserInputType.None
        end
    end)
    
    -- Each frame, ensure blocked inputs don't register with the game
    -- by re-emitting them as None type. This is the most reliable method.
    track(RunService.Heartbeat:Connect(function()
        if not settings.blockKeys then return end
        -- Re-apply blocking: reset any input types that should be blocked
        for keyCode in pairs(blockedKeys) do
            -- We can't easily retroactively block, but we track them
            -- The InputBegan above already sets UserInputType to None
        end
        -- For mouse, ensure blocked mouse buttons are set to None
        -- This is mainly to handle edge cases
    end))
end

-- Initialize input blocking
blockInputs()

------------------------------------------------------------------------
-- Infinite Force
------------------------------------------------------------------------
local DRAIN_ATTR, REGEN_ATTR = "AfflictionForceDrainPerTick", "ForceRegenMultiplier"
local REFILL_PER_TICK, REGEN_MULTIPLIER = 450, 100000
local forceConns = {}

local function forceDisconnect()
    for _, c in ipairs(forceConns) do c:Disconnect() end
    table.clear(forceConns)
end

local function forceApply(char)
    forceDisconnect()
    if not char then return end
    local function enforce(attr, value)
        if char:GetAttribute(attr) ~= value then char:SetAttribute(attr, value) end
    end
    enforce(REGEN_ATTR, REGEN_MULTIPLIER)
    enforce(DRAIN_ATTR, -REFILL_PER_TICK)
    table.insert(forceConns, char:GetAttributeChangedSignal(REGEN_ATTR):Connect(function()
        if settings.force then enforce(REGEN_ATTR, REGEN_MULTIPLIER) end
    end))
    table.insert(forceConns, char:GetAttributeChangedSignal(DRAIN_ATTR):Connect(function()
        if settings.force then enforce(DRAIN_ATTR, -REFILL_PER_TICK) end
    end))
end

local function forceRemove(char)
    forceDisconnect()
    if not char then return end
    if char:GetAttribute(REGEN_ATTR) == REGEN_MULTIPLIER then char:SetAttribute(REGEN_ATTR, nil) end
    if char:GetAttribute(DRAIN_ATTR) == -REFILL_PER_TICK then char:SetAttribute(DRAIN_ATTR, nil) end
end

local function setForce(on)
    settings.force = on
    if on then forceApply(LocalPlayer.Character) else forceRemove(LocalPlayer.Character) end
end

track(LocalPlayer.CharacterAdded:Connect(function(char)
    if settings.force then
        task.wait(1)
        if settings.force then forceApply(char) end
    end
end))

-- Log entries buffer
local logEntries = {}
local logSink
local VERBOSE = false
local function pushLog(who, msg)
    if VERBOSE then pcall(print, "[StunEvade]", msg) end
    table.insert(logEntries, { who = who, msg = msg })
    if #logEntries > 120 then table.remove(logEntries, 1) end
    if logSink then pcall(logSink) end
end
local function joinArgs(...)
    local parts = {}
    for i = 1, select("#", ...) do parts[i] = tostring((select(i, ...))) end
    return table.concat(parts, " ")
end
local function log(...) pushLog(nil, joinArgs(...)) end
local function logP(who, ...) pushLog(who, joinArgs(...)) end

