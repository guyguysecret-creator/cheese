-- Password lock (only a hash is stored, not the password)
------------------------------------------------------------------------
local PASSWORD_HASH = 2300189347
local function hashPassword(s)
    local h = 5381
    for i = 1, #s do
        h = bit32.bxor((h * 33) % 4294967296, string.byte(s, i))
    end
    return h
end

