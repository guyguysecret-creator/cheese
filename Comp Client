-- MAIN LOOP FOR AUTO-DASH + MULTI-HIT
track(RunService.Heartbeat:Connect(function()
    if not settings.autoDashMulti then return end
    
    -- Check if we just got flagged as having parried
    if autoDashMulti.wasParried then
        autoDashMulti.wasParried = false
        -- Start the auto-dash multi-hit sequence
        autoDashMulti.isActive = true
        autoDashMulti.targetPlayer = nil
        autoDashMulti.stunEnded = false
        
        -- Find the most recent player we parried
        local myChar = LocalPlayer.Character
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        if not myHum then return end
        
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local targetChar = plr.Character
                local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
                if targetHum and targetHum.Health > 0 then
                    -- Check if target appears stunned (still, or in recovery state)
                    -- after a parry. We'll target the first valid player.
                    autoDashMulti.targetPlayer = plr
                    log("Auto-dash + multi-hit: targeting " .. plr.Name .. " after parry")
                    break
                end
            end
        end
    end
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    
    -- Check if we should start/stop the auto-dash multi-hit
    if autoDashMulti.isActive then
        -- Check if the target's stun animation has ended
        local target = autoDashMulti.targetPlayer
        if target and target.Character then
            local targetHrp = target.Character:FindFirstChild("HumanoidRootPart")
            local targetHum = target.Character:FindFirstChildOfClass("Humanoid")
            if not targetHrp or not targetHum or targetHum.Health <= 0 then
                -- Target died or left, stop
                autoDashMulti.isActive = false
                autoDashMulti.stunEnded = true
                log("Target died or left - stopping multi-hit cycle")
                return
            end
            
            -- Detect if stun animation has ended
            -- In Roblox lightsaber games, a player is "stunned" when they
            -- have been parried and are in a stunned state
            -- We check humanoid state: if target is moving normally, stun ended
            local targetState = targetHum:GetState()
            -- If target is running, jumping, or freefalling, they've likely recovered
            if targetState == Enum.HumanoidStateType.Running or
               targetState == Enum.HumanoidStateType.Jumping or
               targetState == Enum.HumanoidStateType.Freefall then
                -- Stun has ended - stop multi-hitting immediately
                autoDashMulti.isActive = false
                autoDashMulti.stunEnded = true
                log("Target's stun animation ended - stopping multi-hit cycle")
                return
            end
            -- If target is standing still or in a idle state, they're likely still stunned
            -- Continue with multi-hit cycle
        else
            autoDashMulti.isActive = false
            return
        end
        
        -- Perform multi-hit cycle
        if autoDashMulti.targetPlayer then
            performMultiHitCycle(LocalPlayer.Character, autoDashMulti.targetPlayer.Character)
        end
    else
        -- Not active yet - the wasParried flag will activate it after a parry
    end
end))

