-- PING AT EXECUTION -> recommended Parry timing. Auto Parry already subtracts your live ping by itself
-- ("Parry follows ping"); the box adds a little EXTRA lead on top, and the higher your ping the more
-- extra it needs (about -67 at 30 ms, -85 at 100 ms, -122 at 250 ms). Measured once, right now.
local function measurePingMs()
    local ms = 0
    pcall(function() ms = (LocalPlayer:GetNetworkPing() or 0) * 1000 end)      -- seconds -> ms
    if ms < 1 then
        pcall(function()
            ms = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() or 0
        end)
    end
    return ms
end
local function recommendedParryOffset()
    local ping = measurePingMs()
    if ping < 1 then return -75 end                                   -- couldn't read it: the old default
    local v = -(60 + ping * 0.25)
    v = math.floor(v / 5 + 0.5) * 5                                   -- round to the nearest 5
    return math.clamp(v, -300, -40)
end
