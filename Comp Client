function KB.makeRow(order, labelText, settingKey)
    local row = makeRow(order, labelText)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(78, 18)
    btn.Position = UDim2.new(1, -84, 0.5, -9)
