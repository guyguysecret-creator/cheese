            elseif base64 and type(base64.decode) == "function" then bytes = base64.decode(raw) end
        end)
        if type(bytes) ~= "string" or #bytes < 1000 or bytes:byte(1) ~= 0xFF then
            -- no usable decoder in this executor: decode it ourselves
            local ALPHA = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
            local lookup = {}
            for i = 1, 64 do lookup[ALPHA:byte(i)] = i - 1 end
            local out, n, buf, bits = {}, 0, 0, 0
            for i = 1, #raw do
                local v = lookup[raw:byte(i)]
                if v then
                    buf = buf * 64 + v
                    bits = bits + 6
                    if bits >= 8 then
                        bits = bits - 8
                        n = n + 1
                        out[n] = string.char(math.floor(buf / 2 ^ bits) % 256)
                        buf = buf % 2 ^ bits
                    end
                end
            end
            bytes = table.concat(out)
        end
        local okW = pcall(writefile, "ForceHBE_logo.jpg", bytes)
        if not okW then return false end
        local okA, asset = pcall(getcustomasset, "ForceHBE_logo.jpg")
        if not okA or not asset then return false end
        img.Image = asset
        pcall(function() ContentProvider:PreloadAsync({ img }) end)
        task.wait(0.15)
        return loaded()
    end
    shown = tryEmbedded()

    for _, c in ipairs(candidates) do
        if shown then break end
        img.Image = c
        pcall(function() ContentProvider:PreloadAsync({ img }) end)
        task.wait(0.15)
        if loaded() then shown = true break end
    end
    if not shown and type(writefile) == "function" and type(getcustomasset) == "function" then
        for _, id in ipairs({ 72002193288588, 135560314705244 }) do
            local okD, bytes = pcall(function()
                return game:HttpGet("https://assetdelivery.roblox.com/v1/asset/?id=" .. id)
            end)
            if okD and type(bytes) == "string" and #bytes > 100 and not bytes:find("<roblox", 1, true) then
                local name = "ForceHBE_logo_" .. id .. ".png"
                if pcall(writefile, name, bytes) then
                    local okA, asset = pcall(getcustomasset, name)
                    if okA and asset then
                        img.Image = asset
                        pcall(function() ContentProvider:PreloadAsync({ img }) end)
                        task.wait(0.15)
                        if loaded() then shown = true break end
                    end
                end
            end
        end
    end
    if not shown then
        -- couldn't get the picture at all: still show the splash, with the name instead
        img.Image = ""
        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.fromScale(1, 1)
        txt.BackgroundTransparency = 1
        txt.Font = Enum.Font.GothamBlack
        txt.TextScaled = true
        txt.TextColor3 = Color3.fromRGB(255, 255, 255)
        txt.Text = "COMP CLIENT"
        txt.ZIndex = 6
        txt.Parent = img
        local tpad = Instance.new("UIPadding", txt)
        tpad.PaddingLeft, tpad.PaddingRight = UDim.new(0.08, 0), UDim.new(0.08, 0)
        tpad.PaddingTop, tpad.PaddingBottom = UDim.new(0.38, 0), UDim.new(0.38, 0)
    end

    -- pop in
    local popInfo = TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    TweenService:Create(img, popInfo, { Size = UDim2.fromOffset(SIZE, SIZE), ImageTransparency = 0 }):Play()
    TweenService:Create(stroke, TweenInfo.new(0.5), { Transparency = 0.15 }):Play()

    -- glow pulse for ~2.2s
    local t0 = os.clock()
    while os.clock() - t0 < 2.2 and sg.Parent do
        local t = os.clock() - t0
        local pulse = (math.sin(t * 6) + 1) / 2                     -- 0..1, ~1 beat per second
        local grow = math.min(t / 0.5, 1)                           -- glow eases in with the pop
        glow.Size = UDim2.fromOffset((SIZE * 1.25 + pulse * 55) * grow, (SIZE * 1.25 + pulse * 55) * grow)
        glow.BackgroundTransparency = 1 - (0.38 + pulse * 0.17) * grow
        glow2.Size = UDim2.fromOffset((SIZE * 1.05 + pulse * 30) * grow, (SIZE * 1.05 + pulse * 30) * grow)
        glow2.BackgroundTransparency = 1 - (0.22 + (1 - pulse) * 0.14) * grow
        stroke.Thickness = 3 + pulse * 7
        RunService.RenderStepped:Wait()
    end

    -- fade away
    local fade = TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    TweenService:Create(img, fade, { ImageTransparency = 1, Size = UDim2.fromOffset(SIZE * 1.12, SIZE * 1.12) }):Play()
    TweenService:Create(stroke, fade, { Transparency = 1 }):Play()
    TweenService:Create(glow, fade, { BackgroundTransparency = 1 }):Play()
    TweenService:Create(glow2, fade, { BackgroundTransparency = 1 }):Play()
    task.wait(0.8)
    sg:Destroy()
end)
